# Local orchestration of bounded runner calls. The shell passes paths through the environment as data.
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(out "$ENV{COGMASTER_LIBRARY_OUT}")
set(image "$ENV{COGMASTER_IMAGE}")
set(index "$ENV{COGMASTER_CANDIDATE}")
set(prefix "${out}/${index}")
file(WRITE "${prefix}.path" "${image}")
set(run "$ENV{COGMASTER_LIBRARY_RUN}")
if(NOT run)
  set(run "${root}/build/library/cogmaster-run${CMAKE_EXECUTABLE_SUFFIX}")
endif()
set(emulator "$ENV{COGMASTER_LIBRARY_EMULATOR}")
execute_process(COMMAND ${emulator} "${run}" --probe "${image}" TIMEOUT 20
  RESULT_VARIABLE rc OUTPUT_FILE "${prefix}.probe" ERROR_FILE "${prefix}.error")
file(READ "${prefix}.probe" probe)
set(status malformed_io)
set(evaluated 0)
set(attempted 0)
if(rc STREQUAL "77")
  set(status unsupported)
  if(probe MATCHES "^size=([0-9]+)\n" AND CMAKE_MATCH_1 LESS 8192)
    set(status malformed_io)
  endif()
elseif(rc STREQUAL "0")
  set(status unknown)
  set(attempted 1)
  foreach(key machine_guess region_guess mapper_guess identity_sha1 sha1 sha1_headerless sha256 sha256_headerless)
    string(REGEX MATCH "(^|\n)${key}=([^\n]*)" unused "${probe}")
    set(${key} "${CMAKE_MATCH_2}")
  endforeach()
  set(id "${identity_sha1}")
  file(STRINGS "${root}/tests/built/expected.txt" admitted REGEX "^[A-Za-z0-9_]+ [0-9a-f]+$")
  foreach(row IN LISTS admitted)
    string(REPLACE " " ";" pair "${row}")
    list(GET pair 0 name)
    list(GET pair 1 hash)
    if(hash STREQUAL sha256 OR hash STREQUAL sha256_headerless)
      set(id "fixture/${name}")
    endif()
  endforeach()
  include("${out}/cases.cmake")
  set(found 0)
  set(failed 0)
  foreach(i RANGE 1 ${compat_count})
    set(case "compat_${i}")
    if(NOT "${${case}_id}" STREQUAL id)
      continue()
    endif()
    math(EXPR found "${found}+1")
    if(NOT "${${case}_script}" STREQUAL "none" OR ${case}_cap GREATER 600)
      set(status unsupported)
      continue()
    endif()
    set(predicate "${${case}_parameter}")
    if(NOT "${${case}_expected}" STREQUAL "")
      string(APPEND predicate "=${${case}_expected}")
    endif()
    file(CONFIGURE OUTPUT "${prefix}.${i}.expect" CONTENT "${predicate}\n" NEWLINE_STYLE UNIX @ONLY)
    execute_process(COMMAND ${emulator} "${run}" --machine "${${case}_machine}" --region "${${case}_runner_region}"
      --fm "${${case}_fm}" --video-mode "${${case}_video}" --port1 "${${case}_port1}" --port2 "${${case}_port2}" --frames "${${case}_cap}"
      --expect "${prefix}.${i}.expect" "${image}" TIMEOUT 30
      RESULT_VARIABLE code OUTPUT_FILE "${prefix}.${i}.observation" ERROR_FILE "${prefix}.${i}.error")
    if(code MATCHES "^(0|3)$")
      math(EXPR evaluated "${evaluated}+1")
      if(code STREQUAL "3")
        set(failed 1)
      endif()
    elseif(code STREQUAL "77")
      set(status unsupported)
    else()
      set(status infrastructure_error)
    endif()
    set(result_status infrastructure_error)
    if(code STREQUAL "0")
      set(result_status pass)
    elseif(code STREQUAL "3")
      set(result_status fail)
    elseif(code STREQUAL "77")
      set(result_status unsupported)
    endif()
    if(id MATCHES "^[0-9a-f]+$" AND NOT id MATCHES "^fixture/")
      file(APPEND "${out}/public-facts.csv" "${id},-,${${case}_machine},${${case}_region},${${case}_tv},${${case}_mapper},${${case}_predicate},${result_status},core=$ENV{COGMASTER_LIBRARY_REV},$ENV{COGMASTER_LIBRARY_DATE}\n")
    endif()
  endforeach()
  if(found EQUAL 0 OR evaluated EQUAL 0)
    execute_process(COMMAND ${emulator} "${run}" --frames 20 --hash "${image}" TIMEOUT 30
      RESULT_VARIABLE code OUTPUT_FILE "${prefix}.observation" ERROR_FILE "${prefix}.run-error")
    if(code STREQUAL "77")
      set(status unsupported)
    elseif(NOT code STREQUAL "0")
      set(status infrastructure_error)
    endif()
  endif()
  if(status STREQUAL "unknown" AND evaluated GREATER 0)
    set(status pass)
    if(failed)
      set(status fail)
    endif()
  endif()
  # Fault prevented: a profile taken from a file name or a title would give a mislabelled or hostile file an arbitrary row; a
  # Japan-region cart judged only as export would never exercise FM. The machine and mapper come from the catalog row, the
  # region from the probe, and the catalog is read independently of fixture admission so owned images can stand in for catalog carts.
  set(catalog "$ENV{COGMASTER_CATALOG}")
  if(NOT catalog)
    set(catalog "${root}/tests/compat/catalog.tsv")
  endif()
  set(judged "${identity_sha1}")
  if(NOT judged)
    set(judged "${sha1}")
    if(NOT sha1_headerless STREQUAL "none")
      set(judged "${sha1_headerless}")
    endif()
  endif()
  set(row "")
  if(EXISTS "${catalog}" AND judged MATCHES "^[0-9a-f]+$")
    string(LENGTH "${judged}" judged_length)
    if(judged_length EQUAL 40)
      file(STRINGS "${catalog}" row REGEX "^${judged}\t")
    endif()
  endif()
  set(listed 0)
  foreach(i RANGE 1 ${compat_count})
    if("${compat_${i}_id}" STREQUAL judged)
      set(listed 1)
    endif()
  endforeach()
  set(profiles "")
  if(row MATCHES "^[0-9a-f]+\t([a-z0-9]+)\t([a-z0-9_]+)\t" AND NOT listed)
    set(catalog_machine "${CMAKE_MATCH_1}")
    set(catalog_mapper "${CMAKE_MATCH_2}")
    if(catalog_machine STREQUAL "gg")
      set(profiles "gg|export|ntsc|off|ntsc-u")
      if(region_guess STREQUAL "ntsc-j")
        set(profiles "gg|japan|ntsc|off|ntsc-j")
      endif()
    elseif(catalog_machine MATCHES "^sms1?$" AND region_guess STREQUAL "ntsc-u")
      set(profiles "sms|export|ntsc|off|ntsc-u;sms|export|pal|off|pal")
    elseif(catalog_machine MATCHES "^sms1?$" AND region_guess STREQUAL "ntsc-j")
      set(profiles "sms|japan|ntsc|on|ntsc-j")
    endif()
  endif()
  set(number 0)
  foreach(profile IN LISTS profiles)
    string(REPLACE "|" ";" profile "${profile}")
    list(GET profile 0 kind)
    list(GET profile 1 region)
    list(GET profile 2 tv)
    list(GET profile 3 fm)
    list(GET profile 4 runner_region)
    set(video sms)
    if(kind STREQUAL "gg")
      set(video gg)
    endif()
    math(EXPR number "${number}+1")
    file(CONFIGURE OUTPUT "${prefix}.judge.${number}.expect" CONTENT "boots@600\n" NEWLINE_STYLE UNIX @ONLY)
    execute_process(COMMAND ${emulator} "${run}" --machine "${catalog_machine}" --region "${runner_region}"
      --fm "${fm}" --video-mode "${video}" --port1 pad --port2 pad --frames 600
      --expect "${prefix}.judge.${number}.expect" "${image}" TIMEOUT 30
      RESULT_VARIABLE code OUTPUT_FILE "${prefix}.judge.${number}.observation" ERROR_FILE "${prefix}.judge.${number}.error")
    set(verdict "")
    if(code STREQUAL "0")
      set(verdict pass)
    elseif(code STREQUAL "3")
      set(verdict fail)
    endif()
    if(verdict)
      file(APPEND "${out}/public-facts.csv" "${judged},-,${catalog_machine},${region},${tv},${catalog_mapper},cfg:video=${video};fm=${fm};port1=pad;port2=pad;script=none;sha256=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855/boots@600,${verdict},core=$ENV{COGMASTER_LIBRARY_REV},$ENV{COGMASTER_LIBRARY_DATE}\n")
      file(APPEND "${out}/profiles.csv" "${kind},${region},${tv},${fm},${verdict}\n")
    endif()
  endforeach()
elseif(NOT rc STREQUAL "1")
  set(status infrastructure_error)
endif()
file(APPEND "${out}/results.csv" "${index},${status},${evaluated},${attempted}\n")
