* text=auto eol=lf
# Fixture bytes are hashed in tests/roms/manifest.txt; git must never rewrite them.
/tests/roms/** -text
# Fixture sources are text; LF everywhere, so every lane assembles the same bytes.
/tests/roms/src/** text eol=lf
/tests/vectors/** -text
*.sms binary
*.gg binary
*.sg binary
*.bin binary
# Generated by the cartdb generator, the seed and the library judge; collapse the diff in review.
/tests/compat/ledger.csv linguist-generated=true
/tests/compat/catalog.tsv linguist-generated=true
/tests/compat/pin-counts.txt linguist-generated=true
/src/cartdb.inc linguist-generated=true
