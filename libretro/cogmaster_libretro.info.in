authors = "cogmaster contributors"
corename = "cogmaster"
license = "MIT"
permissions = ""
display_version = "@PROJECT_VERSION@"
manufacturer = "Sega"
categories = "Emulator"
systemname = "Sega 8-bit (MS/GG)"
