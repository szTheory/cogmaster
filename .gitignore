# Game, BIOS and save images never enter this repository. Licensed test
# fixtures are the one exception: they live under tests/roms/, each is listed in
# tests/roms/manifest.txt, and scripts/hygiene.sh rejects any image not listed.
*.sms
*.gg
*.sg
*.sc
*.mv
*.bin
*.rom
*.sav
*.srm
*.state
*.eeprom
!/tests/roms/**
/roms/
/bios/
/private/

# Local configuration and secrets (12-factor: local values live in .env.local)
.env
.env.*
!.env.example

# Build output
/build/
/out/
/CMakeUserPresets.json
compile_commands.json

# GSD and agent state that is local to one machine
/.planning/state.json
/.planning/milestone.lock
/.planning/research/.cache/
/.gsd/
/.claude/worktrees/
/.claude/settings.local.json

# OS noise
.DS_Store
