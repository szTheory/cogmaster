# cmake -DROOT=<repository> -DOUT=<scratch directory> -P claims_cases.cmake
# Fault prevented: wording that drifts from the is_experimental flag in either state, an over-claim while most
# identities are unknown, a planning label in user text, and a claims check that cannot fail. Each control is a
# tree built from the real files with one fault; this script only builds trees and runs the check.
foreach(var ROOT OUT)
  if(NOT DEFINED ${var})
    message(FATAL_ERROR "claims_cases: -D${var} is required")
  endif()
endforeach()
set(at "@")
function(claims_put path content)
  string(REPLACE "@" "@at@" content "${content}")
  file(CONFIGURE OUTPUT "${path}" CONTENT "${content}" @ONLY NEWLINE_STYLE UNIX)
endfunction()
file(READ "${ROOT}/README.md" readme)
file(READ "${ROOT}/docs/compatibility.md" page)
file(READ "${ROOT}/docs/saves.md" saves)
file(READ "${ROOT}/libretro/cogmaster_libretro.info.in" info)
# The flag-absent texts: the flag line goes and every sentence saying the word becomes plain.
string(REPLACE "is_experimental = \"true\"\n" "" info_gone "${info}")
string(REPLACE "Experimental. " "" info_gone "${info_gone}")
foreach(name readme page saves)
  string(REGEX REPLACE "[Ee]xperimental" "settled" ${name}_gone "${${name}}")
endforeach()
string(REPLACE "Experimental. " "" info_plain "${info}")
string(REPLACE "is_experimental = \"true\"\n" "" info_flagless "${info}")
set(controls 0)
# claims_run(name code regex readme page saves info): one tree, one run of the check, exit code and message asserted.
function(claims_run name code regex readme page saves info)
  set(tree "${OUT}/${name}")
  file(REMOVE_RECURSE "${tree}")
  claims_put("${tree}/README.md" "${readme}")
  claims_put("${tree}/docs/compatibility.md" "${page}")
  claims_put("${tree}/docs/saves.md" "${saves}")
  claims_put("${tree}/libretro/cogmaster_libretro.info.in" "${info}")
  execute_process(COMMAND ${CMAKE_COMMAND} -DROOT=${tree} -DCHECK=claims_scoped -P ${CMAKE_CURRENT_LIST_DIR}/../cmake/repository.cmake
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out)
  if(NOT rc EQUAL code OR NOT out MATCHES "${regex}")
    message(FATAL_ERROR "claims_cases: ${name}: expected exit ${code} matching [${regex}], got ${rc}\n${out}")
  endif()
  math(EXPR n "${controls}+1")
  set(controls ${n} PARENT_SCOPE)
endfunction()
# The flag in other spellings of the core's config reader: a value of 1, upper case with a comment, unquoted (each present), two lines (the last, false, wins).
set(flag_line "is_experimental = \"true\"")
string(REPLACE "${flag_line}" "is_experimental = \"1\"" info_one "${info}")
string(REPLACE "${flag_line}" "IS_EXPERIMENTAL = \"TRUE\" # kept" info_upper "${info}")
string(REPLACE "${flag_line}" "is_experimental = true" info_bare "${info}")
string(REPLACE "${flag_line}" "${flag_line}\nis_experimental = \"false\"" info_last_false "${info}")
set(graphic_title "Sega Graphic Board (Japan, prototype v2.0)")
claims_run(real 0 "" "${readme}" "${page}" "${saves}" "${info}")
claims_run(flag_absent 0 "" "${readme_gone}" "${page_gone}" "${saves_gone}" "${info_gone}")
claims_run(title_in_row 0 "" "${readme}" "${page}\n| d04ea11e1f67 | ${graphic_title} | sms/export/ntsc/unsupported | unsupported | 2026-11-12 |\n" "${saves}" "${info}")
claims_run(title_in_prose 1 "compatibility.md names a planning label" "${readme}" "${page}\n${graphic_title}\n" "${saves}" "${info}")
claims_run(over_claim 1 "README.md over-claims" "${readme}\nIt plays 900 games.\n" "${page}" "${saves}" "${info}")
claims_run(flag_present_unsaid 1 "README.md lacks experimental" "${readme_gone}" "${page}" "${saves}" "${info}")
claims_run(flag_one_unsaid 1 "README.md lacks experimental" "${readme_gone}" "${page}" "${saves}" "${info_one}")
claims_run(flag_upper_unsaid 1 "README.md lacks experimental" "${readme_gone}" "${page}" "${saves}" "${info_upper}")
claims_run(flag_bare_unsaid 1 "README.md lacks experimental" "${readme_gone}" "${page}" "${saves}" "${info_bare}")
claims_run(flag_last_line_false 1 "README.md says experimental after the flag left" "${readme}" "${page}" "${saves}" "${info_last_false}")
claims_run(flag_absent_readme 1 "README.md says experimental after the flag left" "${readme}" "${page_gone}" "${saves_gone}" "${info_gone}")
claims_run(flag_absent_docs 1 "saves.md says experimental after the flag left" "${readme_gone}" "${page_gone}" "${saves}" "${info_gone}")
claims_run(flag_absent_info 1 "info.in says experimental after the flag left" "${readme_gone}" "${page_gone}" "${saves_gone}" "${info_flagless}")
string(REPLACE "Experimental. " "Experimental through v2.0. " info_label "${info}")
claims_run(planning_label 1 "info.in names a planning label" "${readme}" "${page}" "${saves}" "${info_label}")
claims_run(stale_description 1 "the description lacks experimental" "${readme}" "${page}" "${saves}" "${info_plain}")
message(STATUS "policy.claims_scoped: ${controls} controls")
