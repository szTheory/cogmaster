# Faults prevented: oversized documentation/corpus and unclassified or disproportionate repository checks.
set(checks README.md=12288 include/cogmaster.h=24576)
file(GLOB docs RELATIVE "${ROOT}" "${ROOT}/docs/*.md")
foreach(doc IN LISTS docs)
  list(APPEND checks "${doc}=40960")
endforeach()
foreach(check IN LISTS checks)
  string(REGEX MATCH "^(.*)=([0-9]+)$" unused "${check}")
  file(SIZE "${ROOT}/${CMAKE_MATCH_1}" size)
  if(NOT size LESS CMAKE_MATCH_2)
    message(FATAL_ERROR "budgets: ${check}: ${size} bytes is over budget")
  endif()
endforeach()
file(GLOB_RECURSE fuzz "${ROOT}/tests/fuzz/*")
set(total 0)
foreach(path IN LISTS fuzz)
  file(SIZE "${path}" size)
  math(EXPR total "${total}+${size}")
endforeach()
if(total GREATER 524288)
  message(FATAL_ERROR "budgets: tests/fuzz exceeds 524288 bytes")
endif()
function(repository_lines out path)
  file(READ "${path}" text)
  string(REGEX MATCHALL "\n" newlines "${text}")
  list(LENGTH newlines n)
  if(NOT text STREQUAL "" AND NOT text MATCHES "\n$")
    math(EXPR n "${n}+1")
  endif()
  set(${out} ${n} PARENT_SCOPE)
endfunction()
file(STRINGS "${ROOT}/tests/policy/repository-checks.txt" classifications REGEX "^[^#].+")
set(counted 0)
foreach(row IN LISTS classifications)
  string(REPLACE "|" ";" fields "${row}")
  list(POP_FRONT fields kind path reason)
  if(path IN_LIST classified OR NOT EXISTS "${ROOT}/${path}" OR NOT kind MATCHES "^(check|behavior|build|operation)$" OR NOT reason)
    message(FATAL_ERROR "repository: invalid or duplicate classification ${row}")
  endif()
  list(APPEND classified "${path}")
  if(kind STREQUAL "check")
    repository_lines(n "${ROOT}/${path}")
    math(EXPR counted "${counted}+${n}")
  endif()
endforeach()
file(GLOB_RECURSE implementations LIST_DIRECTORIES false RELATIVE "${ROOT}"
  "${ROOT}/tests/cmake/*" "${ROOT}/scripts/*" "${ROOT}/cmake/*" "${ROOT}/.githooks/*"
  "${ROOT}/tests/compatibility/*.cmake" "${ROOT}/tests/compatibility/*.sh")
foreach(path IN LISTS implementations)
  if(NOT path IN_LIST classified)
    message(FATAL_ERROR "repository: unclassified applicable code ${path}")
  endif()
endforeach()
file(GLOB_RECURSE sources "${ROOT}/src/*.c" "${ROOT}/src/*.h")
set(core 0)
foreach(path IN LISTS sources)
  repository_lines(n "${path}")
  math(EXPR core "${core}+${n}")
endforeach()
math(EXPR scaled "${counted}*10")
if(NOT scaled LESS core)
  message(FATAL_ERROR "repository: ${counted} check lines / ${core} src lines violates strict one tenth")
endif()
message(STATUS "repository: ${counted} check lines / ${core} src lines, strict one tenth")
