# cmake -DREADME=<README.md> -DINFO=<.info.in> -DRUN=<runner> -DIMAGE=<rom> [-DEMULATOR=<list>] -P readme.cmake
# Fault prevented: README play steps that no longer run, print another line, promise a ROM extension the
# core does not load, or lose the legality sentence.
file(READ "${README}" text)
file(READ "${INFO}" info)
string(REGEX MATCH "supported_extensions = \"([^\"]*)\"" unused "${info}")
string(REPLACE "|" ";" supported "${CMAKE_MATCH_1}")
string(REGEX MATCHALL "`[.][a-z]+`" tokens "${text}")
if(NOT tokens)
  message(FATAL_ERROR "readme: no ROM extension named")
endif()
foreach(token IN LISTS tokens)
  string(REGEX REPLACE "[`.]" "" ext "${token}")
  if(NOT ext IN_LIST supported)
    message(FATAL_ERROR "readme: .${ext} is not in supported_extensions (${supported})")
  endif()
endforeach()
set(sentence "cogmaster ships no BIOS and no game; bring a `.sms` or `.gg` file you own, no BIOS is needed.")
string(REPLACE "${sentence}" "" rest "${text}")
string(LENGTH "${text}" all)
string(LENGTH "${rest}" kept)
string(LENGTH "${sentence}" one)
math(EXPR sentences "(${all} - ${kept}) / ${one}")
if(NOT sentences EQUAL 1)
  message(FATAL_ERROR "readme: the no-BIOS sentence appears ${sentences} times, expected 1")
endif()
string(REGEX MATCH "(^|\n)bin/cogmaster-run ([^\n]*)\n" unused "${text}")
string(REPLACE "game.sms" "${IMAGE}" args "${CMAKE_MATCH_2}")
string(REGEX MATCH "```text\n([^\n]*)\n" unused "${text}")
string(REPEAT "[0-9a-f]" 64 digits)
string(REPLACE "<64 hex digits>" "${digits}" want "${CMAKE_MATCH_1}")
separate_arguments(args)
execute_process(COMMAND ${EMULATOR} ${RUN} ${args} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out)
if(NOT rc EQUAL 0 OR NOT out MATCHES "^${want}\n$")
  message(FATAL_ERROR "readme: bin/cogmaster-run ${args} exited ${rc}, printed\n${out}want ${want}")
endif()
