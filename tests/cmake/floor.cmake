# Release floor check, run after packaging as
#   cmake -DDIR=<zip dir> -DSUFFIX=<os>-<arch> -DWORK=<scratch dir>
#         [-DFLOOR_OVERRIDE=<floor>] -P floor.cmake
# Fault prevented: a released binary refuses to load on an OS or runtime the
# README lists as supported. It reads from the binaries what the OS loader
# enforces: the minimum OS or glibc version, the libraries they need, and the
# libretro module's exports (retro_* only). FLOOR_OVERRIDE replaces this leg's
# floor (the version on Linux and macOS, the import allowlist on Windows).
cmake_minimum_required(VERSION 3.25)
set(floor_linux_core 2.17)      # glibc, cogmaster_libretro.so
set(floor_linux_runner 2.34)    # glibc, cogmaster-run: __libc_start_main@GLIBC_2.34
set(floor_macos_x64 10.13)      # LC_VERSION_MIN_MACOSX version
set(floor_macos_arm64 11.0)     # LC_BUILD_VERSION minos
# The only DLL the runner and the core import, with MSVC's static runtime:
# llvm-readobj --coff-imports lists "Name: KERNEL32.dll" alone for both, on
# windows-x64 and windows-arm64 (muhtari CI run 38935217538).
set(floor_windows KERNEL32.dll)
foreach(var DIR SUFFIX WORK)
  if("${${var}}" STREQUAL "")
    message(FATAL_ERROR "floor: -D${var} is required")
  endif()
endforeach()
string(REGEX MATCH "^[a-z]+" os "${SUFFIX}")
string(REPLACE "-" "_" key "${SUFFIX}")
foreach(floor floor_linux_core floor_linux_runner floor_${key} floor_windows)
  if(DEFINED FLOOR_OVERRIDE)
    set(${floor} "${FLOOR_OVERRIDE}")
  endif()
endforeach()
foreach(c library runner libretro)
  file(REMOVE_RECURSE "${WORK}/${c}")
  file(ARCHIVE_EXTRACT INPUT "${DIR}/cogmaster-${c}-${SUFFIX}.zip" DESTINATION "${WORK}/${c}")
endforeach()
file(GLOB runner "${WORK}/runner/bin/*") # release.archive_contents pins
file(GLOB core "${WORK}/libretro/cores/*") # one member in each
set(bad "")

function(read out tool) # runs a tool, failing closed
  find_program(path_${tool} ${tool} REQUIRED)
  execute_process(COMMAND ${path_${tool}} ${ARGN} RESULT_VARIABLE rc
    OUTPUT_VARIABLE text ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "floor: ${tool} ${ARGN} failed (${rc}): ${err}")
  endif()
  string(REPLACE ";" "," text "${text}")
  set(${out} "${text}" PARENT_SCOPE)
endfunction()
function(within bin items allowed what) # each item must match the allowed regex
  foreach(item IN LISTS items)
    if(NOT item MATCHES "${allowed}")
      list(APPEND bad "${bin}: ${what} ${item}")
    endif()
  endforeach()
  set(bad "${bad}" PARENT_SCOPE)
endfunction()

if(os STREQUAL "macos")
  foreach(bin IN ITEMS "${runner}" "${core}")
    read(text otool -l "${bin}")
    string(REGEX MATCHALL "LC_VERSION_MIN_MACOSX\n[^\n]*\n *version [0-9.]+|LC_BUILD_VERSION\n[^\n]*\n[^\n]*\n *minos [0-9.]+" mins "${text}")
    if(NOT mins)
      list(APPEND bad "${bin}: no minimum OS in the load commands")
    endif()
    foreach(min IN LISTS mins)
      string(REGEX MATCH "[0-9.]+$" min "${min}")
      if(min VERSION_GREATER floor_${key})
        list(APPEND bad "${bin}: minimum OS ${min} is above the floor ${floor_${key}}")
      endif()
    endforeach()
    read(text otool -L "${bin}")
    string(REGEX MATCHALL "\t[^ ]+" libs "${text}")
    within("${bin}" "${libs}" "^\t/usr/lib/libSystem\\.B\\.dylib$" "links")
  endforeach()
  read(text nm -gUj "${core}")
  string(REGEX MATCHALL "[^\n]+" exports "${text}")
  within("${core}" "${exports}" "^_retro_" "exports")
elseif(os STREQUAL "linux")
  foreach(pair "${core}=${floor_linux_core}" "${runner}=${floor_linux_runner}")
    string(REGEX MATCH "^(.*)=(.*)$" unused "${pair}")
    set(bin "${CMAKE_MATCH_1}")
    set(glibc "${CMAKE_MATCH_2}")
    read(text readelf -dW "${bin}")
    string(REGEX MATCHALL "\\(NEEDED\\)[^[]*\\[[^]]+" libs "${text}")
    within("${bin}" "${libs}" "\\[(libc\\.so\\.6|ld-linux[^/]*)$" "needs")
    read(text readelf -VW "${bin}")
    string(REGEX MATCHALL "Name: [^ \n]+" needs "${text}")
    within("${bin}" "${needs}" "^Name: (GLIBC_[0-9]+\\.[0-9]+(\\.[0-9]+)?|[^G].*)$" "needs version")
    foreach(need IN LISTS needs)
      if(need MATCHES "GLIBC_([0-9.]+)$" AND CMAKE_MATCH_1 VERSION_GREATER glibc)
        list(APPEND bad "${bin}: GLIBC_${CMAKE_MATCH_1} is above the floor ${glibc}")
      endif()
    endforeach()
    read(text readelf --dyn-syms -W "${bin}")
    if(text MATCHES "__isoc23_[A-Za-z0-9_]*")
      list(APPEND bad "${bin}: references ${CMAKE_MATCH_0}")
    endif()
  endforeach()
  read(text nm -D --defined-only "${core}")
  string(REGEX MATCHALL "[^ \n]+\n" exports "${text}")
  list(TRANSFORM exports STRIP)
  within("${core}" "${exports}" "^retro_" "exports")
elseif(os STREQUAL "windows")
  foreach(bin IN ITEMS "${runner}" "${core}")
    read(text llvm-readobj --coff-imports "${bin}")
    string(REGEX MATCHALL "Name: [^\n]+" dlls "${text}")
    list(TRANSFORM dlls REPLACE "^Name: " "")
    if(NOT dlls)
      list(APPEND bad "${bin}: no imports read")
    endif()
    foreach(dll IN LISTS dlls)
      if(NOT dll IN_LIST floor_windows)
        list(APPEND bad "${bin}: imports ${dll}, outside the allowlist ${floor_windows}")
      endif()
    endforeach()
  endforeach()
  read(text llvm-readobj --coff-exports "${core}")
  string(REGEX MATCHALL "Name: [^\n]+" exports "${text}")
  if(NOT exports)
    list(APPEND bad "${core}: no exports read")
  endif()
  within("${core}" "${exports}" "^Name: retro_" "exports")
  file(STRINGS "${WORK}/library/lib/cogmaster.lib" directives
    REGEX "[-/][Dd][Ee][Ff][Aa][Uu][Ll][Tt][Ll][Ii][Bb]")
  if(directives)
    list(APPEND bad "cogmaster.lib: carries a /DEFAULTLIB directive")
  endif()
else()
  message(FATAL_ERROR "floor: no floor for ${SUFFIX}")
endif()
if(bad)
  list(JOIN bad "\n  " bad)
  message(FATAL_ERROR "floor: ${SUFFIX}:\n  ${bad}")
endif()
message(STATUS "floor: ${SUFFIX} within its floors")
