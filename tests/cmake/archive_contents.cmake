# Release archive check, run after the package step as
#   cmake -DDIR=<zip dir> -DSUFFIX=<os>-<arch> -DSOURCE_DIR=<tree>
#         -DBINARY_DIR=<build dir> [-DCOMPONENTS=<list>] -P archive_contents.cmake
# Fault prevented: a release zip missing its licence or notices, holding an
# unexpected member, or leaking a build path. Each cogmaster-<component>-SUFFIX.zip
# must exist, be the only cogmaster zip besides its siblings, hold exactly its
# expected files at the root, carry LICENSE and THIRD-PARTY-NOTICES.md
# byte-identical to SOURCE_DIR's, and contain neither SOURCE_DIR nor BINARY_DIR.
foreach(var DIR SUFFIX SOURCE_DIR BINARY_DIR)
  if("${${var}}" STREQUAL "")
    message(FATAL_ERROR "archive_contents: -D${var} is required")
  endif()
endforeach()
if(NOT DEFINED COMPONENTS)
  set(COMPONENTS library runner libretro)
endif()

set(notices LICENSE THIRD-PARTY-NOTICES.md)
set(lib lib/libcogmaster.a)
set(exe bin/cogmaster-run)
set(core cores/cogmaster_libretro.so)
if(SUFFIX MATCHES "^macos-")
  set(core cores/cogmaster_libretro.dylib)
elseif(SUFFIX MATCHES "^windows-")
  set(lib lib/cogmaster.lib)
  set(exe bin/cogmaster-run.exe)
  set(core cores/cogmaster_libretro.dll)
endif()
set(want_library ${notices} include/cogmaster.h include/cogmaster_version.h ${lib} lib/pkgconfig/cogmaster.pc
  lib/cmake/cogmaster/cogmasterConfig.cmake lib/cmake/cogmaster/cogmasterConfigVersion.cmake
  lib/cmake/cogmaster/cogmasterTargets.cmake lib/cmake/cogmaster/cogmasterTargets-release.cmake)
set(want_runner ${notices} ${exe})
set(want_libretro ${notices} ${core} info/cogmaster_libretro.info)

set(expected "")
foreach(component IN LISTS COMPONENTS)
  list(APPEND expected "${DIR}/cogmaster-${component}-${SUFFIX}.zip")
endforeach()
file(GLOB found LIST_DIRECTORIES false "${DIR}/cogmaster-*.zip")
list(SORT expected)
list(SORT found)
if(NOT found STREQUAL expected)
  message(FATAL_ERROR "archive_contents: zips in ${DIR} are\n  ${found}\nexpected\n  ${expected}")
endif()

foreach(component IN LISTS COMPONENTS)
  set(name cogmaster-${component}-${SUFFIX}.zip)
  set(out "${BINARY_DIR}/release/extract/${component}")
  file(REMOVE_RECURSE "${out}")
  file(ARCHIVE_EXTRACT INPUT "${DIR}/${name}" DESTINATION "${out}")
  file(GLOB_RECURSE members LIST_DIRECTORIES false RELATIVE "${out}" "${out}/*")
  set(missing ${want_${component}})
  list(REMOVE_ITEM missing ${members})
  set(extra ${members})
  list(REMOVE_ITEM extra ${want_${component}})
  if(missing OR extra)
    message(FATAL_ERROR "archive_contents: ${name}\n  lacks: ${missing}\n  extra: ${extra}")
  endif()
  foreach(notice IN LISTS notices)
    file(SHA256 "${out}/${notice}" got)
    file(SHA256 "${SOURCE_DIR}/${notice}" want)
    if(NOT got STREQUAL want)
      message(FATAL_ERROR "archive_contents: ${name}: ${notice} differs from the tree's")
    endif()
  endforeach()
  foreach(member IN LISTS members)
    file(STRINGS "${out}/${member}" text)
    foreach(path IN ITEMS "${SOURCE_DIR}" "${BINARY_DIR}")
      string(FIND "${text}" "${path}" at)
      if(NOT at EQUAL -1)
        message(FATAL_ERROR "archive_contents: ${name}: ${member} contains the path ${path}")
      endif()
    endforeach()
  endforeach()
  message(STATUS "archive_contents: ${name} ok")
endforeach()
