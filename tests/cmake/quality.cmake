# Faults prevented: a size, test-count or docs limit that drifts unseen, or
# loosens with no recorded reason.
# cmake -DQUALITY=<file> "-DMEASURED=<key>=<value>;..." [-DBASE=<file>] -P quality.cmake
# A value is an integer, lines:<path> (lines not starting with #) or bytes:<path>.
# BASE is the file on the base branch: a ceiling that rises or goes, or a floor
# that falls or goes, needs a reasons entry {key, reason} in QUALITY whose
# reason text BASE does not already hold. An absent BASE passes.
cmake_minimum_required(VERSION 3.25)
function(quality_new_reason head base key out)
  set(${out} FALSE PARENT_SCOPE)
  string(JSON count ERROR_VARIABLE error LENGTH "${head}" reasons)
  if(error OR count EQUAL 0)
    return()
  endif()
  math(EXPR count "${count}-1")
  foreach(i RANGE ${count})
    string(JSON k ERROR_VARIABLE e1 GET "${head}" reasons ${i} key)
    string(JSON text ERROR_VARIABLE e2 GET "${head}" reasons ${i} reason)
    if(e1 OR e2 OR NOT k STREQUAL key)
      continue()
    endif()
    set(seen FALSE)
    string(JSON old ERROR_VARIABLE error LENGTH "${base}" reasons)
    if(NOT error AND old GREATER 0)
      math(EXPR old "${old}-1")
      foreach(j RANGE ${old})
        string(JSON was ERROR_VARIABLE error GET "${base}" reasons ${j} reason)
        if(NOT error AND was STREQUAL text)
          set(seen TRUE)
        endif()
      endforeach()
    endif()
    if(NOT seen)
      set(${out} TRUE PARENT_SCOPE)
      return()
    endif()
  endforeach()
endfunction()
foreach(var QUALITY MEASURED)
  if(NOT DEFINED ${var} OR "${${var}}" STREQUAL "")
    message(FATAL_ERROR "quality: -D${var} is required")
  endif()
endforeach()
if(NOT EXISTS "${QUALITY}")
  message(FATAL_ERROR "quality: ${QUALITY} does not exist")
endif()
file(READ "${QUALITY}" json)
string(JSON type ERROR_VARIABLE error TYPE "${json}")
if(error OR NOT type STREQUAL "OBJECT")
  message(FATAL_ERROR "quality: ${QUALITY} is not valid JSON")
endif()
foreach(item IN LISTS MEASURED)
  if(NOT item MATCHES "^([^=]+)=(.*)$")
    message(FATAL_ERROR "quality: ${item} is not <key>=<value>")
  endif()
  set(key "${CMAKE_MATCH_1}")
  set(n "${CMAKE_MATCH_2}")
  if(n MATCHES "^lines:(.*)$")
    file(STRINGS "${CMAKE_MATCH_1}" counted REGEX "^[^#]")
    list(LENGTH counted n)
  elseif(n MATCHES "^bytes:(.*)$")
    file(SIZE "${CMAKE_MATCH_1}" n)
  elseif(NOT n MATCHES "^[0-9]+$")
    message(FATAL_ERROR "quality: ${key}: measured value ${n} is not an integer")
  endif()
  string(JSON ceiling ERROR_VARIABLE no_ceiling GET "${json}" ceilings "${key}")
  string(JSON floor ERROR_VARIABLE no_floor GET "${json}" floors "${key}")
  if(no_ceiling AND no_floor)
    message(FATAL_ERROR "quality: ${key}: no ceiling or floor in ${QUALITY} (measured ${n})")
  endif()
  if(NOT no_ceiling)
    if(n GREATER ceiling)
      message(FATAL_ERROR "quality: ${key}: measured ${n} is over the ceiling ${ceiling}")
    endif()
    message(STATUS "quality: ${key} measured=${n} ceiling=${ceiling}")
  endif()
  if(NOT no_floor)
    if(n LESS floor)
      message(FATAL_ERROR "quality: ${key}: measured ${n} is under the floor ${floor}")
    endif()
    message(STATUS "quality: ${key} measured=${n} floor=${floor}")
  endif()
endforeach()
if(DEFINED BASE AND NOT "${BASE}" STREQUAL "")
  if(NOT EXISTS "${BASE}")
    message(STATUS "quality: no base file")
    return()
  endif()
  file(READ "${BASE}" base)
  string(JSON type ERROR_VARIABLE error TYPE "${base}")
  if(error OR NOT type STREQUAL "OBJECT")
    message(FATAL_ERROR "quality: ${BASE} is not valid JSON")
  endif()
  foreach(kind ceilings floors)
    string(JSON count ERROR_VARIABLE error LENGTH "${base}" ${kind})
    if(error OR count EQUAL 0)
      continue()
    endif()
    math(EXPR count "${count}-1")
    foreach(i RANGE ${count})
      string(JSON key MEMBER "${base}" ${kind} ${i})
      string(JSON was GET "${base}" ${kind} "${key}")
      string(JSON now ERROR_VARIABLE gone GET "${json}" ${kind} "${key}")
      set(loosened FALSE)
      if(gone)
        set(now "removed")
        set(loosened TRUE)
      elseif(kind STREQUAL "ceilings" AND now GREATER was)
        set(loosened TRUE)
      elseif(kind STREQUAL "floors" AND now LESS was)
        set(loosened TRUE)
      endif()
      if(loosened)
        quality_new_reason("${json}" "${base}" "${key}" has_reason)
        if(NOT has_reason)
          message(FATAL_ERROR "quality: ${key}: loosened from ${was} to ${now} with no new reason")
        endif()
      endif()
    endforeach()
  endforeach()
endif()
