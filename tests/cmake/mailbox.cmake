# Fault prevented: a fixture whose measurements are printed but never compared, so a regression in the core passes.
# The judge of cogmaster-run --mailbox output, run as
#   cmake -DOUT=<runner output file> -DCSV=<tests/diag/expected.csv> -DROM=<rom>
#         -DPROFILE=<profile> -P mailbox.cmake
# or include()d with those variables set. The CSV's columns are
# rom,test,profile,expected,source,citation. test starts with the record's id
# in two hex digits and a colon; expected is hex, or lo-hi with both ends
# inclusive; profile * matches every profile. Every row for ROM and PROFILE
# needs its record and every record needs a row.
foreach(var OUT CSV ROM PROFILE)
  if(NOT DEFINED ${var} OR "${${var}}" STREQUAL "")
    message(FATAL_ERROR "mailbox: -D${var} is required")
  endif()
endforeach()
file(READ "${OUT}" out)
# Status and records mean nothing without the magic; the CRC is written
# just before the done status, so a run cut short is a hang, not a bad CRC.
if(NOT out MATCHES "(^|\n)magic=ok\n")
  message(FATAL_ERROR "mailbox: ${ROM}: bad CRC or magic: no mailbox magic\n${out}")
endif()
if(NOT out MATCHES "(^|\n)status=00\n")
  message(FATAL_ERROR "mailbox: ${ROM}: the status is not 00 at the frame cap (hang)\n${out}")
endif()
if(NOT out MATCHES "(^|\n)crc=ok\n")
  message(FATAL_ERROR "mailbox: ${ROM}: bad CRC or magic: the records fail their CRC\n${out}")
endif()

set(problems "")
set(judged "")
file(STRINGS "${CSV}" rows)
list(POP_FRONT rows)
foreach(row IN LISTS rows)
  string(REPLACE "," ";" f "${row}")
  list(GET f 0 rom)
  list(GET f 1 test)
  list(GET f 2 profile)
  list(GET f 3 expected)
  if(NOT rom STREQUAL ROM OR NOT (profile STREQUAL "*" OR profile STREQUAL PROFILE))
    continue()
  endif()
  string(SUBSTRING "${test}" 0 2 id)
  string(TOUPPER "${id}" id)
  list(APPEND judged ${id})
  if(NOT out MATCHES "(^|\n)${id}=([0-9A-F]+) flags=")
    string(APPEND problems "\n  row ${test} has no record")
    continue()
  endif()
  set(hex ${CMAKE_MATCH_2})
  math(EXPR value "0x${hex}")
  string(REPLACE "-" ";" range "${expected}")
  list(GET range 0 lo)
  list(GET range -1 hi)
  math(EXPR lo "0x${lo}")
  math(EXPR hi "0x${hi}")
  if(value LESS lo OR value GREATER hi)
    string(APPEND problems "\n  record ${id}=${hex} is outside its row ${test} (${expected})")
  endif()
endforeach()
string(REGEX MATCHALL "(^|\n)[0-9A-F][0-9A-F]=[0-9A-F]+ flags=" records "${out}")
foreach(record IN LISTS records)
  string(STRIP "${record}" record)
  string(SUBSTRING "${record}" 0 2 id)
  if(NOT id IN_LIST judged)
    string(APPEND problems "\n  record ${id} has no row")
  endif()
endforeach()
if(problems)
  message(FATAL_ERROR "mailbox: ${ROM} (${PROFILE}) against ${CSV}:${problems}\n${out}")
endif()
list(LENGTH judged count)
message(STATUS "mailbox: ${ROM} (${PROFILE}): ${count} records inside their rows")
