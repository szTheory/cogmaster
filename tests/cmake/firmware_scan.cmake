# Fault prevented: a known BIOS or ROM digest, or a copier-headered firmware-class zip member, in a release; or a scan that saw nothing. Inputs: -DDIR -DROOT [-DEXTRA_DIGESTS] [-DMIN_ZIPS] [-DSTAGE_FROM -DSUFFIX].
if(NOT DIR OR NOT ROOT OR (DEFINED MIN_ZIPS AND NOT MIN_ZIPS GREATER 0))
  message(FATAL_ERROR "firmware_scan: -DDIR and -DROOT are required and MIN_ZIPS is at least 1")
endif()
get_filename_component(scratch "${DIR}.extract" ABSOLUTE)
file(REMOVE_RECURSE "${scratch}")
if(STAGE_FROM)
  file(REMOVE_RECURSE "${DIR}")
  file(GLOB staged "${STAGE_FROM}/cogmaster-library-${SUFFIX}.zip" "${STAGE_FROM}/cogmaster-runner-${SUFFIX}.zip" "${STAGE_FROM}/cogmaster-libretro-${SUFFIX}.zip")
  file(COPY ${staged} DESTINATION "${DIR}")
endif()
file(GLOB zips "${DIR}/*.zip")
foreach(zip IN LISTS zips)
  get_filename_component(zname "${zip}" NAME)
  file(ARCHIVE_EXTRACT INPUT "${zip}" DESTINATION "${scratch}/${zname}")
endforeach()
file(STRINGS "${ROOT}/tests/roms/manifest.txt" listed REGEX "^[^#]")
list(TRANSFORM listed REPLACE "^([^\t]+).*$" "${ROOT}/\\1")
file(GLOB_RECURSE files LIST_DIRECTORIES false "${scratch}/*" "${DIR}/*" ${listed})
execute_process(COMMAND ${CMAKE_COMMAND} -E cat "${ROOT}/host/bios_table.inc" "${ROOT}/src/cartdb.inc" OUTPUT_VARIABLE tables ERROR_QUIET)
list(LENGTH zips nzips)
list(LENGTH files nfiles)
if(NOT zips OR nzips LESS "${MIN_ZIPS}" OR NOT files OR NOT tables MATCHES "u, \\{0x" OR NOT tables MATCHES "\\.sha1 = \\{0x")
  message(FATAL_ERROR "firmware_scan: vacuous scan: ${nzips} zips, ${nfiles} files, a digest table without rows, or too few zips")
endif()
foreach(file IN LISTS files)
  string(REGEX REPLACE "^.*\\.extract/([^/]*\\.zip)/" "\\1:" label "${file}")
  file(SHA1 "${file}" sha)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1[,}]" needle "${sha}")
  if(tables MATCHES "${needle}" OR sha IN_LIST EXTRA_DIGESTS)
    message(FATAL_ERROR "firmware_scan: ${label}: digest of known firmware or ROM")
  endif()
  file(SIZE "${file}" size)
  file(READ "${file}" head LIMIT 4096 HEX)
  if(label MATCHES "\\.zip:" AND size MATCHES "^(1536|8704|16896|131584|262656)$" AND head MATCHES "^([0-9a-f][0-9a-f])*00")
    message(FATAL_ERROR "firmware_scan: ${label}: copier-headered firmware-class size with a NUL")
  endif()
endforeach()
message(STATUS "firmware_scan: ${nzips} zips, ${nfiles} files, 0 hits")
