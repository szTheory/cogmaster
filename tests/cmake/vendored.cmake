# Vendored-file check, run as
#   cmake [-DROOT=<dir>] [-DPROVENANCE=<file>] -P vendored.cmake
# Fault prevented: a vendored file edited in place. Every row of PROVENANCE.md
# §8 names a file and its SHA-256; each file under ROOT must hash to it.
get_filename_component(top "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(NOT DEFINED ROOT)
  set(ROOT "${top}")
endif()
if(NOT DEFINED PROVENANCE)
  set(PROVENANCE "${top}/PROVENANCE.md")
endif()

file(STRINGS "${PROVENANCE}" lines)
set(section OFF)
set(checked 0)
foreach(line IN LISTS lines)
  if(line MATCHES "^## ")
    set(section OFF)
    if(line MATCHES "^## 8\\. ")
      set(section ON)
    endif()
  elseif(section AND line MATCHES "^\\| `([^`]+)` \\|.*\\| `([0-9a-f]+)` \\|$")
    set(path "${CMAKE_MATCH_1}")
    set(want "${CMAKE_MATCH_2}")
    if(NOT EXISTS "${ROOT}/${path}")
      message(FATAL_ERROR "vendored: ${path} is listed in PROVENANCE.md §8 but missing")
    endif()
    file(SHA256 "${ROOT}/${path}" got)
    if(NOT got STREQUAL want)
      message(FATAL_ERROR "vendored: ${path}: sha256 ${got}, PROVENANCE.md records ${want}")
    endif()
    math(EXPR checked "${checked} + 1")
  endif()
endforeach()
if(checked EQUAL 0)
  message(FATAL_ERROR "vendored: no file rows found in PROVENANCE.md §8")
endif()
message(STATUS "vendored: ${checked} file(s) match PROVENANCE.md §8")
