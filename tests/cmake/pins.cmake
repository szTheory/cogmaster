# Pins file check, run as
#   cmake -DPINS=<pins.txt> -P pins.cmake
# Fault prevented: a pins row that scripts/fetch-pin.sh would misread, or that
# downloads over plain HTTP or with a truncated digest, so a download is not
# what was pinned. Every row other than a comment or a blank line is exactly
# "name version url sha256": a unique name, an https:// URL and a 64-digit
# lower-case hexadecimal SHA-256.
cmake_minimum_required(VERSION 3.25)
if("${PINS}" STREQUAL "")
  message(FATAL_ERROR "pins: -DPINS is required")
endif()
file(STRINGS "${PINS}" lines)
set(bad "")
set(names "")
set(n 0)
foreach(line IN LISTS lines)
  math(EXPR n "${n} + 1")
  if(line MATCHES "^[ \t]*(#|$)")
    continue()
  endif()
  separate_arguments(fields UNIX_COMMAND "${line}")
  list(LENGTH fields count)
  if(NOT count EQUAL 4)
    list(APPEND bad "line ${n}: ${count} fields, not 4 (name version url sha256)")
    continue()
  endif()
  list(GET fields 0 name)
  list(GET fields 2 url)
  list(GET fields 3 digest)
  if(name IN_LIST names)
    list(APPEND bad "line ${n}: ${name} is listed twice")
  endif()
  list(APPEND names "${name}")
  if(NOT url MATCHES "^https://")
    list(APPEND bad "line ${n}: ${name}: the URL is not https://")
  endif()
  string(LENGTH "${digest}" len)
  if(NOT digest MATCHES "^[0-9a-f]+$" OR NOT len EQUAL 64)
    list(APPEND bad "line ${n}: ${name}: the digest is not 64 lower-case hex digits")
  endif()
endforeach()
if(NOT names)
  list(APPEND bad "no pins")
endif()
if(bad)
  list(JOIN bad "\n  " bad)
  message(FATAL_ERROR "pins: ${PINS}:\n  ${bad}")
endif()
message(STATUS "pins: ${PINS} ok")
