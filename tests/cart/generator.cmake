# Fault prevented: guessed whole-image identities, conflicting facts, metadata parser drift, an unmapped
# slot silently becoming board 0, and a slot count that hides excluded records.
# Fault prevented: a table generated from lists other than the pinned ones, or a pin bump that left the table stale.
if(CMAKE_SCRIPT_MODE_FILE AND CASE STREQUAL "pin")
  # The three MAME rows of the pins file must agree and the table's first line must name that commit.
  file(STRINGS "${PINS}" rows REGEX "^mame-(sms|gamegear|sg1000) ")
  set(versions "")
  foreach(row IN LISTS rows)
    string(REGEX REPLACE "^[^ ]+ ([0-9a-f]+) .*$" "\\1" version "${row}")
    list(APPEND versions "${version}")
  endforeach()
  list(LENGTH versions version_count)
  list(REMOVE_DUPLICATES versions)
  list(LENGTH versions distinct)
  if(NOT version_count EQUAL 3 OR NOT distinct EQUAL 1)
    message(FATAL_ERROR "table pin: the MAME rows of ${PINS} do not agree on one commit")
  endif()
  file(STRINGS "${TABLE}" header LIMIT_COUNT 1)
  string(FIND "${header}" "${versions}" at)
  if(at EQUAL -1)
    message(FATAL_ERROR "table pin: the first line of ${TABLE} does not name ${versions}")
  endif()
elseif(CMAKE_SCRIPT_MODE_FILE)
  # The real pins must pass; a pins file naming another commit must exit 1 with the pin message.
  set(pin_run ${CMAKE_COMMAND} -DCASE=pin -DPINS=${PINS} -DTABLE=${TABLE} -P ${CMAKE_CURRENT_LIST_FILE})
  execute_process(COMMAND ${pin_run} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out)
  if(NOT rc STREQUAL "0")
    message(FATAL_ERROR "the table does not match the pins: exit ${rc}: ${out}")
  endif()
  file(MAKE_DIRECTORY "${OUT}")
  file(READ "${PINS}" pins_text)
  string(REGEX REPLACE "mame-sms [0-9a-f]+" "mame-sms 0000000000000000000000000000000000000000" pins_text "${pins_text}")
  file(WRITE "${OUT}/pins-wrong.txt" "${pins_text}")
  set(CMD ${CMAKE_COMMAND} -DCASE=pin -DPINS=${OUT}/pins-wrong.txt -DTABLE=${TABLE} -P ${CMAKE_CURRENT_LIST_FILE})
  set(CODE 1)
  set(REGEX "table pin")
  include(${CMAKE_CURRENT_LIST_DIR}/../cmake/expect_fail.cmake)
  file(MAKE_DIRECTORY "${OUT}")
  string(REPEAT "5a" 20 pin)

  # Runs the generator and returns exit status, stdout and stderr in the caller's scope.
  function(generate)
    execute_process(COMMAND ${EMULATOR} ${GEN} ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE got ERROR_VARIABLE err)
    set(rc "${rc}" PARENT_SCOPE)
    set(got "${got}" PARENT_SCOPE)
    set(err "${err}" PARENT_SCOPE)
  endfunction()

  # A generator run that must exit 1 with a message, through the shared negative-control script.
  function(refuses xml regex)
    set(CMD ${EMULATOR} ${GEN} "${xml}" --pin ${pin})
    set(CODE 1)
    set(REGEX "${regex}")
    include(${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../cmake/expect_fail.cmake)
  endfunction()

  # One single-part software: name, interface, slot feature, SHA-1 and any extra part content.
  function(software out name interface slot sha extra)
    set(feature "")
    if(NOT slot STREQUAL "")
      set(feature "<feature name='slot' value='${slot}'/>")
    endif()
    set(${out} "<software name='${name}'><description>${name}</description><part name='cart' interface='${interface}'>${feature}${extra}<dataarea name='rom' size='32768'><rom size='32768' sha1='${sha}'/></dataarea></part></software>" PARENT_SCOPE)
  endfunction()

  # The main facts file: battery, pin_42, duplicates, compound exclusion, a plain record and a volatile one.
  set(part "<software name='a'><description>A &amp; &quot;B&quot;</description><part name='cart' interface='gamegear_cart'><feature name='pin_42' value='sms_mode'/><feature name='battery' value='yes'/><dataarea name='ram' size='8192'></dataarea><dataarea name='rom' size='0x8000'><rom size='32768' sha1='1111111111111111111111111111111111111111'/></dataarea></part></software>")
  set(other "<software name='b'><description>Other</description><part interface='sms_cart'><feature name='battery' value='batt'/><dataarea name='rom' size='32768'><rom size='32768' sha1='2222222222222222222222222222222222222222'/></dataarea></part></software>")
  set(compound "<software name='c'><description>Compound</description><part interface='sms_cart'><dataarea name='rom' size='32768'><rom size='16384' sha1='3333333333333333333333333333333333333333'/><rom size='16384' sha1='4444444444444444444444444444444444444444'/></dataarea></part></software>")
  set(none "<software name='d'><description>Volatile</description><part interface='sms_cart'><dataarea name='rom' size='32768'><rom size='32768' sha1='5555555555555555555555555555555555555555'/></dataarea><dataarea name='ram' size='8192'></dataarea></part></software>")
  file(WRITE "${OUT}/facts.xml" "<!-- license:CC0-1.0 --><softwarelist>${other}${part}${part}${compound}${none}</softwarelist>")
  generate("${OUT}/facts.xml" --pin ${pin} --catalog "${OUT}/facts.tsv")
  if(NOT rc STREQUAL "0" OR NOT got MATCHES "^/\\* Generated by tools/cartdb.c from the MAME hash lists at ${pin}; CC0 facts" OR got MATCHES "33333333|44444444")
    message(FATAL_ERROR "generator header or exclusion mismatch: exit ${rc}: ${got} ${err}")
  endif()
  if(NOT got MATCHES "0x11,0x11[^\n]*\\.bytes = 32768u, \\.ram_bytes = 8192u, \\.board = 2u, \\.slot = 0u, \\.machine = 2u, \\.region = 0u, \\.video = 1u, \\.persistence = 2u, \\.geometry = 1u"
     OR NOT got MATCHES "0x22,0x22[^\n]*\\.board = 1u[^\n]*\\.video = 1u, \\.persistence = 0u"
     OR NOT got MATCHES "0x55,0x55[^\n]*\\.board = 1u[^\n]*\\.persistence = 1u, \\.geometry = 0u")
    message(FATAL_ERROR "generator facts mismatch: ${got}")
  endif()
  string(REGEX MATCHALL "sha1 = {0x11," duplicates "${got}")
  list(LENGTH duplicates duplicate_count)
  if(NOT duplicate_count EQUAL 1 OR NOT got MATCHES "0x11,0x11[^\n]*\n[^\n]*0x22,0x22[^\n]*\n[^\n]*0x55,0x55")
    message(FATAL_ERROR "duplicate or sort mismatch")
  endif()
  if(got MATCHES "\"A &" OR got MATCHES "Other")
    message(FATAL_ERROR "a title reached a fact row")
  endif()
  generate("${OUT}/facts.xml" --pin ${pin} --catalog "${OUT}/facts.tsv")
  set(again "${got}")
  execute_process(COMMAND ${EMULATOR} ${GEN} "${OUT}/facts.xml" --pin ${pin} --catalog "${OUT}/again.tsv" RESULT_VARIABLE rc OUTPUT_VARIABLE got)
  if(NOT rc STREQUAL "0" OR NOT got STREQUAL again)
    message(FATAL_ERROR "nondeterministic generator")
  endif()

  # Catalog: public rows only, five tab-separated fields, entities decoded.
  file(STRINGS "${OUT}/facts.tsv" lines)
  list(LENGTH lines line_count)
  if(NOT line_count EQUAL 3)
    message(FATAL_ERROR "catalog rows: ${line_count}: ${lines}")
  endif()
  foreach(line IN LISTS lines)
    if(NOT line MATCHES "^[0-9a-f]+\t(sg|sms|gg)\t[a-z]+\t[^\t]+\t[^\t]+$")
      message(FATAL_ERROR "catalog line shape: ${line}")
    endif()
  endforeach()
  file(READ "${OUT}/facts.tsv" catalog)
  if(NOT catalog MATCHES "1111111111111111111111111111111111111111\tgg\tsega\t-\tA & \"B\"\n"
     OR NOT catalog MATCHES "2222222222222222222222222222222222222222\tsms\tnone\t-\tOther\n"
     OR NOT catalog MATCHES "5555555555555555555555555555555555555555\tsms\tnone\t-\tVolatile\n")
    message(FATAL_ERROR "catalog content: ${catalog}")
  endif()

  # The owned fixture row takes slot 0 and flags 0 and stays out of the catalog.
  generate("${OUT}/facts.xml" --fixture "${FACT}" --pin ${pin} --catalog "${OUT}/fixture.tsv")
  file(READ "${OUT}/fixture.tsv" fixture_catalog)
  if(NOT rc STREQUAL "0" OR NOT got MATCHES "\\.bytes = 65536u, \\.ram_bytes = 32768u, \\.board = 2u, \\.slot = 0u[^\n]*\\.flags = 0u" OR NOT got MATCHES "\\.flags = 1u")
    message(FATAL_ERROR "fixture row mismatch: ${rc} ${got} ${err}")
  endif()
  string(REGEX MATCHALL "\n" fixture_lines "${fixture_catalog}")
  list(LENGTH fixture_lines fixture_count)
  if(NOT fixture_count EQUAL 3)
    message(FATAL_ERROR "the owned fixture entered the catalog: ${fixture_catalog}")
  endif()

  # The Sports Pad and Paddle rows carry their controller codes on a plain ROM board; a row of either
  # shape with the other's codes is not an owned fixture.
  if(NOT got MATCHES "0x20,0x46[^\n]*\\.board = 1u[^\n]*\\.ctrl1 = 3u, \\.ctrl2 = 3u, \\.flags = 0u"
     OR NOT got MATCHES "0x02,0x1f[^\n]*\\.board = 1u[^\n]*\\.ctrl1 = 2u, \\.ctrl2 = 0u, \\.flags = 0u")
    message(FATAL_ERROR "device fixture rows mismatch: ${got}")
  endif()
  file(WRITE "${OUT}/bad-fixture.txt" "2046da4a75083e015915f82fdcb0dd850d6dfee8 32768 1 1 0 1 0 0 0 2 2 swapped\n")
  generate("${OUT}/facts.xml" --fixture "${OUT}/bad-fixture.txt" --pin ${pin})
  if(NOT rc STREQUAL "1" OR NOT err MATCHES "invalid owned fixture facts")
    message(FATAL_ERROR "a fixture row of the wrong shape was accepted: ${rc} ${err}")
  endif()

  # Slots: one software per table slot, every one mapped and counted.
  generate(--list-slots)
  string(REGEX REPLACE "\n$" "" listing "${got}")
  string(REPLACE "\n" ";" slots "${listing}")
  if(NOT rc STREQUAL "0" OR NOT "korean_nb" IN_LIST slots OR NOT "zemina" IN_LIST slots OR "sega" IN_LIST slots)
    message(FATAL_ERROR "slot listing: ${rc} ${got}")
  endif()
  set(each "")
  set(index 0)
  foreach(slot IN LISTS slots)
    math(EXPR index "${index}+1")
    math(EXPR hi "${index} / 16")
    math(EXPR lo "${index} % 16")
    string(SUBSTRING "0123456789abcdef" ${hi} 1 hi_digit)
    string(SUBSTRING "0123456789abcdef" ${lo} 1 lo_digit)
    string(REPEAT "${hi_digit}${lo_digit}" 20 sha)
    software(one "s${index}" sms_cart "${slot}" "${sha}" "")
    string(APPEND each "${one}")
  endforeach()
  set(sorted ${slots})
  list(SORT sorted)
  if(NOT sorted STREQUAL slots)
    message(FATAL_ERROR "--list-slots is not sorted")
  endif()
  file(WRITE "${OUT}/slots.xml" "<!-- license:CC0-1.0 -->${each}")
  generate("${OUT}/slots.xml" --pin ${pin} --catalog "${OUT}/slots.tsv")
  if(NOT rc STREQUAL "0")
    message(FATAL_ERROR "every table slot must map: exit ${rc}: ${err}")
  endif()
  foreach(slot IN LISTS slots)
    if(NOT err MATCHES "cartdb: slot ${slot} seen=1 emitted=1 ")
      message(FATAL_ERROR "slot ${slot} is not counted once: ${err}")
    endif()
  endforeach()
  string(REGEX MATCHALL "cartdb: slot [a-z0-9_]+ seen" count_lines "${err}")
  list(LENGTH count_lines count_total)
  list(LENGTH slots slot_total)
  if(NOT count_total EQUAL slot_total OR NOT err MATCHES "cartdb: slot 4pak [^\n]*hes_4pak" OR NOT err MATCHES "cartdb: slot codemasters seen=1 emitted=1 -> codemasters")
    message(FATAL_ERROR "per-slot lines: ${err}")
  endif()
  # A multipart record is seen and excluded.
  set(multi "<software name='m'><description>Multi</description><part name='a' interface='sms_cart'><feature name='slot' value='korean'/><dataarea name='rom' size='32768'><rom size='32768' sha1='7777777777777777777777777777777777777777'/></dataarea></part><part name='b' interface='sms_cart'><dataarea name='rom' size='32768'><rom size='32768' sha1='8888888888888888888888888888888888888888'/></dataarea></part></software>")
  file(WRITE "${OUT}/multi.xml" "<!-- license:CC0-1.0 -->${each}${multi}")
  generate("${OUT}/multi.xml" --pin ${pin})
  if(NOT rc STREQUAL "0" OR NOT err MATCHES "cartdb: slot korean seen=2 emitted=1 " OR got MATCHES "0x77,0x77")
    message(FATAL_ERROR "excluded record not counted as seen: ${rc} ${err}")
  endif()

  # Negative controls: an unmapped slot and an unmapped device exit 1 naming themselves.
  software(unmapped "zz" sms_cart "zz_new" "9999999999999999999999999999999999999999" "")
  file(WRITE "${OUT}/unmapped.xml" "<!-- license:CC0-1.0 -->${each}${unmapped}")
  refuses("${OUT}/unmapped.xml" "unmapped slot zz_new")
  software(device "zz" sms_cart "" "9999999999999999999999999999999999999999" "<sharedfeat name='ctrl1_default' value='zz_device'/>")
  file(WRITE "${OUT}/device.xml" "<!-- license:CC0-1.0 -->${device}")
  refuses("${OUT}/device.xml" "unmapped controller zz_device")
  software(ram "zz" sms_cart "" "9999999999999999999999999999999999999999" "<dataarea name='ram' size='70000'></dataarea>")
  file(WRITE "${OUT}/ram.xml" "<!-- license:CC0-1.0 -->${ram}")
  refuses("${OUT}/ram.xml" "invalid ram size")

  # EEPROM and controller facts, counted against what the XML carries.
  software(e1 "e1" sms_cart "eeprom" "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1" "")
  software(e2 "e2" gamegear_cart "eeprom" "a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2" "<feature name='battery' value='yes'/>")
  software(c1 "c1" sms_cart "" "a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3" "<sharedfeat name='ctrl1_default' value='lphaser'/><sharedfeat name='ctrl2_default' value='sports'/>")
  software(c2 "c2" sms_cart "" "a4a4a4a4a4a4a4a4a4a4a4a4a4a4a4a4a4a4a4a4" "<sharedfeat name='ctrl1_default' value='paddle'/>")
  software(c3 "c3" sms_cart "" "a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5" "<sharedfeat name='ctrl2_default' value='graphic'/>")
  file(WRITE "${OUT}/devices.xml" "<!-- license:CC0-1.0 -->${e1}${e2}${c1}${c2}${c3}")
  generate("${OUT}/devices.xml" --pin ${pin})
  string(REGEX MATCHALL "\\.ram_bytes = 128u, \\.board = 10u, \\.slot = 2u[^\n]*\\.persistence = 2u, \\.geometry = 1u" eeprom_rows "${got}")
  string(REGEX MATCHALL "\\.ctrl1 = [1-9]u" ctrl1_rows "${got}")
  string(REGEX MATCHALL "\\.ctrl2 = [1-9]u" ctrl2_rows "${got}")
  list(LENGTH eeprom_rows eeprom_count)
  list(LENGTH ctrl1_rows ctrl1_count)
  list(LENGTH ctrl2_rows ctrl2_count)
  if(NOT rc STREQUAL "0" OR NOT eeprom_count EQUAL 2 OR NOT ctrl1_count EQUAL 2 OR NOT ctrl2_count EQUAL 2
     OR NOT got MATCHES "0xa3,0xa3[^\n]*\\.ctrl1 = 1u, \\.ctrl2 = 3u"
     OR NOT got MATCHES "0xa4,0xa4[^\n]*\\.ctrl1 = 2u, \\.ctrl2 = 0u"
     OR NOT got MATCHES "0xa5,0xa5[^\n]*\\.board = 0u, \\.slot = 21u[^\n]*\\.ctrl1 = 0u, \\.ctrl2 = 4u")
    message(FATAL_ERROR "eeprom or controller facts mismatch: ${rc} ${got} ${err}")
  endif()
  # A Graphic Board default controller is the graphic slot (board 0); on a slot cartridge it is a conflict.
  software(g1 "g1" sms_cart "korean" "a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7" "<sharedfeat name='ctrl1_default' value='graphic'/>")
  file(WRITE "${OUT}/graphic-slot.xml" "<!-- license:CC0-1.0 -->${g1}")
  refuses("${OUT}/graphic-slot.xml" "graphic controller on a slot cartridge")
  # A device on one alias and none on the other keeps the device; two devices conflict.
  software(d1 "d1" sms_cart "" "a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6" "<sharedfeat name='ctrl1_default' value='lphaser'/>")
  software(d2 "d0" sms_cart "" "a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6" "")
  software(d3 "d3" sms_cart "" "a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6" "<sharedfeat name='ctrl1_default' value='paddle'/>")
  file(WRITE "${OUT}/alias.xml" "<!-- license:CC0-1.0 -->${d2}${d1}")
  generate("${OUT}/alias.xml" --pin ${pin})
  if(NOT rc STREQUAL "0" OR NOT got MATCHES "0xa6,0xa6[^\n]*\\.ctrl1 = 1u")
    message(FATAL_ERROR "an alias without the device dropped it: ${rc} ${got} ${err}")
  endif()
  file(WRITE "${OUT}/two.xml" "<!-- license:CC0-1.0 -->${d1}${d3}")
  refuses("${OUT}/two.xml" "conflicting identity")

  string(REPLACE "size='8192'" "size='16384'" conflict "${part}")
  file(WRITE "${OUT}/conflict.xml" "<!-- license:CC0-1.0 -->${part}${conflict}")
  refuses("${OUT}/conflict.xml" "conflicting identity")
  file(WRITE "${OUT}/unlicensed.xml" "<softwarelist/>")
  refuses("${OUT}/unlicensed.xml" "CC0")
  generate("${OUT}/facts.xml")
  if(NOT rc STREQUAL "1" OR NOT err MATCHES "--pin")
    message(FATAL_ERROR "a table without a pin was written: ${rc} ${err}")
  endif()
endif()
