if(CMAKE_SCRIPT_MODE_FILE)
  file(MAKE_DIRECTORY "${OUT}")
  set(part "<software name='a'><description>A &amp; &quot;B&quot;</description><part name='cart' interface='gamegear_cart'><feature name='pin_42' value='sms_mode'/><feature name='battery' value='yes'/><dataarea name='ram' size='8192'></dataarea><dataarea name='rom' size='0x8000'><rom size='32768' sha1='1111111111111111111111111111111111111111'/></dataarea></part></software>")
  set(other "<software name='b'><description>Other</description><part interface='sms_cart'><feature name='slot' value='unknown'/><feature name='battery' value='batt'/><dataarea name='rom' size='32768'><rom size='32768' sha1='2222222222222222222222222222222222222222'/></dataarea></part></software>")
  set(compound "<software name='c'><description>Compound</description><part interface='sms_cart'><dataarea name='rom' size='32768'><rom size='16384' sha1='3333333333333333333333333333333333333333'/><rom size='16384' sha1='4444444444444444444444444444444444444444'/></dataarea></part></software>")
  set(none "<software name='d'><description>Volatile</description><part interface='sms_cart'><dataarea name='rom' size='32768'><rom size='32768' sha1='5555555555555555555555555555555555555555'/></dataarea><dataarea name='ram' size='8192'></dataarea></part></software>")
  file(WRITE "${OUT}/facts.xml" "<!-- license:CC0-1.0 --><softwarelist>${other}${part}${part}${compound}${none}</softwarelist>")
  execute_process(COMMAND ${EMULATOR} ${GEN} "${OUT}/facts.xml" RESULT_VARIABLE rc OUTPUT_VARIABLE got ERROR_VARIABLE err)
  if(NOT rc STREQUAL "0" OR NOT got MATCHES "A &" OR NOT got MATCHES "32768u,2u,2u,0u,1u,2u,8192u,1u" OR NOT got MATCHES "32768u,0u,1u,0u,1u,0u,0u,0u" OR NOT got MATCHES "32768u,1u,1u,0u,1u,1u,8192u,0u" OR got MATCHES "33333333|44444444")
    message(FATAL_ERROR "generator facts mismatch: exit ${rc}: ${got} ${err}")
  endif()
  string(REGEX MATCHALL "1111111111111111111111111111111111111111" duplicates "${got}")
  list(LENGTH duplicates duplicate_count)
  if(NOT duplicate_count EQUAL 1 OR NOT got MATCHES "11111111[^\n]*\n[^\n]*22222222[^\n]*\n[^\n]*55555555")
    message(FATAL_ERROR "duplicate or sort mismatch")
  endif()
  execute_process(COMMAND ${EMULATOR} ${GEN} "${OUT}/facts.xml" RESULT_VARIABLE rc OUTPUT_VARIABLE again)
  if(NOT rc STREQUAL "0" OR NOT got STREQUAL again)
    message(FATAL_ERROR "nondeterministic generator")
  endif()
  string(REPLACE "size='8192'" "size='16384'" conflict "${part}")
  file(WRITE "${OUT}/conflict.xml" "<!-- license:CC0-1.0 -->${part}${conflict}")
  execute_process(COMMAND ${EMULATOR} ${GEN} "${OUT}/conflict.xml" RESULT_VARIABLE rc ERROR_VARIABLE err)
  if(NOT rc STREQUAL "1" OR NOT err MATCHES "conflicting identity")
    message(FATAL_ERROR "conflicting identity accepted: ${rc} ${err}")
  endif()
  file(WRITE "${OUT}/unlicensed.xml" "<softwarelist/>")
  execute_process(COMMAND ${EMULATOR} ${GEN} "${OUT}/unlicensed.xml" RESULT_VARIABLE rc ERROR_VARIABLE err)
  if(NOT rc STREQUAL "1" OR NOT err MATCHES "CC0")
    message(FATAL_ERROR "unlicensed data accepted")
  endif()
endif()
