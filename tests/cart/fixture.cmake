# Fault prevented: assembly changes silently losing the production hash-keyed battery fact.
file(STRINGS "${FACT}" fact)
if(NOT fact MATCHES "^([0-9a-f]+) ")
  message(FATAL_ERROR "missing fixture identity fact")
endif()
set(want "${CMAKE_MATCH_1}")
if(WRONG)
  set(want "0000000000000000000000000000000000000000")
endif()
file(SHA1 "${IMAGE}" got)
if(NOT got STREQUAL want)
  message(FATAL_ERROR "fixture SHA-1 identity mismatch")
endif()
if(HASH_ONLY)
  return()
endif()
file(MAKE_DIRECTORY "${OUT}")
configure_file("${IMAGE}" "${OUT}/renamed.gg" COPYONLY)
execute_process(COMMAND ${EMULATOR} ${ORACLE} "${OUT}/renamed.gg" RESULT_VARIABLE rc)
if(NOT rc STREQUAL "0")
  message(FATAL_ERROR "renamed fixture classification failed: ${rc}")
endif()
