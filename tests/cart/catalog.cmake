# Catalog fields, compound identities, pin counts and title hardening of the generator, over authored XML.
# Run: cmake -DGEN=<cogmaster-cartdb> -DOUT=<dir> "-DEMULATOR=<prefix>" -P catalog.cmake
file(MAKE_DIRECTORY "${OUT}")
string(REPEAT "5a" 20 pin)

function(generate)
  execute_process(COMMAND ${EMULATOR} ${GEN} ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE got ERROR_VARIABLE err)
  set(rc "${rc}" PARENT_SCOPE)
  set(got "${got}" PARENT_SCOPE)
  set(err "${err}" PARENT_SCOPE)
endfunction()

# A generator run that must exit 1 with a message, through the shared negative-control script.
function(refuses xml regex)
  set(CMD ${EMULATOR} ${GEN} "${xml}" --pin ${pin})
  set(CODE 1)
  set(REGEX "${regex}")
  include(${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../cmake/expect_fail.cmake)
endfunction()

# One software record: name, attributes, title, interface, extra part content and a ROM element.
function(record out name attrs title interface extra rom)
  set(${out} "<software name='${name}' ${attrs}><description>${title}</description><part interface='${interface}'>${extra}<dataarea name='rom' size='32768'>${rom}</dataarea></part></software>" PARENT_SCOPE)
endfunction()

function(rom out size sha)
  set(${out} "<rom size='${size}' sha1='${sha}'/>" PARENT_SCOPE)
endfunction()

function(sha out digit)
  string(REPEAT "${digit}" 40 value)
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

# The catalog must hold exactly this line, ten tab-separated fields.
function(expect_line catalog)
  string(JOIN "\t" want ${ARGN})
  string(FIND "${catalog}" "\n${want}\n" at)
  if(at EQUAL -1)
    message(FATAL_ERROR "catalog line missing: ${want}\n${catalog}")
  endif()
endfunction()

# Fault prevented: a ledger identity, status or reason computed anywhere but the generator, a hostile
# title reaching a ledger, a page or a spreadsheet, and a count that is only a claim.
sha(h1 1)
sha(h2 2)
sha(h3 3)
sha(h4 4)
sha(h5 5)
sha(h6 6)
sha(h7 7)
sha(h8 8)
sha(h9 9)
sha(ha a)
sha(hb b)
sha(hc c)
rom(r1 32768 ${h1})
rom(r2 32768 ${h2})
rom(r3 32768 ${h3})
rom(r4 32768 ${h4})
rom(r5 32768 ${h5})
rom(r6 32768 ${h6})
rom(r7 32768 ${h7})
rom(r8 32768 ${h8})
rom(r9 32768 ${h9})
rom(ra 32768 ${ha})
rom(rb 32768 ${hb})
record(plain plain "" "Plain" sms_cart "" "${r1}")
record(notworking notworking "supported='no'" "Not working" sms_cart "" "${r2}")
record(janggun janggun "" "Slot" sms_cart "<feature name='slot' value='janggun'/>" "${r3}")
record(japan japan "" "Tiger (Japan)" sms_cart "" "${r4}")
record(paddle paddle "" "Paddle" sms_cart "<sharedfeat name='ctrl1_default' value='paddle'/>" "${r5}")
record(devices devices "" "Devices" sms_cart "<sharedfeat name='ctrl1_default' value='sports'/><sharedfeat name='ctrl2_default' value='lphaser'/>" "${r6}")
record(graphic graphic "" "Graphic" sms_cart "<sharedfeat name='ctrl2_default' value='graphic'/>" "${r7}")
record(partial partial "supported='partial'" "Partial" sms_cart "" "${r8}")
record(alias_a alias_a "" "Alias" sms_cart "" "${r9}")
record(alias_b alias_b "supported='no'" "Alias" sms_cart "" "${r9}")
set(norom "<software name='cnorom'><description>No ROM</description><part interface='sms_cart'></part></software>")
set(baddump "<software name='cbad'><description>Bad</description><part interface='sms_cart'><dataarea name='rom' size='32768'><rom size='32768' status='baddump' sha1='${hc}'/></dataarea></part></software>")
set(multi "<software name='cmulti'><description>Multi</description><part interface='sms_cart'><dataarea name='rom' size='32768'><rom size='16384' sha1='${ha}'/><rom size='16384' sha1='${hb}'/></dataarea></part></software>")
set(short "<software name='cshort'><description>Short</description><part interface='sms_cart'><dataarea name='rom' size='32768'><rom size='16384' sha1='${hc}'/></dataarea></part></software>")
set(nopair "<software name='cno' supported='no'><description>Not working multi</description><part interface='sms_cart'><dataarea name='rom' size='32768'><rom size='16384' sha1='${ha}'/><rom size='16384' sha1='${hb}'/></dataarea></part></software>")
file(WRITE "${OUT}/sms.xml" "<!-- license:CC0-1.0 --><softwarelist name='sms'>${plain}${notworking}${janggun}${japan}${paddle}${devices}${graphic}${partial}${alias_a}${alias_b}${norom}${baddump}${multi}${short}${nopair}</softwarelist>")
record(gplain gplain "" "Game Gear plain" gamegear_cart "" "${ra}")
set(gmulti "<software name='gmulti'><description>Game Gear multi</description><part interface='gamegear_cart'><dataarea name='rom' size='32768'><rom size='16384' sha1='${ha}'/><rom size='16384' sha1='${hb}'/></dataarea></part></software>")
file(WRITE "${OUT}/gamegear.xml" "<!-- license:CC0-1.0 --><softwarelist name='gamegear'>${gplain}${gmulti}</softwarelist>")
record(splain splain "" "SG plain" sg1000_cart "" "${rb}")
set(smulti "<software name='smulti'><description>SG multi</description><part interface='sg1000_cart'><dataarea name='rom' size='32768'><rom size='16384' sha1='${ha}'/><rom size='16384' sha1='${hb}'/></dataarea></part></software>")
file(WRITE "${OUT}/sg1000.xml" "<!-- license:CC0-1.0 --><softwarelist name='sg1000'>${splain}${smulti}</softwarelist>")

generate("${OUT}/sms.xml" "${OUT}/gamegear.xml" "${OUT}/sg1000.xml" --pin ${pin} --catalog "${OUT}/catalog.tsv"
  --counts "${OUT}/pin-counts.txt")
if(NOT rc STREQUAL "0")
  message(FATAL_ERROR "generator over the authored lists: exit ${rc}: ${err}")
endif()
file(READ "${OUT}/catalog.tsv" catalog)
set(catalog "\n${catalog}")

# Status function, first match wins: a record MAME marks as not working is skipped, and so is a
# shared image with one such record; board 0 is unsupported, named by its slot; the rest is unknown.
expect_line("${catalog}" ${h1} sms none - Plain unknown - export pad pad)
expect_line("${catalog}" ${h2} sms none - "Not working" skipped mame_no export pad pad)
expect_line("${catalog}" ${h3} sms unsupported janggun Slot unsupported janggun export pad pad)
expect_line("${catalog}" ${h4} sms none - "Tiger (Japan)" unknown - japan pad pad)
expect_line("${catalog}" ${h5} sms none - Paddle unknown - japan paddle pad)
expect_line("${catalog}" ${h6} sms none - Devices unknown - export sports lphaser)
expect_line("${catalog}" ${h7} sms unsupported graphic Graphic unsupported graphic export pad pad)
expect_line("${catalog}" ${h8} sms none - Partial unknown - export pad pad)
expect_line("${catalog}" ${h9} sms none - Alias skipped mame_no export pad pad)
expect_line("${catalog}" ${ha} gg none - "Game Gear plain" unknown - export pad pad)
expect_line("${catalog}" ${hb} sg unsupported - "SG plain" excluded - export pad pad)

# Compound records: an identity from the list and the name, a closed kind, no table row.
foreach(row IN ITEMS sms/cnorom:No_ROM:no_rom sms/cbad:Bad:bad_dump sms/cmulti:Multi:multi_chip
        sms/cshort:Short:short_dump sms/cno:Not_working_multi:mame_no)
  string(REPLACE ":" ";" parts "${row}")
  list(GET parts 0 slot)
  list(GET parts 1 title)
  list(GET parts 2 reason)
  string(REPLACE "_" " " title "${title}")
  string(SHA1 id "mame/${slot}")
  expect_line("${catalog}" ${id} sms compound ${slot} "${title}" skipped ${reason} export pad pad)
endforeach()
string(SHA1 gg_id "mame/gamegear/gmulti")
expect_line("${catalog}" ${gg_id} gg compound gamegear/gmulti "Game Gear multi" skipped multi_chip export pad pad)
string(SHA1 sg_id "mame/sg1000/smulti")
expect_line("${catalog}" ${sg_id} sg compound sg1000/smulti "SG multi" excluded - export pad pad)
if(got MATCHES "${h2}" OR got MATCHES "${gg_id}")
  message(FATAL_ERROR "a record the table cannot hold reached the table")
endif()
file(STRINGS "${OUT}/catalog.tsv" catalog_lines)
list(LENGTH catalog_lines catalog_count)
if(NOT catalog_count EQUAL 18)
  message(FATAL_ERROR "catalog lines: ${catalog_count} != 18")
endif()

# Pin counts are measured, and the reconciliation line says the arithmetic the ledger relies on.
file(READ "${OUT}/pin-counts.txt" counts)
set(want_counts "entries_sms 15\nentries_gg 2\nentries_sg 2\nmerged_sms_gg 1\nmerged_sg 0\ncompound_sms_gg 6\ncompound_sg 1\nmame_no 3\n")
if(NOT counts STREQUAL want_counts)
  message(FATAL_ERROR "pin counts: ${counts}")
endif()
if(NOT err MATCHES "cartdb: ledger identities 16 = 17 entries - 1 same-image aliases \\(10 images \\+ 6 compound\\); SG-1000 excluded 2 entries \\(1 images \\+ 1 compound\\)")
  message(FATAL_ERROR "reconciliation line: ${err}")
endif()

# Title hardening: one refusal per class, and accented text still passes.
function(titled name bytes regex)
  record(one one "" "${bytes}" sms_cart "" "${r1}")
  file(WRITE "${OUT}/${name}.xml" "<!-- license:CC0-1.0 --><softwarelist name='sms'>${one}</softwarelist>")
  if(regex STREQUAL "")
    generate("${OUT}/${name}.xml" --pin ${pin})
    if(NOT rc STREQUAL "0")
      message(FATAL_ERROR "${name}: a valid title was refused: ${rc} ${err}")
    endif()
  else()
    refuses("${OUT}/${name}.xml" "${regex}")
  endif()
endfunction()
string(ASCII 226 128 174 bidi_override)
string(ASCII 226 128 139 zero_width)
string(ASCII 226 129 166 isolate)
string(ASCII 239 187 191 bom)
string(ASCII 1 control)
string(ASCII 195 40 broken)
