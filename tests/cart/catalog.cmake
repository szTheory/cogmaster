titled(zero "Ab${zero_width}c" "format character")
titled(isolate "Ab${isolate}c" "format character")
titled(bom "${bom}Abc" "format character")
titled(control "Ab${control}c" "control byte")
titled(broken "Ab${broken}c" "not valid UTF-8")
titled(accent "Caf${accent}" "")
foreach(lead IN ITEMS = + - @)
  titled(lead "${lead}cmd" "formula character")
endforeach()

