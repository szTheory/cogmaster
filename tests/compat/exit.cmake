# The exit command: what the compatibility ledger's judged rows say about the experimental flag of the libretro core.
#   cmake -DLEDGER=tests/compat/ledger.csv -DINFO=libretro/cogmaster_libretro.info.in -P tests/compat/exit.cmake
# Optional -DCATALOG, -DCOUNTS (a path, or the word none for a stand-in whose counts are derived from its own catalog), -DREASONS,
# -DQUALITY and -DOUT (scratch directory). It judges nothing itself: it counts rows the parser already accepted and compares the
# counts with the reviewed floors of quality.json. An unmet verdict is not a failure; a broken claim is, and so is a flag that
# disagrees with the verdict. It prints counts only.
# Fault prevented: a claim of public support while no cartridge of the owner's library has reached the ledger, a ledger no parser
# reads recorded as evidence, and an experimental flag that stays or goes with nobody checking it against the rows.
set(exit_self "${CMAKE_CURRENT_LIST_FILE}")
set(exit_dir "${CMAKE_CURRENT_LIST_DIR}")
include("${exit_dir}/whole_list_common.cmake")

# The catalog read once by one awk into CMake: the image identities of the machines (a compound identity has no image, so a row keyed
# by it is never a judged cartridge), the distinct closed reason tokens of the catalog, and counts for a stand-in with no pin counts.
set(exit_catalog_awk [==[
BEGIN { FS = "\t"; print "set(exit_tokens \"\")" }
{
  if($2=="sg") { nsg++; if($3=="compound") csg++; next }
  if($2!="sms" && $2!="gg") next
  n[$2]++
  if($3=="compound") cmp++
  else if(length($1)==40 && $1 !~ /[^0-9a-f]/) print "set(exit_img_" $1 " 1)"
  if($7=="mame_no") nmame++
  if(($6=="unsupported" || $6=="skipped") && $7 ~ /^[a-z0-9_]+$/ && !($7 in tok)) { tok[$7]=1; print "list(APPEND exit_tokens " $7 ")" }
}
END { printf "set(exit_counts_text \"entries_sms %d\\nentries_gg %d\\nentries_sg %d\\nmerged_sms_gg 0\\nmerged_sg 0\\ncompound_sms_gg %d\\ncompound_sg %d\\nmame_no %d\\n\")\n", n["sms"], n["gg"], nsg, cmp, csg, nmame }
]==])

# One run ends at its first fault: the macro records the status and the message of the caller and returns from the caller.
macro(exit_stop status)
  set(exit_status "${status}" PARENT_SCOPE)
  set(exit_message "${exit_text}" PARENT_SCOPE)
  set(exit_lines "${exit_lines_now}" PARENT_SCOPE)
  return()
endmacro()

# compat_exit_check(ledger catalog counts reasons quality-json template work in-memory cases-text)
# Sets exit_status (0 pass, 1 fault), exit_message and exit_lines in the caller; never exits and never prints. With in-memory ON the
# parser is not run and the given cases text stands for its output (the self test proves that text equal to the parser's once).
function(compat_exit_check ledger catalog counts reasons quality info work inmem cases_text)
  set(exit_lines_now "")
  file(MAKE_DIRECTORY "${work}")
  set(ENV{COMPAT_CATALOG} "${catalog}")
  set(ENV{COMPAT_REASONS} "${reasons}")
  foreach(name IN ITEMS judged_pass pal_judged fm_judged cart_pass cart_pal_judged cart_fm_judged)
    string(JSON value ERROR_VARIABLE jerr GET "${quality}" floors "compat.${name}")
    if(NOT value MATCHES "^[0-9]+$")
      set(exit_text "leg 4: quality.json has no integer floor compat.${name}")
      exit_stop(1)
    endif()
    set(floor_${name} "${value}")
  endforeach()
  # The catalog sets, cached by the catalog's content so a self test pays one awk per distinct stand-in.
  file(SHA1 "${catalog}" catalog_key)
  set(sets "${work}/catalog-${catalog_key}.cmake")
  if(NOT EXISTS "${sets}")
    file(CONFIGURE OUTPUT "${work}/catalog.awk" CONTENT "${exit_catalog_awk}" @ONLY NEWLINE_STYLE UNIX)
    execute_process(COMMAND awk -f "${work}/catalog.awk" "${catalog}" OUTPUT_FILE "${sets}" RESULT_VARIABLE rc ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
      file(REMOVE "${sets}")
      set(exit_text "leg 5: the catalog is unreadable: awk exited ${rc}")
      exit_stop(1)
    endif()
  endif()
  include("${sets}")
  if(counts STREQUAL "none")
    file(WRITE "${work}/counts-${catalog_key}.txt" "${exit_counts_text}")
    set(counts "${work}/counts-${catalog_key}.txt")
  endif()
  # Leg 1: a ledger no parser reads is no evidence.
  if(inmem)
    set(cases "${cases_text}")
  else()
    execute_process(COMMAND sh "${exit_dir}/../../scripts/compat-common.sh" normalize "${ledger}" OUTPUT_QUIET RESULT_VARIABLE rc ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
      set(exit_text "leg 1: the parser refuses the ledger, exit ${rc}")
      exit_stop(1)
    endif()
    execute_process(COMMAND sh "${exit_dir}/../../scripts/compat-common.sh" cases "${ledger}" OUTPUT_VARIABLE cases RESULT_VARIABLE rc ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
      set(exit_text "leg 1: the parser reads no cases from the ledger, exit ${rc}")
      exit_stop(1)
    endif()
    string(REPLACE "\r" "" cases "${cases}")
  endif()
  # Four fields of every row, in the order the parser prints them (id, tv, status, fm), reduced to one list of id,tv,status,fm.
  string(REGEX MATCHALL "set\\(compat_[0-9]+_(id|tv|status|fm) \\[\\[[^]]*\\]\\]\\)" items "${cases}")
  list(LENGTH items n_items)
  math(EXPR rest "${n_items} % 4")
  if(NOT rest EQUAL 0)
    set(exit_text "leg 1: ${n_items} case fields are not a whole number of rows")
    exit_stop(1)
  endif()
  list(JOIN items "\n" joined)
  string(REGEX REPLACE "set\\(compat_[0-9]+_[a-z]+ \\[\\[([^]]*)\\]\\]\\)" "\\1" joined "${joined}")
  string(REGEX REPLACE "([^\n]*)\n([^\n]*)\n([^\n]*)\n([^\n]*)(\n|$)" "\\1,\\2,\\3,\\4;" rowlist "${joined}")
  foreach(status IN ITEMS pass fail unknown unsupported skipped infrastructure_error)
    set(n_${status} 0)
  endforeach()
  foreach(name IN ITEMS rows fx_pass fx_fail fx_pal fx_fm cart_pass cart_pal cart_fm cart_pal_rows cart_fm_rows unowned)
    set(${name} 0)
  endforeach()
  foreach(row IN LISTS rowlist)
    if(row STREQUAL "")
      continue()
    endif()
    if(NOT row MATCHES "^([^,]*),([^,]*),([^,]*),([^,]*)$")
      set(exit_text "leg 1: a case row is not readable")
      exit_stop(1)
    endif()
    set(id "${CMAKE_MATCH_1}")
    set(tv "${CMAKE_MATCH_2}")
    set(st "${CMAKE_MATCH_3}")
    set(fm "${CMAKE_MATCH_4}")
    if(NOT st MATCHES "^(pass|fail|unknown|unsupported|skipped|infrastructure_error)$")
      set(exit_text "leg 1: a row has the status ${st}, which is outside the enum")
      exit_stop(1)
    endif()
    math(EXPR rows "${rows}+1")
    math(EXPR n_${st} "${n_${st}}+1")
    set(judged OFF)
    if(st STREQUAL "pass" OR st STREQUAL "fail")
      set(judged ON)
    endif()
    if(id MATCHES "^fixture/")
      if(st STREQUAL "pass")
        math(EXPR fx_pass "${fx_pass}+1")
      elseif(st STREQUAL "fail")
        math(EXPR fx_fail "${fx_fail}+1")
      endif()
      if(judged AND tv STREQUAL "pal")
        math(EXPR fx_pal "${fx_pal}+1")
      endif()
      if(judged AND fm STREQUAL "on")
        math(EXPR fx_fm "${fx_fm}+1")
      endif()
    elseif(id MATCHES "^[0-9a-f]+$")
      if(st STREQUAL "unknown")
        math(EXPR unowned "${unowned}+1")
      endif()
      if(tv STREQUAL "pal")
        math(EXPR cart_pal_rows "${cart_pal_rows}+1")
      endif()
      if(fm STREQUAL "on")
        math(EXPR cart_fm_rows "${cart_fm_rows}+1")
      endif()
      # A judged cartridge row is a pass or fail row of an image identity of the catalog, nothing a fixture or a compound id can be.
      if(judged AND DEFINED exit_img_${id})
        # An export cartridge carries a default row and a PAL row, so the pass floor counts distinct images, the profile floors rows.
        if(st STREQUAL "pass" AND NOT DEFINED exit_passed_${id})
          set(exit_passed_${id} 1)
          math(EXPR cart_pass "${cart_pass}+1")
        endif()
        if(tv STREQUAL "pal")
          math(EXPR cart_pal "${cart_pal}+1")
        endif()
        if(fm STREQUAL "on")
          math(EXPR cart_fm "${cart_fm}+1")
        endif()
      endif()
    endif()
  endforeach()
  # Leg 3: a red proof of our own or a judge malfunction recorded as evidence.
  if(fx_fail GREATER 0)
    set(exit_text "leg 3: ${fx_fail} fixture rows have status fail")
    exit_stop(1)
  endif()
  if(n_infrastructure_error GREATER 0)
    set(exit_text "leg 3: ${n_infrastructure_error} rows have status infrastructure_error")
    exit_stop(1)
  endif()
  # Leg 4: the fixture floors, today's values.
  if(fx_pass LESS floor_judged_pass OR fx_pal LESS floor_pal_judged OR fx_fm LESS floor_fm_judged)
    set(exit_text "leg 4: fixture rows judged pass ${fx_pass}/${floor_judged_pass}, with tv pal ${fx_pal}/${floor_pal_judged}, with fm on ${fx_fm}/${floor_fm_judged}")
    exit_stop(1)
  endif()
  # Leg 6: room under the parser's row cap.
  math(EXPR doubled "${rows}*2")
  if(doubled GREATER_EQUAL 8192)
    set(exit_text "leg 6: ${rows} rows are not below half of the 8192 row cap")
    exit_stop(1)
  endif()
  # Leg 2: a silent refusal. The shared leg compares the ledger's reasons with the catalog's; the token must also be open.
  wl_reason(error reason_info "${ledger}" "${catalog}" "${counts}" "${work}")
  if(NOT error STREQUAL "")
    set(exit_text "leg 2: ${error}")
    exit_stop(1)
  endif()
  file(STRINGS "${reasons}" vocabulary REGEX "^[a-z0-9_]+ (open|retired)$")
  list(SORT exit_tokens)
  foreach(token IN LISTS exit_tokens)
    list(FIND vocabulary "${token} open" found)
    if(found LESS 0)
      set(exit_text "leg 2: the reason ${token} is not open in the vocabulary")
      exit_stop(1)
    endif()
  endforeach()
  # Leg 5: the ledger's cartridge identities against the catalog's and the pin counts.
  wl_count(error count_info "${ledger}" "${catalog}" "${counts}" "${work}")
  if(NOT error STREQUAL "")
    set(exit_text "leg 5: ${error}")
    exit_stop(1)
  endif()
  # The verdict: the owner's rule as a command.
  set(verdict met)
  if(cart_pass LESS floor_cart_pass OR cart_pal LESS floor_cart_pal_judged OR cart_fm LESS floor_cart_fm_judged)
    set(verdict unmet)
  endif()
  set(flag unchecked)
  if(NOT info STREQUAL "")
    # The reader is the one the wording check uses, so the two cannot disagree about a spelling.
    execute_process(COMMAND awk -f "${exit_dir}/../cmake/flag.awk" "${info}" OUTPUT_VARIABLE flag OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE rc ERROR_QUIET)
    if(NOT rc EQUAL 0 OR NOT flag MATCHES "^(present|absent)$")
      set(exit_text "the template ${info} is unreadable")
      exit_stop(1)
    endif()
  endif()
  set(exit_lines_now
    "exit: rows=${rows} pass=${n_pass} fail=${n_fail} unknown=${n_unknown} unsupported=${n_unsupported} skipped=${n_skipped} infrastructure_error=${n_infrastructure_error}"
    "exit: fixture_pass=${fx_pass} pal_judged=${fx_pal} fm_judged=${fx_fm}"
    "exit: cart_pass=${cart_pass}/${floor_cart_pass} cart_pal_judged=${cart_pal}/${floor_cart_pal_judged} cart_fm_judged=${cart_fm}/${floor_cart_fm_judged} judged_cart_floors=${verdict} flag=${flag}"
    "exit: unowned_unknown=${unowned} cart_pal_rows=${cart_pal_rows} cart_fm_rows=${cart_fm_rows}")
  # The tie, both directions, so no human has to remember when the flag must leave.
  if(verdict STREQUAL "met" AND flag STREQUAL "present")
    set(exit_text "judged-cart floors met: remove is_experimental")
    exit_stop(1)
  endif()
  if(verdict STREQUAL "unmet" AND flag STREQUAL "absent")
    set(exit_text "is_experimental removed before the judged-cart floors are met")
    exit_stop(1)
  endif()
  list(APPEND exit_lines_now "exit: pass")
  set(exit_text "")
  exit_stop(0)
endfunction()

# The command: the function over the real files, its lines printed, a fault turned into a failing exit status.
function(compat_exit_run ledger info out)
  get_filename_component(root "${exit_dir}/../.." ABSOLUTE)
  foreach(pair IN ITEMS "catalog|tests/compat/catalog.tsv" "counts|tests/compat/pin-counts.txt" "reasons|tests/compat/reasons.txt" "quality|quality.json")
    string(REPLACE "|" ";" parts "${pair}")
    list(GET parts 0 var)
    list(GET parts 1 file)
    string(TOUPPER "${var}" upper)
    set(${var} "${root}/${file}")
    if(DEFINED ${upper} AND NOT "${${upper}}" STREQUAL "")
      set(${var} "${${upper}}")
    endif()
  endforeach()
  foreach(file IN ITEMS "${ledger}" "${catalog}" "${reasons}" "${quality}")
    if(NOT EXISTS "${file}")
      message(FATAL_ERROR "exit: ${file} does not exist")
    endif()
  endforeach()
  if(NOT counts STREQUAL "none" AND NOT EXISTS "${counts}")
    message(FATAL_ERROR "exit: ${counts} does not exist")
  endif()
  file(READ "${quality}" quality_json)
  compat_exit_check("${ledger}" "${catalog}" "${counts}" "${reasons}" "${quality_json}" "${info}" "${out}" OFF "")
  set(exit_status "${exit_status}" PARENT_SCOPE)
  set(exit_message "${exit_message}" PARENT_SCOPE)
  set(exit_lines "${exit_lines}" PARENT_SCOPE)
endfunction()

if(NOT DEFINED CASE OR CASE STREQUAL "" OR CASE STREQUAL "assert")
  if(NOT DEFINED LEDGER OR LEDGER STREQUAL "")
    message(FATAL_ERROR "exit: -DLEDGER is required")
  endif()
  if(NOT DEFINED OUT OR OUT STREQUAL "")
    get_filename_component(OUT "${exit_dir}/../../build/compat-exit" ABSOLUTE)
  endif()
  if(NOT DEFINED INFO)
    set(INFO "")
  endif()
  compat_exit_run("${LEDGER}" "${INFO}" "${OUT}")
  foreach(line IN LISTS exit_lines)
    message(STATUS "${line}")
  endforeach()
  if(NOT exit_status EQUAL 0)
    message(FATAL_ERROR "exit: ${exit_message}")
  endif()
  if(CASE STREQUAL "assert")
    # The committed ledger and template either keep the flag while the floors are unmet or have dropped it together with meeting them.
    list(JOIN exit_lines "\n" text)
    if(NOT text MATCHES "judged_cart_floors=(unmet flag=present|met flag=absent)" OR NOT text MATCHES "exit: pass")
      message(FATAL_ERROR "exit: the printed lines do not show a consistent verdict and flag: ${text}")
    endif()
  endif()
  return()
endif()

# The self test makes the verdict and the tie non-vacuous. Every control runs in this process through compat_exit_check over a stand-in
# catalog of generated identities and a ledger whose cases text is built in memory from the same rows that write its file; the real
# parser reads a ledger three times only: once to prove that in-memory text equal to the parser's, once as the refusal of an empty
# evidence, and once inside the single child process whose exit status is the command's own.
# Fault prevented: a met branch nobody has ever taken, a tie that passes in both directions, and an integrity leg that cannot fail.
if(CASE STREQUAL "self_test")
  if(NOT DEFINED OUT OR OUT STREQUAL "")
    message(FATAL_ERROR "self_test: -DOUT is required")
  endif()
  get_filename_component(root "${exit_dir}/../.." ABSOLUTE)
  set(work "${OUT}")
  file(REMOVE_RECURSE "${work}")
  file(MAKE_DIRECTORY "${work}")
  file(READ "${root}/quality.json" s_quality)
  set(s_reasons "${root}/tests/compat/reasons.txt")
  set(s_empty e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855)
  set(s_header "id,title,machine,region,tv,mapper,predicate,status,evidence,date\n")
  set(s_pat "set\\(compat_[0-9]+_(id|tv|status|fm) \\[\\[[^]]*\\]\\]\\)")
  set(controls 0)
  set(children 0)

  # Identities: twenty images and one compound entry (the SHA-1 of its preimage, as the generator derives it).
  foreach(n RANGE 1 20)
    string(SHA1 cid_${n} "stand-in image ${n}")
  endforeach()
  string(SHA1 compound_id "mame/sms/four")
  set(tail "export\tpad\tpad")
  set(catalog_text "")
  foreach(n RANGE 1 20)
    string(APPEND catalog_text "${cid_${n}}\tsms\tsega\t-\tCart ${n}\tunknown\t-\t${tail}\n")
  endforeach()
  string(APPEND catalog_text "${compound_id}\tsms\tcompound\tsms/four\tCart 21\tskipped\tmulti_chip\t${tail}\n")
  file(WRITE "${work}/catalog.tsv" "${catalog_text}")
  file(WRITE "${work}/counts.txt" "entries_sms 21\nentries_gg 0\nentries_sg 0\nmerged_sms_gg 0\nmerged_sg 0\ncompound_sms_gg 1\ncompound_sg 0\nmame_no 0\n")
  # A catalog whose twenty compound entries are not skipped, so only the rule on judged rows can keep them out of the count.
  set(compound_catalog "")
  foreach(n RANGE 1 20)
    string(SHA1 kid_${n} "mame/sms/c${n}")
    string(APPEND compound_catalog "${kid_${n}}\tsms\tcompound\tsms/c${n}\tCart ${n}\tunknown\t-\t${tail}\n")
  endforeach()
  string(SHA1 lone_id "stand-in lone image")
  string(APPEND compound_catalog "${lone_id}\tsms\tsega\t-\tLone\tunknown\t-\t${tail}\n")
  file(WRITE "${work}/compound-catalog.tsv" "${compound_catalog}")
  # Templates: the flag as the real one spells it, a spelling with other spacing, and a template that only mentions it in a comment.
  file(WRITE "${work}/present.info" "display_name = \"stand-in\"\nis_experimental = \"true\"\n")
  file(WRITE "${work}/spaced.info" "display_name = \"stand-in\"\n  is_experimental=\"true\"  \n")
  file(WRITE "${work}/absent.info" "display_name = \"stand-in\"\n# is_experimental = \"true\" was removed\n")
  # Other spellings the core's config reader accepts: a value of 1, upper case, a trailing comment, unquoted, and two lines (the last wins).
  file(WRITE "${work}/one.info" "is_experimental = \"1\"\n")
  file(WRITE "${work}/upper.info" "IS_EXPERIMENTAL = \"TRUE\"\n")
  file(WRITE "${work}/comment.info" "is_experimental = \"true\" # kept until the library run\n")
  file(WRITE "${work}/bare.info" "is_experimental=true\n")
  file(WRITE "${work}/false_last.info" "is_experimental = \"true\"\nis_experimental = \"false\"\n")
  file(WRITE "${work}/true_last.info" "is_experimental = \"false\"\nis_experimental = \"true\"\n")

  # The nine fixture rows, copied from the live ledger with the semicolons of the cfg held as @@ so a row stays one list element.
  file(READ "${root}/tests/compat/ledger.csv" live)
  string(REPLACE ";" "@@" live "${live}")
  string(REGEX MATCHALL "\n\"fixture/[^\n]*" fixture_rows "${live}")
  list(TRANSFORM fixture_rows REPLACE "^\n" "")
  list(LENGTH fixture_rows n_fixture)
  if(NOT n_fixture EQUAL 9)
    message(FATAL_ERROR "self_test: the live ledger holds ${n_fixture} fixture rows, not 9")
  endif()

  function(cart_row out id title tv fm status evidence)
    set(region export)
    if(fm STREQUAL "on")
      set(region japan)
    endif()
    set(${out} "\"${id}\",\"${title}\",\"sms\",\"${region}\",\"${tv}\",\"sega\",\"cfg:video=sms@@fm=${fm}@@port1=pad@@port2=pad@@script=none@@sha256=${s_empty}/boots@600\",\"${status}\",\"${evidence}\",\"2026-11-12\"" PARENT_SCOPE)
  endfunction()

  # The fixtures, the first <passes> of twenty images passing (image <pal> with tv pal, image <fm> with Japan and FM), and the compound entry.
  function(build out passes pal fm)
    set(rows "${fixture_rows}")
    foreach(n RANGE 1 20)
      set(status unknown)
      if(n LESS_EQUAL passes)
        set(status pass)
      endif()
      set(tv ntsc)
      if(n EQUAL pal)
        set(tv pal)
      endif()
      set(on off)
      if(n EQUAL fm)
        set(on on)
      endif()
      cart_row(row "${cid_${n}}" "Cart ${n}" ${tv} ${on} ${status} "-")
      list(APPEND rows "${row}")
    endforeach()
    cart_row(row "${compound_id}" "Cart 21" ntsc off skipped "reason=multi_chip")
    list(APPEND rows "${row}")
    set(${out} "${rows}" PARENT_SCOPE)
  endfunction()

  function(edit_rows out rows regex old new)
    set(result "")
    set(changed 0)
    foreach(row IN LISTS rows)
      if(row MATCHES "${regex}")
        string(REPLACE "${old}" "${new}" edited "${row}")
        if(NOT edited STREQUAL row)
          math(EXPR changed "${changed}+1")
        endif()
        list(APPEND result "${edited}")
      else()
        list(APPEND result "${row}")
      endif()
    endforeach()
    if(changed EQUAL 0)
      message(FATAL_ERROR "self_test: the control edit of ${regex} changed nothing")
    endif()
    set(${out} "${result}" PARENT_SCOPE)
  endfunction()

  function(drop_rows out rows regex)
    set(result "")
    set(dropped 0)
    foreach(row IN LISTS rows)
      if(row MATCHES "${regex}")
        math(EXPR dropped "${dropped}+1")
      else()
        list(APPEND result "${row}")
      endif()
    endforeach()
    if(NOT dropped EQUAL 1)
      message(FATAL_ERROR "self_test: dropping ${regex} removed ${dropped} rows, not 1")
    endif()
    set(${out} "${result}" PARENT_SCOPE)
  endfunction()

  # Writes the ledger of a row list and builds the cases text the parser would print for it (sorted as the parser sorts).
  function(ledger_write name rows)
    list(SORT rows)
    list(JOIN rows "\n" body)
    string(REPLACE "@@" ";" body "${body}")
    file(WRITE "${work}/${name}.csv" "${s_header}${body}\n")
    set(cases "")
    set(i 0)
    foreach(row IN LISTS rows)
      if(NOT row MATCHES "^\"([^\"]*)\",\"[^\"]*\",\"[^\"]*\",\"[^\"]*\",\"([a-z]+)\",\"[^\"]*\",\"cfg:video=[a-z]+@@fm=(on|off)@@[^\"]*\",\"([a-z_]+)\",")
        message(FATAL_ERROR "self_test: a stand-in row is not readable: ${row}")
      endif()
      math(EXPR i "${i}+1")
      string(APPEND cases "set(compat_${i}_id [[${CMAKE_MATCH_1}]])\nset(compat_${i}_tv [[${CMAKE_MATCH_2}]])\nset(compat_${i}_status [[${CMAKE_MATCH_4}]])\nset(compat_${i}_fm [[${CMAKE_MATCH_3}]])\n")
    endforeach()
    set(s_ledger "${work}/${name}.csv" PARENT_SCOPE)
    set(s_cases "${cases}" PARENT_SCOPE)
  endfunction()

  macro(defaults)
    set(c_catalog "${work}/catalog.tsv")
    set(c_counts "${work}/counts.txt")
    set(c_reasons "${s_reasons}")
    set(c_quality "${s_quality}")
    set(c_real OFF)
  endmacro()
  defaults()

  # One control: the status the command must reach, and a regex the message (a fault) or the printed lines (a pass) must match.
  function(control name rows info status regex)
    ledger_write("${name}" "${rows}")
    if(c_real)
      set(inmem OFF)
    else()
      set(inmem ON)
    endif()
    compat_exit_check("${s_ledger}" "${c_catalog}" "${c_counts}" "${c_reasons}" "${c_quality}" "${info}" "${work}" ${inmem} "${s_cases}")
    list(JOIN exit_lines "\n" text)
    if(NOT exit_status EQUAL status)
      message(FATAL_ERROR "self_test: the ${name} control ended with status ${exit_status} (${exit_message}), not ${status}\n${text}")
    endif()
    if(status EQUAL 0)
      set(seen "${text}")
    else()
      set(seen "${exit_message}")
    endif()
    if(NOT seen MATCHES "${regex}")
      message(FATAL_ERROR "self_test: the ${name} control did not match ${regex}: ${seen}")
    endif()
    math(EXPR controls "${controls}+1")
    set(controls "${controls}" PARENT_SCOPE)
  endfunction()

  set(present "${work}/present.info")
  set(absent "${work}/absent.info")

  # The verdict is met with twenty judged passes, one PAL and one FM among them, and the flag gone: the branch the owner's run reaches.
  build(met 20 1 2)
  # Rows for the format guard: the in-memory text must be what the parser prints, field for field.
  ledger_write(guard "${met}")
  set(ENV{COMPAT_CATALOG} "${work}/catalog.tsv")
  set(ENV{COMPAT_REASONS} "${s_reasons}")
  execute_process(COMMAND sh "${exit_dir}/../../scripts/compat-common.sh" cases "${s_ledger}" OUTPUT_VARIABLE real RESULT_VARIABLE rc ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "self_test: the parser refuses the stand-in ledger: exit ${rc}: ${err}")
  endif()
  string(REGEX MATCHALL "${s_pat}" real_items "${real}")
  string(REGEX MATCHALL "${s_pat}" want_items "${s_cases}")
  list(LENGTH real_items n_real)
  if(NOT real_items STREQUAL want_items OR n_real EQUAL 0)
    message(FATAL_ERROR "self_test: the in-memory cases text differs from the parser's (${n_real} real fields)")
  endif()

  control(met "${met}" "${absent}" 0 "cart_pass=20/20 cart_pal_judged=1/1 cart_fm_judged=1/1 judged_cart_floors=met flag=absent")
  # The tie, both directions, and the flag as another spelling of the same line.
  control(tie_met_flag_present "${met}" "${present}" 1 "judged-cart floors met: remove is_experimental")
  control(tie_met_flag_spaced "${met}" "${work}/spaced.info" 1 "judged-cart floors met: remove is_experimental")
  foreach(spelling IN ITEMS one upper comment bare true_last)
    control(tie_met_flag_${spelling} "${met}" "${work}/${spelling}.info" 1 "judged-cart floors met: remove is_experimental")
  endforeach()
  control(tie_met_last_line_false "${met}" "${work}/false_last.info" 0 "judged_cart_floors=met flag=absent")
  build(nineteen 19 1 2)
  control(tie_unmet_last_line_false "${nineteen}" "${work}/false_last.info" 1 "is_experimental removed before the judged-cart floors are met")
  control(tie_unmet_flag_absent "${nineteen}" "${absent}" 1 "is_experimental removed before the judged-cart floors are met")
  control(unmet_flag_present "${nineteen}" "${present}" 0 "cart_pass=19/20 .*judged_cart_floors=unmet flag=present")
  control(no_template "${met}" "" 0 "judged_cart_floors=met flag=unchecked")
  # Edges: each stays unmet with the flag present, so exactly one rule keeps it out of the count.
  build(no_pal_rows 20 0 2)
  control(no_pal "${no_pal_rows}" "${present}" 0 "cart_pal_judged=0/1 cart_fm_judged=1/1 judged_cart_floors=unmet flag=present")
  build(no_fm_rows 20 1 0)
  control(no_fm "${no_fm_rows}" "${present}" 0 "cart_pal_judged=1/1 cart_fm_judged=0/1 judged_cart_floors=unmet flag=present")
  build(unknown_rows 0 1 2)
  set(twenty_fixture_rows "${unknown_rows}")
  foreach(n RANGE 1 11)
    set(line "")
    foreach(row IN LISTS fixture_rows)
      if(row MATCHES "vdp_lines_192")
        string(REPLACE "\"fixture/vdp_lines_192\"" "\"fixture/extra_${n}\"" line "${row}")
      endif()
    endforeach()
    list(APPEND twenty_fixture_rows "${line}")
  endforeach()
  control(twenty_fixture_passes "${twenty_fixture_rows}" "${present}" 0 "fixture_pass=20 .*cart_pass=0/20 .*judged_cart_floors=unmet flag=present")
  # Twenty passes keyed by compound identities (a catalog that does not skip them), one PAL and one FM among them.
  set(compound_rows "${fixture_rows}")
  foreach(n RANGE 1 20)
    set(tv ntsc)
    set(on off)
    if(n EQUAL 1)
      set(tv pal)
    elseif(n EQUAL 2)
      set(on on)
    endif()
    cart_row(row "${kid_${n}}" "Cart ${n}" ${tv} ${on} pass "-")
    list(APPEND compound_rows "${row}")
  endforeach()
  cart_row(row "${lone_id}" "Lone" ntsc off unknown "-")
  list(APPEND compound_rows "${row}")
  set(c_catalog "${work}/compound-catalog.tsv")
  set(c_counts none)
  control(twenty_compound_passes "${compound_rows}" "${present}" 0 "cart_pass=0/20 cart_pal_judged=0/1 cart_fm_judged=0/1 judged_cart_floors=unmet flag=present")
  defaults()
  # Two pass rows of one image (default and PAL) are one cart: twenty rows over nineteen images stay unmet.
  cart_row(row "${cid_3}" "Cart 3" pal off pass "-")
  set(twin "${nineteen}")
  list(APPEND twin "${row}")
  control(twin_rows_one_cart "${twin}" "${present}" 0 "cart_pass=19/20 .*judged_cart_floors=unmet flag=present")
  # Cart fail rows never block: twenty passes and extra fails stay met, and the flag must be gone.
  cart_row(row "${cid_3}" "Cart 3" pal off fail "-")
  set(failing "${met}")
  list(APPEND failing "${row}")
  control(cart_fail_rows "${failing}" "${absent}" 0 "cart_pass=20/20 .*judged_cart_floors=met flag=absent")

  # Integrity: each fault ends the run with its leg named.
  edit_rows(empty_evidence "${met}" "^\"${compound_id}\"" "\"reason=multi_chip\"" "\"\"")
  set(c_real ON)
  control(empty_evidence "${empty_evidence}" "${present}" 1 "leg 1: the parser refuses the ledger, exit 2")
  defaults()
  edit_rows(fixture_fail "${met}" "fixture/vdp_lines_192" "\",\"pass\",\"" "\",\"fail\",\"")
  control(fixture_fail "${fixture_fail}" "${present}" 1 "leg 3: 1 fixture rows have status fail")
  edit_rows(infrastructure "${met}" "^\"${cid_20}\"" "\",\"pass\",\"" "\",\"infrastructure_error\",\"")
  control(infrastructure_error "${infrastructure}" "${present}" 1 "leg 3: 1 rows have status infrastructure_error")
  drop_rows(no_pal_fixture "${met}" "\"pal\",\"none\"")
  control(pal_fixture_removed "${no_pal_fixture}" "${present}" 1 "leg 4: fixture rows judged pass 8/9, with tv pal 0/1")
  drop_rows(no_pass_fixture "${met}" "fixture/vdp_lines_192")
  control(fixture_pass_removed "${no_pass_fixture}" "${present}" 1 "leg 4: fixture rows judged pass 8/9")
  edit_rows(enum "${met}" "^\"${cid_20}\"" "\",\"pass\",\"" "\",\"maybe\",\"")
  control(status_outside_enum "${enum}" "${present}" 1 "leg 1: a row has the status maybe")
  string(REPLACE "compat.cart_pass" "compat.cart_passes" broken_quality "${s_quality}")
  set(c_quality "${broken_quality}")
  control(floor_missing "${met}" "${present}" 1 "leg 4: quality.json has no integer floor compat.cart_pass")
  defaults()
  edit_rows(other_reason "${met}" "^\"${compound_id}\"" "reason=multi_chip" "reason=mame_no")
  control(reason_not_the_catalogs "${other_reason}" "${present}" 1 "leg 2: .*differs from the catalog token multi_chip")
  file(READ "${s_reasons}" vocabulary)
  string(REPLACE "multi_chip open" "multi_chip retired" retired "${vocabulary}")
  file(WRITE "${work}/retired.txt" "${retired}")
  set(c_reasons "${work}/retired.txt")
  control(reason_retired "${met}" "${present}" 1 "leg 2: the reason multi_chip is not open")
  defaults()
  drop_rows(no_identity "${met}" "^\"${cid_5}\"")
  control(identity_missing "${no_identity}" "${present}" 1 "leg 5: .*has no ledger row")
  file(READ "${work}/counts.txt" counts_text)
  string(REPLACE "entries_sms 21" "entries_sms 20" counts_text "${counts_text}")
  file(WRITE "${work}/low-counts.txt" "${counts_text}")
  set(c_counts "${work}/low-counts.txt")
  control(pin_counts_one_low "${met}" "${present}" 1 "leg 5: .*differ from the pin counts")
  defaults()

  # The single child: the command's own exit status on a real file, and the tie direction at once.
  ledger_write(child "${met}")
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DLEDGER=${s_ledger}" "-DINFO=${present}" "-DCATALOG=${work}/catalog.tsv" -DCOUNTS=none
    "-DOUT=${work}/child" -P "${exit_self}" RESULT_VARIABLE rc OUTPUT_VARIABLE child_out ERROR_VARIABLE child_err)
  math(EXPR children "${children}+1")
  if(NOT rc EQUAL 1 OR NOT "${child_out}${child_err}" MATCHES "judged-cart floors met: remove is_experimental")
    message(FATAL_ERROR "self_test: the command on a met ledger with the flag present exited ${rc}: ${child_out}${child_err}")
  endif()
  if(NOT children EQUAL 1 OR controls LESS 14)
    message(FATAL_ERROR "self_test: ${controls} controls and ${children} children")
  endif()
  message(STATUS "compat.exit.self_test: ${controls} controls, ${children} child")
  return()
endif()
message(FATAL_ERROR "unknown CASE ${CASE}")
