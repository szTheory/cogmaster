# Fault prevented: quoted titles are split, reordered or silently accepted malformed.
if(CMAKE_SCRIPT_MODE_FILE)
  file(MAKE_DIRECTORY "${OUT}")
  function(common mode path)
    execute_process(COMMAND sh "${ROOT}/scripts/compat-common.sh" "${mode}" "${path}"
      RESULT_VARIABLE rc OUTPUT_VARIABLE text ERROR_VARIABLE err)
    set(rc "${rc}" PARENT_SCOPE)
    set(text "${text}" PARENT_SCOPE)
    set(err "${err}" PARENT_SCOPE)
  endfunction()
  if(CASE STREQUAL "fresh")
    common(docs "${ROOT}/tests/compat/ledger.csv")
    if(NOT rc STREQUAL "0")
      message(FATAL_ERROR "compat doc generator exit ${rc}: ${err}")
    endif()
    file(READ "${ROOT}/docs/compatibility.md" committed)
    if(WRONG)
      string(APPEND committed "stale content")
    endif()
    if(NOT text STREQUAL committed)
      message(FATAL_ERROR "compatibility doc differs from regenerated ledger")
    endif()
    return()
  elseif(CASE STREQUAL "fixtures")
    common(cases "${ROOT}/tests/compat/ledger.csv")
    if(NOT rc STREQUAL "0")
      message(FATAL_ERROR "compat cases failed: ${err}")
    endif()
    file(WRITE "${OUT}/cases.cmake" "${text}")
    include("${OUT}/cases.cmake")
    file(READ "${ROOT}/tests/built/expected.txt" admitted)
    set(evaluated 0)
    foreach(i RANGE 1 ${compat_count})
      set(case "compat_${i}")
      if(NOT ${case}_id MATCHES "^fixture/([A-Za-z0-9_.-]+)$")
        continue()
      endif()
      set(name "${CMAKE_MATCH_1}")
      if(NOT ${case}_status MATCHES "^(pass|fail)$")
        continue()
      endif()
      if(NOT admitted MATCHES "(^|\n)${name} ([0-9a-f]+)(\n|$)")
        message(FATAL_ERROR "fixture lacks admitted build pin: ${name}")
      endif()
      set(want "${CMAKE_MATCH_2}")
      file(SHA256 "${FIXTURES}/${name}.sms" got)
      if(NOT got STREQUAL want)
        message(FATAL_ERROR "fixture differs from admitted bytes: ${name}")
      endif()
      if(NOT ${case}_config MATCHES "^cfg:video=(sms|gg);port1=(pad|none);port2=(pad|none);script=none;sha256=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855$")
        message(FATAL_ERROR "fixture execution configuration is not implemented")
      endif()
      set(video "${CMAKE_MATCH_1}")
      set(port1 "${CMAKE_MATCH_2}")
      set(port2 "${CMAKE_MATCH_3}")
      set(predicate "${${case}_parameter}")
      if(NOT "${${case}_expected}" STREQUAL "")
        string(APPEND predicate "=${${case}_expected}")
      endif()
      file(WRITE "${OUT}/${i}.expect" "${predicate}\n")
      execute_process(COMMAND ${EMULATOR} "${RUN}" --machine "${${case}_machine}" --region "${${case}_region}"
        --video-mode "${video}" --port1 "${port1}" --port2 "${port2}" --frames "${${case}_cap}"
        --expect "${OUT}/${i}.expect" "${FIXTURES}/${name}.sms" RESULT_VARIABLE rc OUTPUT_VARIABLE text ERROR_VARIABLE err)
      set(code 0)
      if(${case}_status STREQUAL "fail")
        set(code 3)
      endif()
      if(NOT rc STREQUAL "${code}" OR NOT text MATCHES "predicate kind=")
        message(FATAL_ERROR "ledger disagrees with fresh fixture predicate ${${case}_id}: exit ${rc}: ${text}${err}")
      endif()
      set(boards none sega codemasters)
      list(FIND boards "${${case}_mapper}" board)
      math(EXPR board "${board}+1")
      if(board EQUAL 0 OR NOT text MATCHES "execution machine=.*mapper=${board} port1=")
        message(FATAL_ERROR "resolved board does not match ledger execution identity")
      endif()
      math(EXPR evaluated "${evaluated}+1")
    endforeach()
    if(NOT evaluated EQUAL 4)
      message(FATAL_ERROR "fixture predicate coverage changed: ${evaluated}; update expected coverage explicitly")
    endif()
    common(normalize "${ROOT}/tests/compat/ledger.csv")
    if(NOT rc STREQUAL "0")
      message(FATAL_ERROR "cannot serialize evaluated results: ${err}")
    endif()
    file(WRITE "${OUT}/results.csv" "${text}")
    message(STATUS "evaluated ${evaluated} admitted own-fixture predicates")
    return()
  endif()
  set(header "id,title,machine,region,mapper,predicate,status,evidence,date\n")
  set(row "fixture/a,\"A, \"\"quoted\"\"; title\",sms,ntsc-u,sega,boots@20,unknown,-,2026-10-20\n")
  file(WRITE "${OUT}/quoted.csv" "${header}${row}")
  common(normalize "${OUT}/quoted.csv")
  if(NOT rc STREQUAL "0" OR NOT text MATCHES "\"fixture/a\",\"A, \"\"quoted\"\"; title\"")
    message(FATAL_ERROR "accepted quoted CSV must normalize nine fields without changing title: exit ${rc}, ${text}${err}")
  endif()
  file(WRITE "${OUT}/normalized.csv" "${text}")
  common(normalize "${OUT}/normalized.csv")
  file(READ "${OUT}/normalized.csv" want)
  if(NOT rc STREQUAL "0" OR NOT text STREQUAL want)
    message(FATAL_ERROR "quoted CSV must round-trip idempotently")
  endif()
  string(ASCII 13 cr)
  string(REPLACE "\n" "${cr}\n" crlf "${header}${row}")
  file(WRITE "${OUT}/crlf.csv" "${crlf}")
  common(normalize "${OUT}/crlf.csv")
  if(NOT rc STREQUAL "0" OR NOT text STREQUAL want)
    message(FATAL_ERROR "CRLF CSV must preserve the same logical fields")
  endif()
  function(reject body)
    file(WRITE "${OUT}/invalid.csv" "${body}")
    common(normalize "${OUT}/invalid.csv")
    if(NOT rc STREQUAL "2" OR NOT err MATCHES "invalid ledger record")
      message(FATAL_ERROR "malformed CSV must reject with exit 2: ${rc}, ${text}${err}")
    endif()
  endfunction()
  reject("")
  reject("${header}\n")
  reject("${header}${row}${row}")
  string(REPLACE "boots@20" "boots@00020" alias "${row}")
  reject("${header}${row}${alias}")
  set(many "${header}")
  foreach(i RANGE 1 4097)
    string(APPEND many "fixture/f${i},title,sms,ntsc-u,sega,boots@20,unknown,-,2026-10-20\n")
  endforeach()
  reject("${many}")
  string(REPEAT x 4194305 large)
  file(WRITE "${OUT}/large.csv" "${large}")
  common(normalize "${OUT}/large.csv")
  if(NOT rc STREQUAL "2" OR NOT err MATCHES "invalid ledger input")
    message(FATAL_ERROR "ledger byte cap must reject before parsing")
  endif()
  foreach(body IN ITEMS "fixture/a,\"unclosed,sms,ntsc-u,sega,boots@20,unknown,-,2026-10-20\n"
      "fixture/a,\"closed\"x,sms,ntsc-u,sega,boots@20,unknown,-,2026-10-20\n"
      "fixture/a,bad\"quote,sms,ntsc-u,sega,boots@20,unknown,-,2026-10-20\n"
      "fixture/a,title,sms,ntsc-u,sega,boots@20,unknown,-\n"
      "fixture/a,title,sms,ntsc-u,sega,boots@20,unknown,-,2026-10-20,extra\n"
      "fixture/a,,sms,ntsc-u,sega,boots@20,unknown,-,2026-10-20\n")
    reject("${header}${body}")
  endforeach()
  string(REPEAT x 4097 long)
  reject("${header}${long}\n")
  string(REPEAT x 1025 long)
  reject("${header}fixture/a,${long},sms,ntsc-u,sega,boots@20,unknown,-,2026-10-20\n")
  file(WRITE "${OUT}/empty.csv" "${header}")
  common(docs "${OUT}/empty.csv")
  if(NOT rc STREQUAL "0" OR NOT text MATCHES "Rows: 0. Evaluated coverage: 0. Own fixtures: 0.")
    message(FATAL_ERROR "header-only ledger must report explicit zero coverage")
  endif()
  set(ordered "${header}")
  set(reversed "")
  foreach(status IN ITEMS pass fail unknown unsupported infrastructure_error skipped)
    set(next "fixture/${status},title,sms,ntsc-u,sega,boots@20,${status},-,2026-10-20\n")
    string(APPEND ordered "${next}")
    string(PREPEND reversed "${next}")
  endforeach()
  file(WRITE "${OUT}/ordered.csv" "${ordered}")
  file(WRITE "${OUT}/reversed.csv" "${header}${reversed}")
  foreach(mode IN ITEMS normalize docs cases)
    common(${mode} "${OUT}/ordered.csv")
    set(want "${text}")
    if(NOT rc STREQUAL "0")
      message(FATAL_ERROR "valid status/control cases failed")
    endif()
    common(${mode} "${OUT}/reversed.csv")
    if(NOT rc STREQUAL "0" OR NOT text STREQUAL want)
      message(FATAL_ERROR "row permutation changes normalized ${mode}")
    endif()
    if(mode STREQUAL "docs" AND NOT text MATCHES "Evaluated coverage: 2")
      message(FATAL_ERROR "unknown/unsupported/infrastructure must not count as evaluated")
    endif()
  endforeach()
  string(REPLACE "boots@20" "ram@00020:$c200=0a" alias "${row}")
  string(REPLACE "boots@20" "ram@20:$C200=FF" second "${row}")
  reject("${header}${alias}${second}")
  string(REPLACE "ntsc-u" "any" alias "${row}")
  reject("${header}${row}${alias}")
  message(STATUS "quoted CSV bounds, duplicate aliases, ordering and zero coverage passed")
  return()
endif()
set(compat_labels compat)
if(COGMASTER_HYGIENE)
  list(APPEND compat_labels hygiene)
endif()
cogmaster_add_test(NAME compat.ratchet
  COMMAND ${CMAKE_COMMAND} -DROOT=${PROJECT_SOURCE_DIR} -DOUT=${PROJECT_BINARY_DIR}/tests/compat-ratchet
    -P ${CMAKE_CURRENT_LIST_DIR}/ratchet.cmake LABELS ${compat_labels} TIMEOUT 30)
cogmaster_add_test(NAME compat.csv
  COMMAND ${CMAKE_COMMAND} -DROOT=${PROJECT_SOURCE_DIR} -DOUT=${PROJECT_BINARY_DIR}/tests/compat
    -P ${CMAKE_CURRENT_LIST_FILE} LABELS ${compat_labels} TIMEOUT 30)
cogmaster_add_test(NAME policy.compat_doc_fresh
  COMMAND ${CMAKE_COMMAND} -DROOT=${PROJECT_SOURCE_DIR} -DCASE=fresh -DOUT=${PROJECT_BINARY_DIR}/tests/compat-doc
    -P ${CMAKE_CURRENT_LIST_FILE} LABELS ${compat_labels} policy TIMEOUT 30)
set(compat_control ${CMAKE_COMMAND} -DROOT=${PROJECT_SOURCE_DIR} -DCASE=fresh -DWRONG=ON
  -DOUT=${PROJECT_BINARY_DIR}/tests/compat-doc-control -P ${CMAKE_CURRENT_LIST_FILE})
string(REPLACE ";" "$<SEMICOLON>" compat_control "${compat_control}")
