  file(WRITE "${OUT}/reversed.csv" "${header}${reversed}")
  foreach(mode IN ITEMS normalize docs cases)
    common(${mode} "${OUT}/ordered.csv")
    set(want "${text}")
    if(NOT rc STREQUAL "0")
      message(FATAL_ERROR "valid status/control cases failed")
