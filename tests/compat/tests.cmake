      endif()
    else()
      reject("${header}${bad}")
    endif()
  endforeach()
  string(REPLACE "fixture/a," "built/a," bad "${row}")
  reject("${header}${bad}")
  message(STATUS "quoted CSV bounds, duplicate aliases, ordering, audio forms and zero coverage passed")
  return()
