    file(STRINGS "${ROOT}/tests/compat/ledger.csv" fixture_rows REGEX "^(id,|\"fixture/)")
    set(fixture_ledger "")
    foreach(line IN LISTS fixture_rows)
      string(APPEND fixture_ledger "${line}\n")
    endforeach()
    file(WRITE "${OUT}/fixture-ledger.csv" "${fixture_ledger}")
    execute_process(COMMAND awk "/^\\042fixture\\// {n++} END {print n + 0}" "${ROOT}/tests/compat/ledger.csv"
      RESULT_VARIABLE rc OUTPUT_VARIABLE live_fixtures OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    common(cases "${OUT}/fixture-ledger.csv")
    if(NOT rc STREQUAL "0")
      message(FATAL_ERROR "compat cases failed: ${err}")
    endif()
    file(WRITE "${OUT}/cases.cmake" "${text}")
    include("${OUT}/cases.cmake")
    if(NOT compat_count EQUAL live_fixtures)
      message(FATAL_ERROR "the fixture extract has ${compat_count} rows but the ledger holds ${live_fixtures} fixture lines")
    endif()
    file(READ "${ROOT}/tests/built/expected.txt" admitted)
    # Raw values typed here, never derived from the awk or the runner: region export 1, japan 2; tv ntsc 1, pal 2; fm off 1, on 2.
    set(raw_export 1)
    set(raw_japan 2)
    set(raw_ntsc 1)
    set(raw_pal 2)
    set(raw_off 1)
    set(raw_on 2)
    function(identity verdict id output region tv fm)
      set(got_region "")
      set(got_tv "")
      set(got_fm "")
      if(output MATCHES "execution machine=[0-9]+ region=([0-9]) tv=([0-9]) fm=([0-9])")
        set(got_region "${CMAKE_MATCH_1}")
        set(got_tv "${CMAKE_MATCH_2}")
        set(got_fm "${CMAKE_MATCH_3}")
      endif()
      set(${verdict} ok PARENT_SCOPE)
      if(NOT got_region STREQUAL "${raw_${region}}" OR NOT got_tv STREQUAL "${raw_${tv}}" OR NOT got_fm STREQUAL "${raw_${fm}}")
        set(${verdict} "identity mismatch ${id}: row ${region} ${tv} ${fm}, run ${got_region} ${got_tv} ${got_fm}" PARENT_SCOPE)
      endif()
    endfunction()
    set(evaluated 0)
    set(noflag_japan 0)
    set(noflag_export 0)
    foreach(i RANGE 1 ${compat_count})
      set(case "compat_${i}")
      if(NOT ${case}_id MATCHES "^fixture/([A-Za-z0-9_.-]+)$")
        continue()
      endif()
      set(name "${CMAKE_MATCH_1}")
      if(NOT ${case}_status MATCHES "^(pass|fail)$")
        continue()
      endif()
      if(NOT admitted MATCHES "(^|\n)${name} ([0-9a-f]+)(\n|$)")
        message(FATAL_ERROR "fixture lacks admitted build pin: ${name}")
      endif()
      set(want "${CMAKE_MATCH_2}")
      file(SHA256 "${FIXTURES}/${name}.sms" got)
      if(NOT got STREQUAL want)
        message(FATAL_ERROR "fixture differs from admitted bytes: ${name}")
      endif()
      if(NOT "${${case}_script}" STREQUAL "none")
        message(FATAL_ERROR "fixture execution configuration is not implemented")
      endif()
      set(predicate "${${case}_parameter}")
      if(NOT "${${case}_expected}" STREQUAL "")
        string(APPEND predicate "=${${case}_expected}")
      endif()
      file(CONFIGURE OUTPUT "${OUT}/${i}.expect" CONTENT "${predicate}\n" NEWLINE_STYLE UNIX @ONLY)
      execute_process(COMMAND ${EMULATOR} "${RUN}" --machine "${${case}_machine}" --region "${${case}_runner_region}"
        --fm "${${case}_fm}" --video-mode "${${case}_video}" --port1 "${${case}_port1}" --port2 "${${case}_port2}" --frames "${${case}_cap}"
        --expect "${OUT}/${i}.expect" "${FIXTURES}/${name}.sms" RESULT_VARIABLE rc OUTPUT_VARIABLE text ERROR_VARIABLE err)
      set(code 0)
      if(${case}_status STREQUAL "fail")
        set(code 3)
      endif()
      if(NOT rc STREQUAL "${code}" OR NOT text MATCHES "predicate kind=")
        message(FATAL_ERROR "ledger disagrees with fresh fixture predicate ${${case}_id}: exit ${rc}: ${text}${err}")
      endif()
      set(boards none sega codemasters)
      list(FIND boards "${${case}_mapper}" board)
      math(EXPR board "${board}+1")
      if(board EQUAL 0 OR NOT text MATCHES "execution machine=.*mapper=${board} port1=")
        message(FATAL_ERROR "resolved board does not match ledger execution identity")
      endif()
      # Fault prevented: an audio hash accepted without its profile (the hash carries no profile bytes: psg_sweep on sms and
      # gg-sms at ntsc-u share one digest), and a default fm that drifts between the awk, the core and the runner while every row passes.
      identity(verdict "${${case}_id}" "${text}" "${${case}_region}" "${${case}_tv}" "${${case}_fm}")
      if(NOT verdict STREQUAL "ok")
        message(FATAL_ERROR "${verdict}")
      endif()
      if(${case}_parameter MATCHES "^audio@" AND name STREQUAL "psg_sweep")
        if(${case}_region STREQUAL "japan" AND NOT noflag_japan)
          set(noflag_japan ${i})
        elseif(${case}_region STREQUAL "export" AND ${case}_tv STREQUAL "ntsc" AND NOT noflag_export)
          set(noflag_export ${i})
        endif()
      endif()
      if(${case}_parameter MATCHES "^audio@" AND NOT DEFINED control_case)
        set(control_case ${i})
        set(control_text "${text}")
      endif()
      math(EXPR evaluated "${evaluated}+1")
    endforeach()
    if(NOT evaluated EQUAL 9)
      message(FATAL_ERROR "fixture predicate coverage changed: ${evaluated}; update expected coverage explicitly")
    endif()
    if(NOT noflag_japan OR NOT noflag_export)
      message(FATAL_ERROR "the ledger lacks a japan and an export psg_sweep audio row for the default fm check")
    endif()
    # The default fm without --fm: the awk default is read by normalizing a two-row ledger whose cfg omits fm (the committed
    # rows spell fm on every row, so only this input reaches the awk default), then compared with the core default the runner reports.
    file(READ "${ROOT}/tests/audio/transitions.txt" pins)
    set(default_rows "id,title,machine,region,tv,mapper,predicate,status,evidence,date\n")
    foreach(region IN ITEMS export japan)
      set(profile ntsc-u)
      if(region STREQUAL "japan")
        set(profile ntsc-j)
      endif()
      if(NOT pins MATCHES "psg_sweep.sms sms ${profile} baseline 300 count [0-9]+ sha256 ([0-9a-f]+)")
        message(FATAL_ERROR "no pinned psg_sweep stream for ${profile}")
      endif()
      set(pin_${region} "${CMAKE_MATCH_1}")
      string(APPEND default_rows "fixture/psg_sweep,t,sms,${region},ntsc,none,cfg:video=sms;port1=pad;port2=pad;script=none;sha256=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855/audio@300=${CMAKE_MATCH_1},pass,-,2026-11-11\n")
    endforeach()
    file(WRITE "${OUT}/default.csv" "${default_rows}")
    common(normalize "${OUT}/default.csv")
    if(NOT rc STREQUAL "0")
      message(FATAL_ERROR "default fm ledger failed to normalize: ${err}")
    endif()
    set(normalized "${text}")
    foreach(region IN ITEMS export japan)
      if(NOT normalized MATCHES "\"${region}\",\"ntsc\",\"none\",\"cfg:video=sms;fm=(on|off);")
        message(FATAL_ERROR "normalize printed no fm for the ${region} default row")
      endif()
      set(awk_fm_${region} "${CMAKE_MATCH_1}")
      file(CONFIGURE OUTPUT "${OUT}/default-${region}.expect" CONTENT "audio@300=${pin_${region}}\n" NEWLINE_STYLE UNIX @ONLY)
      set(runner_region ntsc-u)
      if(region STREQUAL "japan")
        set(runner_region ntsc-j)
      endif()
      execute_process(COMMAND ${EMULATOR} "${RUN}" --machine sms --region ${runner_region} --video-mode sms --frames 300
        --expect "${OUT}/default-${region}.expect" "${FIXTURES}/psg_sweep.sms" RESULT_VARIABLE rc OUTPUT_VARIABLE text ERROR_VARIABLE err)
      if(NOT rc STREQUAL "0")
        message(FATAL_ERROR "default fm run of the ${region} row without --fm: exit ${rc}: ${text}${err}")
      endif()
      identity(verdict "default-${region}" "${text}" ${region} ntsc ${awk_fm_${region}})
      if(NOT verdict STREQUAL "ok")
        message(FATAL_ERROR "${verdict}")
      endif()
    endforeach()
    # Controls: the same check over a copy of one row's output with fm, tv or region flipped must report a mismatch.
    set(controls 0)
    foreach(flip IN ITEMS "export ntsc on" "japan ntsc off" "export pal off")
      string(REPLACE " " ";" parts "${flip}")
      list(GET parts 0 flip_region)
      list(GET parts 1 flip_tv)
      list(GET parts 2 flip_fm)
      identity(verdict "control" "${control_text}" ${flip_region} ${flip_tv} ${flip_fm})
      if(verdict STREQUAL "ok")
        message(FATAL_ERROR "the identity control accepted a flipped profile: ${flip}")
      endif()
      math(EXPR controls "${controls}+1")
    endforeach()
    common(results "${OUT}/fixture-ledger.csv")
    if(NOT rc STREQUAL "0")
      message(FATAL_ERROR "cannot serialize evaluated results: ${err}")
    endif()
    file(WRITE "${OUT}/results.csv" "${text}")
    message(STATUS "evaluated ${evaluated} admitted own-fixture predicates")
    message(STATUS "identity controls: ${controls}")
    return()
  elseif(CASE STREQUAL "reasons")
    # Fault prevented: a reason the catalog uses that the vocabulary does not list or has retired, or a vocabulary that drifts from
    # the slots of the cartridge table that have no board. Two live spawns; the controls reuse their answers on throwaway copies.
    execute_process(COMMAND awk -F "\t" "$2 !~ /^sg$/ && $6 ~ /^(unsupported|skipped)$/ && !seen[$7]++ {print $7}" "${ROOT}/tests/compat/catalog.tsv"
      RESULT_VARIABLE rc OUTPUT_VARIABLE catalog_tokens COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND awk "/^\\{[0-9]+u, 0u, / && !/SG-1000/ {split($0, q, /\\042/); print q[2]}" "${ROOT}/src/cartdb.inc"
      RESULT_VARIABLE rc OUTPUT_VARIABLE slot_tokens COMMAND_ERROR_IS_FATAL ANY)
    string(REGEX REPLACE "[ \t\r\n]+" ";" catalog_tokens "${catalog_tokens}")
    string(REGEX REPLACE "[ \t\r\n]+" ";" slot_tokens "${slot_tokens}")
    list(FILTER catalog_tokens EXCLUDE REGEX "^$")
    list(FILTER slot_tokens EXCLUDE REGEX "^$")
    list(SORT slot_tokens)
    set(pins mame_no no_rom bad_dump multi_chip short_dump)
    function(reasons_verdict path out)
      file(STRINGS "${path}" lines REGEX "^[a-z0-9_]+ (open|retired)$")
      set(listed "")
      set(open "")
      foreach(line IN LISTS lines)
        string(REPLACE " " ";" parts "${line}")
        list(GET parts 0 token)
        list(GET parts 1 state)
        list(APPEND listed "${token}")
        if(state STREQUAL "open")
          list(APPEND open "${token}")
        endif()
      endforeach()
      set(${out} "" PARENT_SCOPE)
      foreach(token IN LISTS catalog_tokens pins)
        if(NOT token IN_LIST listed)
          set(${out} "reason ${token} is not listed" PARENT_SCOPE)
          return()
        endif()
      endforeach()
      foreach(token IN LISTS catalog_tokens)
        if(NOT token IN_LIST open)
          set(${out} "reason ${token} is retired but the catalog still uses it" PARENT_SCOPE)
          return()
        endif()
      endforeach()
      list(REMOVE_ITEM open ${pins})
      list(SORT open)
      if(NOT "${open}" STREQUAL "${slot_tokens}")
        set(${out} "open slot reasons [${open}] differ from the slots of the table [${slot_tokens}]" PARENT_SCOPE)
      endif()
    endfunction()
    reasons_verdict("${ROOT}/tests/compat/reasons.txt" verdict)
    if(NOT verdict STREQUAL "")
      message(FATAL_ERROR "tests/compat/reasons.txt: ${verdict}")
    endif()
    list(LENGTH catalog_tokens used)
    if(used LESS 9)
      message(FATAL_ERROR "the catalog uses fewer reasons than expected: ${used}")
    endif()
    file(READ "${ROOT}/tests/compat/reasons.txt" text)
    string(REPLACE "graphic open" "graphic retired" retired "${text}")
    string(REPLACE "xterminator open\n" "" missing "${text}")
    string(REPLACE "no_rom open\n" "" lost_pin "${text}")
    foreach(control IN ITEMS "retired|graphic" "missing|xterminator" "lost_pin|no_rom")
      string(REPLACE "|" ";" control "${control}")
      list(GET control 0 name)
      list(GET control 1 token)
      if(${name} STREQUAL "${text}")
        message(FATAL_ERROR "the ${name} control did not change the file")
      endif()
      file(WRITE "${OUT}/reasons-${name}.txt" "${${name}}")
      reasons_verdict("${OUT}/reasons-${name}.txt" verdict)
      if(NOT verdict MATCHES "${token}")
        message(FATAL_ERROR "the ${name} control must be refused naming ${token}: ${verdict}")
      endif()
    endforeach()
    message(STATUS "compat.reasons: ${used} reasons in use, 3 controls")
    return()
  elseif(CASE STREQUAL "page_bound")
    # A hostile ledger of 700 rows, built once in this pass: long titles of markdown and multibyte characters, 100 mappers, 100 fail rows,
    # 100 unsupported rows, 100 skipped and 170 unknown rows. Every expected overflow is counted here from the construction, never read back
    # from the page, and with -DWRONG=ON the caps of a copy of the script are raised to show that the bound is the caps and not luck.
    set(budget 36864)
    set(empty e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855)
    string(ASCII 195 169 e_acute)
    string(ASCII 230 188 162 han)
    string(ASCII 208 182 zhe)
    string(REPEAT "|&<*${e_acute}${han}${zhe}" 23 hostile)
    string(APPEND hostile ab)
    string(LENGTH "${hostile}" hostile_bytes)
    if(NOT hostile_bytes EQUAL 255)
      message(FATAL_ERROR "the hostile title must be 255 bytes, not ${hostile_bytes}")
    endif()
    set(zeros 0000000000000000000000000000000000000000)
    string(REGEX REPLACE "0$" "1" near_zero "${zeros}")
    set(lphaser "cfg:video=sms;fm=off;port1=lphaser;port2=pad;script=none;sha256=${empty}/boots@600")
    set(rows "id,title,machine,region,tv,mapper,predicate,status,evidence,date\n")
    set(groups "")
    set(reasons "")
    set(count_pass 0)
    set(count_fail 0)
    set(count_unsupported 0)
    set(n 0)
    foreach(i RANGE 1 30)
      string(APPEND rows "fixture/f${i},\"${hostile}\",sms,export,ntsc,none,boots@20,pass,-,2026-10-20\n")
    endforeach()
    list(APPEND groups sms/none/pass)
    foreach(entry IN ITEMS pass:200 fail:100 unsupported:100 skipped:100 unknown:170)
      string(REPLACE ":" ";" parts "${entry}")
      list(GET parts 0 status)
      list(GET parts 1 total)
      foreach(k RANGE 1 ${total})
        math(EXPR n "${n}+1")
        math(EXPR m "${n}%100")
        math(EXPR t "(${k}-1)%39+1")
        string(SHA1 id "cart${n}")
        set(title "${hostile}")
        set(predicate "boots@600")
        set(evidence -)
        if(status STREQUAL "pass" AND k EQUAL 1)
          set(id "${near_zero}")
          set(predicate "${lphaser}")
        elseif(status STREQUAL "unsupported")
          set(evidence "reason=t${t}")
          list(APPEND reasons "t${t}|unsupported")
          if(k EQUAL 1)
            set(id "${zeros}")
            set(title "Sega Graphic Board (Japan, prototype v2.0)")
          endif()
        elseif(status STREQUAL "skipped")
          set(evidence reason=mame_no)
          list(APPEND reasons "mame_no|skipped")
        endif()
        if(DEFINED count_${status})
          math(EXPR count_${status} "${count_${status}}+1")
        endif()
        list(APPEND groups "sms/m${m}/${status}")
        string(APPEND rows "${id},\"${title}\",sms,export,ntsc,m${m},${predicate},${status},${evidence},2026-10-20\n")
      endforeach()
    endforeach()
    list(REMOVE_DUPLICATES groups)
    list(REMOVE_DUPLICATES reasons)
    list(LENGTH groups group_count)
    list(LENGTH reasons reason_count)
    file(WRITE "${OUT}/ledger.csv" "${rows}")
    set(token_lines "mame_no open\n")
    foreach(t RANGE 1 39)
      string(APPEND token_lines "t${t} open\n")
    endforeach()
    file(WRITE "${OUT}/reasons.txt" "${token_lines}")
    set(catalog "")
    foreach(i RANGE 1 3)
      string(SHA1 sg "sg${i}")
      string(APPEND catalog "${sg}\tsg\tunsupported\t-\tSynthetic ${i}\texcluded\t-\texport\tpad\tpad\n")
    endforeach()
    file(WRITE "${OUT}/catalog.tsv" "${catalog}")
    set(ENV{COMPAT_REASONS} "${OUT}/reasons.txt")
    set(ENV{COMPAT_CATALOG} "${OUT}/catalog.tsv")
    set(script "${ROOT}/scripts/compat-common.sh")
    if(WRONG)
      file(READ "${script}" original)
      string(REGEX REPLACE "cap_([a-z]+)=[0-9]+" "cap_\\1=100000" raised "${original}")
      if(raised STREQUAL original)
        message(FATAL_ERROR "no cap assignment found in the script")
      endif()
      file(WRITE "${OUT}/raised.sh" "${raised}")
      set(script "${OUT}/raised.sh")
    endif()
    execute_process(COMMAND sh "${script}" docs "${OUT}/ledger.csv" RESULT_VARIABLE rc OUTPUT_VARIABLE page ERROR_VARIABLE err)
    string(LENGTH "${page}" size)
    if(NOT rc STREQUAL "0")
      message(FATAL_ERROR "the page of the hostile ledger failed: exit ${rc}: ${err}")
    endif()
    if(NOT size LESS budget)
      message(FATAL_ERROR "page exceeds the page budget: ${size} bytes")
    endif()
    message(STATUS "page_bound: ${size} bytes of ${budget}")
    # Each overflow line carries exactly the count the construction implies.
    math(EXPR unsupported_more "${count_unsupported}-20")
    math(EXPR fail_more "${count_fail}-40")
    math(EXPR other_more "${count_pass}-40")
    math(EXPR group_more "${group_count}-60")
    math(EXPR reason_more "${reason_count}-32")
    foreach(pair IN ITEMS "fixtures|6" "unsupported rows|${unsupported_more}" "fail rows|${fail_more}" "other evaluated rows|${other_more}" "groups|${group_more}" "reasons|${reason_more}")
      string(REPLACE "|" ";" parts "${pair}")
      list(GET parts 0 section)
      list(GET parts 1 want)
      if(NOT page MATCHES "\n\\+([0-9]+) more ${section}[;\n]" OR NOT CMAKE_MATCH_1 STREQUAL want)
        message(FATAL_ERROR "the page must say +${want} more ${section}, not '${CMAKE_MATCH_1}'")
      endif()
    endforeach()
    # 30 fixture and 200 cart passes plus 100 fails are 330 evaluated rows; the counts line says so.
    if(NOT page MATCHES "Rows: 700\\. Evaluated coverage: 330\\. Own fixtures: 30\\." OR NOT page MATCHES "unevaluated: unknown=170 unsupported=100 skipped=100" OR NOT page MATCHES "SG-1000 entries excluded: 3 ")
      message(FATAL_ERROR "the counts of the page differ from the construction")
    endif()
    if(page MATCHES "[^\n -~]")
      message(FATAL_ERROR "the page holds a byte outside printable ASCII")
    endif()
    string(REPLACE ";" "," flat "${page}")
    string(REPLACE "\n" ";" page_lines "${flat}")
    foreach(line IN LISTS page_lines)
      string(LENGTH "${line}" line_bytes)
      if(line_bytes GREATER 600)
        message(FATAL_ERROR "a page line is ${line_bytes} bytes")
      endif()
    endforeach()
    # No title character reaches a table row raw, and a non-default profile prints only its differing tokens.
    if(page MATCHES "\n\\|[^\n]*[<*]" OR NOT page MATCHES "&#124;&amp;&lt;&#42;")
      message(FATAL_ERROR "a title reached a table row unescaped")
    endif()
    if(NOT page MATCHES "\n\\| 000000000000 \\| [^\n]* \\| sms/export/ntsc/m1 fm=off boots@600 port1=lphaser \\| pass \\|" OR page MATCHES "(port2|script)=")
      message(FATAL_ERROR "a non-default profile must print its differing tokens only")
    endif()
    # The shape of three pinned titles: a catalog title holding the planning label prints in a table row, and the rule that keeps
    # the label out of the page binds generated prose, which is every line that does not start with a vertical bar.
    if(NOT page MATCHES "\n\\| 000000000000 \\| Sega Graphic Board &#40;Japan, prototype v2\\.0&#41; \\|" OR page MATCHES "\n[^|\n][^\n]*v2\\.0")
      message(FATAL_ERROR "the title with the planning label must be in a table row and in no prose line")
    endif()
    return()
  elseif(CASE STREQUAL "hardening")
    # Fault prevented: a title that spoofs text direction, hides characters or becomes a spreadsheet formula, a markdown title that
    # becomes a link or emphasis when the page is regenerated, and a ledger large enough to hold the runner's time hostage.
    set(header "id,title,machine,region,tv,mapper,predicate,status,evidence,date\n")
    function(titled name want bytes)
      file(WRITE "${OUT}/${name}.csv" "${header}fixture/a,${bytes},sms,export,ntsc,sega,boots@20,unknown,-,2026-10-20\n")
      common(normalize "${OUT}/${name}.csv")
      if(NOT rc STREQUAL "${want}" OR (want STREQUAL 2 AND NOT err MATCHES "invalid ledger record"))
        message(FATAL_ERROR "title ${name}: expected exit ${want}, got ${rc}: ${err}")
      endif()
    endfunction()
    # Bytes of the format characters (UTF-8 of U+200B, U+202E, U+2066, U+FEFF) and of the characters just outside each range.
    string(ASCII 226 128 139 zero_width)
    string(ASCII 226 128 174 bidi_override)
    string(ASCII 226 129 166 bidi_isolate)
    string(ASCII 239 187 191 byte_order_mark)
    string(ASCII 226 128 138 below_range)
    string(ASCII 226 129 165 below_isolate)
    string(ASCII 195 169 accent)
    foreach(hostile IN ITEMS "equals|=cmd" "plus|+1" "minus|-1" "at|@x" "zero_width|a${zero_width}b" "bidi_override|a${bidi_override}b"
        "bidi_isolate|a${bidi_isolate}b" "byte_order_mark|${byte_order_mark}a")
      string(REPLACE "|" ";" parts "${hostile}")
      list(GET parts 0 name)
      list(GET parts 1 bytes)
      titled("${name}" 2 "${bytes}")
    endforeach()
    titled(plain 0 "Caf${accent} (x) a-b=c+d@e")
    # The library judge writes a lone dash as the title of a fact (the catalog title replaces it), so it must parse.
    titled(lone_dash 0 "-")
    titled(plain_quoted 0 "\"Caf${accent} \"\"q\"\", (x)\"")
    titled(below_range 0 "a${below_range}b")
    titled(below_isolate 0 "a${below_isolate}b")
    # The row cap is exactly 8,192 data rows: ids are zero padded, so the rows are already in key order and the parse stays linear.
    set(rows "")
    foreach(i RANGE 1 8192)
      math(EXPR padded "100000+${i}")
      string(APPEND rows "fixture/r${padded},t,sms,export,ntsc,sega,boots@20,unknown,-,2026-10-20\n")
    endforeach()
    file(WRITE "${OUT}/cap.csv" "${header}${rows}")
    common(normalize "${OUT}/cap.csv")
    if(NOT rc STREQUAL "0")
      message(FATAL_ERROR "8192 rows must be accepted: exit ${rc}: ${err}")
    endif()
    file(WRITE "${OUT}/over.csv" "${header}${rows}fixture/r999999,t,sms,export,ntsc,sega,boots@20,unknown,-,2026-10-20\n")
    common(normalize "${OUT}/over.csv")
    if(NOT rc STREQUAL "2" OR NOT err MATCHES "invalid ledger record")
      message(FATAL_ERROR "8193 rows must be refused with exit 2: exit ${rc}")
    endif()
    # Every active markdown character is written as a numeric entity exactly once: a title is data, never a link or emphasis.
    # The page cuts a title at 64 bytes after escaping, so the active characters ride in three rows that each fit.
    set(tail "sms,export,ntsc,sega,boots@20,pass,-,2026-10-20")
    file(WRITE "${OUT}/md.csv" "${header}fixture/a,a#b [x](y) `t`,${tail}\nfixture/b,~~s~~ *b*,${tail}\nfixture/c,_i_ ! \\ & < > |,${tail}\n")
    common(docs "${OUT}/md.csv")
    set(found 0)
    foreach(want IN ITEMS "| fixture/a | a&#35;b &#91;x&#93;&#40;y&#41; &#96;t&#96; | sms/" "| fixture/b | &#126;&#126;s&#126;&#126; &#42;b&#42; | sms/"
        "| fixture/c | &#95;i&#95; &#33; &#92; &amp; &lt; &gt; &#124; | sms/")
      string(FIND "${text}" "${want}" at)
      if(at LESS 0)
        set(found 1)
      endif()
    endforeach()
    if(NOT rc STREQUAL "0" OR found OR text MATCHES "&amp;#")
      message(FATAL_ERROR "the page must escape every active character once: exit ${rc}: ${text}${err}")
    endif()
    common(normalize "${ROOT}/tests/compat/ledger.csv")
    if(NOT rc STREQUAL "0")
      message(FATAL_ERROR "the committed ledger must be accepted: exit ${rc}: ${err}")
    endif()
    string(REGEX MATCHALL "\n" lines "${text}")
    list(LENGTH lines live)
    math(EXPR live "${live}-1")
    message(STATUS "compat.hardening: live rows ${live} of 8192")
    return()
  elseif(CASE MATCHES "^device_(key|rejected)$")
    set(header "id,title,machine,region,mapper,predicate,status,evidence,date\n")
    set(empty "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    function(device_row ports out)
      set(${out} "fixture/a,title,sms,ntsc-u,sega,cfg:video=sms;${ports};script=none;sha256=${empty}/boots@20,unknown,-,2026-10-20\n" PARENT_SCOPE)
    endfunction()
    function(device_normalize body)
      file(WRITE "${OUT}/device.csv" "${header}${body}")
      common(normalize "${OUT}/device.csv")
      set(rc "${rc}" PARENT_SCOPE)
      set(text "${text}" PARENT_SCOPE)
      set(err "${err}" PARENT_SCOPE)
    endfunction()
    if(CASE STREQUAL "device_key")
      set(body "")
      foreach(one IN ITEMS pad none paddle sports lphaser)
        foreach(two IN ITEMS pad none paddle sports lphaser)
          device_row("port1=${one};port2=${two}" row)
          string(APPEND body "${row}")
        endforeach()
      endforeach()
      device_normalize("${body}")
      if(NOT rc STREQUAL "0" OR NOT text MATCHES "port1=sports;port2=paddle;script=none" OR NOT text MATCHES "port1=paddle;port2=sports;script=none")
        message(FATAL_ERROR "rows naming each device pair must normalize as separate keys: exit ${rc}: ${text}${err}")
      endif()
      common(cases "${OUT}/device.csv")
      if(NOT rc STREQUAL "0" OR NOT text MATCHES "port1=sports;port2=paddle;script=none")
        message(FATAL_ERROR "device tokens must reach the case configuration: exit ${rc}: ${text}${err}")
      endif()
      device_row("port1=sports;port2=paddle" row)
      device_normalize("${body}${row}")
      if(NOT rc STREQUAL "2" OR NOT err MATCHES "invalid ledger record")
        message(FATAL_ERROR "the same device pair twice must be a duplicate key: exit ${rc}")
      endif()
      # fm is part of the key: an explicit on and an explicit off are two rows, an explicit default is the omitted row.
      set(header2 "id,title,machine,region,tv,mapper,predicate,status,evidence,date\n")
      set(fm_rows "")
      foreach(fm IN ITEMS on off)
        string(APPEND fm_rows "fixture/a,title,sms,export,ntsc,sega,cfg:video=sms;fm=${fm};port1=pad;port2=pad;script=none;sha256=${empty}/boots@20,unknown,-,2026-10-20\n")
      endforeach()
      file(WRITE "${OUT}/fm.csv" "${header2}${fm_rows}")
      common(normalize "${OUT}/fm.csv")
      if(NOT rc STREQUAL "0" OR NOT text MATCHES ";fm=off;" OR NOT text MATCHES ";fm=on;")
        message(FATAL_ERROR "rows differing only in fm must be separate keys: exit ${rc}: ${text}${err}")
      endif()
      file(WRITE "${OUT}/fm.csv" "${header2}${fm_rows}fixture/a,title,sms,export,ntsc,sega,boots@20,unknown,-,2026-10-20\n")
      common(normalize "${OUT}/fm.csv")
      if(NOT rc STREQUAL "2" OR NOT err MATCHES "invalid ledger record")
        message(FATAL_ERROR "an omitted fm equal to the explicit default must be a duplicate key: exit ${rc}")
      endif()
      message(STATUS "device pairs and fm settings are distinct keys")
      return()
    endif()
    set(refused 0)
    foreach(token IN ITEMS auto phaser lightgun)
      foreach(ports IN ITEMS "port1=${token}|port2=pad" "port1=pad|port2=${token}")
        string(REPLACE "|" ";" ports "${ports}")
        device_row("${ports}" row)
        device_normalize("${row}")
        if(rc STREQUAL "0")
          message(FATAL_ERROR "accepted the device token ${token}")
        elseif(NOT rc STREQUAL "2" OR NOT err MATCHES "invalid ledger record")
          message(FATAL_ERROR "device token ${token} failed some other way: exit ${rc}: ${err}")
        endif()
        math(EXPR refused "${refused}+1")
      endforeach()
    endforeach()
    # An fm token the grammar does not name; the format 2 header, so no refusal can come from the header.
    foreach(token IN ITEMS auto ON 1 "")
      file(WRITE "${OUT}/fm.csv" "id,title,machine,region,tv,mapper,predicate,status,evidence,date\nfixture/a,title,sms,japan,ntsc,sega,cfg:video=sms;fm=${token};port1=pad;port2=pad;script=none;sha256=${empty}/boots@20,unknown,-,2026-10-20\n")
      common(normalize "${OUT}/fm.csv")
      if(NOT rc STREQUAL "2" OR NOT err MATCHES "invalid ledger record")
        message(FATAL_ERROR "fm token '${token}' was not refused with exit 2: exit ${rc}: ${text}${err}")
      endif()
      math(EXPR refused "${refused}+1")
    endforeach()
    message(FATAL_ERROR "device tokens refused: ${refused}")
  endif()
  set(header "id,title,machine,region,mapper,predicate,status,evidence,date\n")
  set(row "fixture/a,\"A, \"\"quoted\"\"; title\",sms,ntsc-u,sega,boots@20,unknown,-,2026-10-20\n")
  file(WRITE "${OUT}/quoted.csv" "${header}${row}")
  common(normalize "${OUT}/quoted.csv")
  if(NOT rc STREQUAL "0" OR NOT text MATCHES "\"fixture/a\",\"A, \"\"quoted\"\"; title\"")
    message(FATAL_ERROR "accepted quoted CSV must normalize nine fields without changing title: exit ${rc}, ${text}${err}")
  endif()
  file(WRITE "${OUT}/normalized.csv" "${text}")
  common(normalize "${OUT}/normalized.csv")
  file(READ "${OUT}/normalized.csv" want)
  if(NOT rc STREQUAL "0" OR NOT text STREQUAL want)
    message(FATAL_ERROR "quoted CSV must round-trip idempotently")
  endif()
  string(ASCII 13 cr)
  string(REPLACE "\n" "${cr}\n" crlf "${header}${row}")
  file(WRITE "${OUT}/crlf.csv" "${crlf}")
  common(normalize "${OUT}/crlf.csv")
  if(NOT rc STREQUAL "0" OR NOT text STREQUAL want)
    message(FATAL_ERROR "CRLF CSV must preserve the same logical fields")
  endif()
  function(reject body)
    file(WRITE "${OUT}/invalid.csv" "${body}")
    common(normalize "${OUT}/invalid.csv")
    if(NOT rc STREQUAL "2" OR NOT err MATCHES "invalid ledger record")
      message(FATAL_ERROR "malformed CSV must reject with exit 2: ${rc}, ${text}${err}")
    endif()
  endfunction()
  reject("")
  reject("${header}\n")
  reject("${header}${row}${row}")
  string(REPLACE "boots@20" "boots@00020" alias "${row}")
  reject("${header}${row}${alias}")
  string(REPEAT x 4194305 large)
  file(WRITE "${OUT}/large.csv" "${large}")
  common(normalize "${OUT}/large.csv")
  if(NOT rc STREQUAL "2" OR NOT err MATCHES "invalid ledger input")
    message(FATAL_ERROR "ledger byte cap must reject before parsing")
  endif()
  foreach(body IN ITEMS "fixture/a,\"unclosed,sms,ntsc-u,sega,boots@20,unknown,-,2026-10-20\n"
      "fixture/a,\"closed\"x,sms,ntsc-u,sega,boots@20,unknown,-,2026-10-20\n"
      "fixture/a,bad\"quote,sms,ntsc-u,sega,boots@20,unknown,-,2026-10-20\n"
      "fixture/a,title,sms,ntsc-u,sega,boots@20,unknown,-\n"
      "fixture/a,title,sms,ntsc-u,sega,boots@20,unknown,-,2026-10-20,extra\n"
      "fixture/a,,sms,ntsc-u,sega,boots@20,unknown,-,2026-10-20\n")
    reject("${header}${body}")
  endforeach()
  string(REPEAT x 4097 long)
  reject("${header}${long}\n")
  string(REPEAT x 1025 long)
  reject("${header}fixture/a,${long},sms,ntsc-u,sega,boots@20,unknown,-,2026-10-20\n")
  file(WRITE "${OUT}/empty.csv" "${header}")
  common(docs "${OUT}/empty.csv")
  if(NOT rc STREQUAL "0" OR NOT text MATCHES "Rows: 0. Evaluated coverage: 0. Own fixtures: 0.")
    message(FATAL_ERROR "header-only ledger must report explicit zero coverage")
  endif()
  set(ordered "${header}")
  set(reversed "")
  foreach(status IN ITEMS pass fail unknown unsupported infrastructure_error skipped)
    set(evidence -)
    if(status MATCHES "^(unsupported|skipped)$")
      set(evidence reason=janggun)
    endif()
    set(next "fixture/${status},title,sms,ntsc-u,sega,boots@20,${status},${evidence},2026-10-20\n")
    string(APPEND ordered "${next}")
    string(PREPEND reversed "${next}")
  endforeach()
  file(WRITE "${OUT}/ordered.csv" "${ordered}")
  file(WRITE "${OUT}/reversed.csv" "${header}${reversed}")
  foreach(mode IN ITEMS normalize docs cases)
    common(${mode} "${OUT}/ordered.csv")
    set(want "${text}")
    if(NOT rc STREQUAL "0")
      message(FATAL_ERROR "valid status/control cases failed")
    endif()
    common(${mode} "${OUT}/reversed.csv")
    if(NOT rc STREQUAL "0" OR NOT text STREQUAL want)
      message(FATAL_ERROR "row permutation changes normalized ${mode}")
    endif()
    if(mode STREQUAL "docs" AND NOT text MATCHES "Evaluated coverage: 2")
      message(FATAL_ERROR "unknown/unsupported/infrastructure must not count as evaluated")
    endif()
  endforeach()
  string(REPLACE "boots@20" "ram@00020:$c200=0a" alias "${row}")
  string(REPLACE "boots@20" "ram@20:$C200=FF" second "${row}")
  reject("${header}${alias}${second}")
  string(REPLACE "ntsc-u" "any" alias "${row}")
  reject("${header}${row}${alias}")
  # audio is a frame-like digest on an owned fixture with no script; every other form is refused.
  string(REPEAT a 64 digest)
  string(REPLACE "boots@20" "audio@600=${digest}" audio "${row}")
  file(WRITE "${OUT}/audio.csv" "${header}${audio}")
  common(normalize "${OUT}/audio.csv")
  if(NOT rc STREQUAL "0" OR NOT text MATCHES "/audio@600=${digest}\"")
    message(FATAL_ERROR "audio with a 64 digit hash on a fixture must normalize and keep its value: exit ${rc}: ${text}${err}")
  endif()
  string(REPEAT a 63 short)
  string(REPEAT a 65 long)
  string(REPEAT A 64 upper)
  foreach(predicate IN ITEMS "audio@600" "audio@600=${short}" "audio@600=${long}" "audio@600=${upper}"
      "audio@0=${digest}" "audio@1000001=${digest}" "audio@600:$C200=00")
    string(REPLACE "boots@20" "${predicate}" bad "${row}")
    reject("${header}${bad}")
  endforeach()
  string(REPLACE "fixture/a,\"A, \"\"quoted\"\"; title\",sms" "00cfce623709b8d9bc9e6bbb96feb9faf9a81f84,t,sms" bad "${audio}")
  reject("${header}${bad}")
  string(REPLACE "boots@20" "cfg:video=sms;port1=pad;port2=pad;script=input.txt;sha256=${digest}/audio@600=${digest}" bad "${row}")
  reject("${header}${bad}")
  # A catalog title carries boots predicates only: a digest, a RAM byte or a mailbox on one is refused, and the
  # same row with boots is the control that the id alone is not what is refused.
  set(catalog_id "fixture/a,\"A, \"\"quoted\"\"; title\",sms")
  foreach(predicate IN ITEMS "boots@20" "frame@20=${digest}" "ram@20:$C200=0A" "mailbox@20")
    string(REPLACE "boots@20" "${predicate}" bad "${row}")
    string(REPLACE "${catalog_id}" "00cfce623709b8d9bc9e6bbb96feb9faf9a81f84,t,sms" bad "${bad}")
    if(predicate STREQUAL "boots@20")
      file(WRITE "${OUT}/catalog.csv" "${header}${bad}")
      common(normalize "${OUT}/catalog.csv")
      if(NOT rc STREQUAL "0")
        message(FATAL_ERROR "a boots row for a catalog title must normalize: exit ${rc}: ${err}")
      endif()
    else()
      reject("${header}${bad}")
    endif()
  endforeach()
  # The page escapes < > & and | in a title the same way on every awk: the replacement text of gsub reads a lone
  # backslash differently in each, so a bare "\&lt;" printed "<lt;" on the macOS and gawk builds.
  string(REPLACE "A, \"\"quoted\"\"; title" "A<B>&|C" bad "${row}")
  file(WRITE "${OUT}/escape.csv" "${header}${bad}")
  common(docs "${OUT}/escape.csv")
  string(FIND "${text}" "| A&lt;B&gt;&amp;&#124;C |" at)
  if(NOT rc STREQUAL "0" OR at LESS 0)
    message(FATAL_ERROR "the page must escape < > & and | in a title: exit ${rc}: ${text}${err}")
  endif()
  string(REPLACE "fixture/a," "built/a," bad "${row}")
  reject("${header}${bad}")
  # Fault prevented: an unsupported or skipped row that names no reason, or free text instead of a listed token, entering the
  # ledger in any mode; a pass row refused for its evidence; a ledger without those statuses that reads the reasons file.
  foreach(status IN ITEMS unsupported skipped)
    string(REPLACE ",unknown,-," ",${status},reason=janggun," good "${row}")
    file(WRITE "${OUT}/reason.csv" "${header}${good}")
    foreach(mode IN ITEMS normalize docs cases)
      common(${mode} "${OUT}/reason.csv")
      if(NOT rc STREQUAL "0")
        message(FATAL_ERROR "a ${status} row with a listed reason must parse in ${mode}: ${err}")
      endif()
    endforeach()
    foreach(evidence IN ITEMS janggun reason= reason=Janggun reason=unlisted_token "reason=jang gun" Reason=janggun "")
      string(REPLACE ",unknown,-," ",${status},${evidence}," bad "${row}")
      reject("${header}${bad}")
    endforeach()
  endforeach()
  string(REPLACE ",unknown,-," ",pass,any free text at all," free "${row}")
  file(WRITE "${OUT}/free.csv" "${header}${free}")
  set(ENV{COMPAT_REASONS} "${OUT}/no-such-reasons.txt")
  common(normalize "${OUT}/free.csv")
  set(ENV{COMPAT_REASONS} "${ROOT}/tests/compat/reasons.txt")
  if(NOT rc STREQUAL "0")
    message(FATAL_ERROR "a ledger with no unsupported or skipped row must never read the reasons file: ${err}")
  endif()
  message(STATUS "quoted CSV bounds, duplicate aliases, ordering, audio forms and zero coverage passed")
  return()
endif()
