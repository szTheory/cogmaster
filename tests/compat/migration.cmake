# The preserved facts of a ledger in either format: id, machine, mapper, predicate without its cfg prefix,
# status, evidence, date. Semicolons become text first so a cfg cannot split a CMake list.
function(facts text out)
  string(REPLACE ";" "@@" text "${text}")
  string(REGEX MATCHALL "[^\n]+" lines "${text}")
  list(POP_FRONT lines header)
  set(shift 0)
  if(header MATCHES "^id,title,machine,region,tv,")
    set(shift 1)
  endif()
  set(tuples "")
  foreach(line IN LISTS lines)
    set(fields "")
    set(rest "${line}")
    while(NOT rest STREQUAL "")
      string(REGEX MATCH "^(\"([^\"]|\"\")*\"|[^,\"]*)(,(.*))?$" unused "${rest}")
      set(field "${CMAKE_MATCH_1}")
      set(rest "${CMAKE_MATCH_4}")
      if(field MATCHES "^\"(.*)\"$")
        set(field "${CMAKE_MATCH_1}")
        string(REPLACE "\"\"" "\"" field "${field}")
      endif()
      list(APPEND fields "${field}")
    endwhile()
    math(EXPR mapper "4+${shift}")
    math(EXPR predicate "5+${shift}")
    math(EXPR status "6+${shift}")
    math(EXPR evidence "7+${shift}")
    math(EXPR date "8+${shift}")
    list(GET fields 0 id)
    list(GET fields 2 machine)
    list(GET fields ${mapper} mapper_name)
    list(GET fields ${predicate} predicate_text)
    string(REGEX REPLACE "^cfg:[^/]*/" "" predicate_text "${predicate_text}")
    list(GET fields ${status} status_name)
    list(GET fields ${evidence} evidence_text)
    list(GET fields ${date} date_text)
    list(APPEND tuples "${id}|${machine}|${mapper_name}|${predicate_text}|${status_name}|${evidence_text}|${date_text}")
  endforeach()
  list(SORT tuples)
  set(${out} "${tuples}" PARENT_SCOPE)
endfunction()

set(controls 0)
function(refuse label content)
  common(normalize "${content}")
  if(NOT rc STREQUAL "2" OR NOT err MATCHES "invalid ledger record")
    message(FATAL_ERROR "${label}: must exit 2 with 'invalid ledger record', got exit ${rc}: ${text}${err}")
  endif()
  math(EXPR n "${controls}+1")
  set(controls "${n}" PARENT_SCOPE)
endfunction()

# Positive: the released ledger reads as format 1, prints as format 2, and format 2 is a fixed point.
common(normalize "${v1_ledger}")
if(NOT rc STREQUAL "0" OR NOT text STREQUAL "${v2_ledger}")
  message(FATAL_ERROR "normalize of the released ledger differs from its format 2 form: exit ${rc}\n${text}${err}")
endif()
common(normalize "${v2_ledger}")
if(NOT rc STREQUAL "0" OR NOT text STREQUAL "${v2_ledger}")
  message(FATAL_ERROR "normalize of format 2 must reproduce it byte for byte: exit ${rc}\n${text}${err}")
endif()
facts("${v1_ledger}" before)
facts("${v2_ledger}" after)
list(LENGTH before rows)
if(NOT rows EQUAL 5 OR NOT before STREQUAL after)
  message(FATAL_ERROR "migration moved a preserved fact: ${before} against ${after}")
endif()
# Preservation controls: one status flipped, one row dropped. Each must make the multiset check differ.
string(REPLACE "\"unknown\"" "\"pass\"" flipped "${v2_ledger}")
string(REGEX REPLACE "\n\"fixture/vdp_lines_192\"[^\n]*" "" dropped "${v2_ledger}")
foreach(changed IN ITEMS flipped dropped)
  facts("${${changed}}" damaged)
  if(before STREQUAL damaged)
    message(FATAL_ERROR "multiset check cannot see the ${changed} change")
  endif()
  math(EXPR controls "${controls}+1")
endforeach()

# Every legacy token under the old header. ntsc-j gives japan and, only for a Master System, fm on.
function(legacy id title machine region predicate)
  string(APPEND legacy_rows "${id},${title},${machine},${region},sega,${predicate},unknown,-,2026-10-20\n")
  set(legacy_rows "${legacy_rows}" PARENT_SCOPE)
endfunction()
function(expect label id title machine region tv video fm ports)
  set(line "\"${id}\",${title},\"${machine}\",\"${region}\",\"${tv}\",\"sega\",\"cfg:video=${video};fm=${fm};${ports};script=none;sha256=${empty}/boots@20\",\"unknown\",\"-\",\"2026-10-20\"\n")
  string(FIND "${text}" "${line}" at)
  if(at LESS 0)
    message(FATAL_ERROR "legacy row ${id}: ${label}; expected ${line}in:\n${text}")
  endif()
endfunction()
