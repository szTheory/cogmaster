function(common mode content)
  file(WRITE "${OUT}/in.csv" "${content}")
  execute_process(COMMAND sh "${ROOT}/scripts/compat-common.sh" "${mode}" "${OUT}/in.csv"
    RESULT_VARIABLE rc OUTPUT_VARIABLE text ERROR_VARIABLE err)
  string(REPLACE "\r\n" "\n" text "${text}")
  set(rc "${rc}" PARENT_SCOPE)
  set(text "${text}" PARENT_SCOPE)
  set(err "${err}" PARENT_SCOPE)
endfunction()

