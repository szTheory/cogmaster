# Fault prevented: local records publish private strings or promote an observed output into a golden.
if(CMAKE_SCRIPT_MODE_FILE)
  file(MAKE_DIRECTORY "${OUT}")
  # The parser reads its closed reasons and its catalog by absolute path, so no call depends on the working directory.
  set(ENV{COMPAT_REASONS} "${ROOT}/tests/compat/reasons.txt")
  set(header1 "id,title,machine,region,mapper,predicate,status,evidence,date\n")
  set(header "id,title,machine,region,tv,mapper,predicate,status,evidence,date\n")
  set(id 00cfce623709b8d9bc9e6bbb96feb9faf9a81f84)
  # Fault prevented: a test whose cost grows with the rows of the ledger (every call below parses it) and a stand-in that is only a
  # copy of the live ledger. The stand-in keeps the header, the own fixtures and the one catalog row, whatever else the ledger holds.
  file(STRINGS "${ROOT}/tests/compat/ledger.csv" standin_rows REGEX "^(id,|\"fixture/|\"${id}\")")
  set(standin "")
  foreach(line IN LISTS standin_rows)
    string(APPEND standin "${line}\n")
  endforeach()
  file(WRITE "${OUT}/standin.csv" "${standin}")
  set(ENV{COMPAT_LEDGER} "${OUT}/standin.csv")
  set(ENV{COMPAT_CATALOG} "${ROOT}/tests/compat/catalog.tsv")
  # The legacy format 1 candidate is still read; the output is format 2.
  file(WRITE "${OUT}/input.csv" "${header1}${id},private-label,gg,ntsc-u,sega,boots@600,pass,private-trace,2026-10-20\n")
  execute_process(COMMAND sh "${ROOT}/scripts/compat-update.sh" "${OUT}/input.csv"
    RESULT_VARIABLE rc OUTPUT_VARIABLE text ERROR_VARIABLE err)
  if(NOT rc STREQUAL "0" OR NOT text MATCHES "Crazy Faces.*prototype.*pass")
    message(FATAL_ERROR "explicit accepted public case must update with its immutable CC0 title")
  endif()
  if(text MATCHES "private-label|private-trace" OR NOT text MATCHES "core=[0-9a-f]+")
    message(FATAL_ERROR "public update leaked local label or evidence")
  endif()
  file(WRITE "${OUT}/output.csv" "${text}")
  execute_process(COMMAND sh "${ROOT}/scripts/compat-common.sh" normalize "${OUT}/output.csv"
    RESULT_VARIABLE rc OUTPUT_VARIABLE normalized ERROR_VARIABLE err)
  if(NOT rc STREQUAL "0" OR NOT normalized STREQUAL text)
    message(FATAL_ERROR "public update must round-trip quoted CC0 title")
  endif()
  function(update body)
    set(head "${header}")
    if(ARGC GREATER 1)
      set(head "${ARGV1}")
    endif()
    file(WRITE "${OUT}/input.csv" "${head}${body}")
    execute_process(COMMAND sh "${ROOT}/scripts/compat-update.sh" "${OUT}/input.csv"
      RESULT_VARIABLE rc OUTPUT_VARIABLE text ERROR_VARIABLE err)
    set(rc "${rc}" PARENT_SCOPE)
    set(text "${text}" PARENT_SCOPE)
    set(err "${err}" PARENT_SCOPE)
  endfunction()
  execute_process(COMMAND sh "${ROOT}/scripts/compat-common.sh" normalize "${OUT}/standin.csv"
    RESULT_VARIABLE rc OUTPUT_VARIABLE baseline COMMAND_ERROR_IS_FATAL ANY)
  string(REPEAT a 40 unknown)
  string(REPEAT b 64 observed)
  set(hostile "${unknown},private-name,sms,export,ntsc,sega,boots@20,pass,private-screenshot,2026-10-20\n")
  string(APPEND hostile "fixture/boot_to_play,private-path,sms,export,ntsc,none,mailbox@20,fail,private-save,2026-10-20\n")
  string(APPEND hostile "${id},private-label,gg,export,ntsc,sega,frame@600=${observed},pass,private-RAM,2026-10-20\n")
  update("${hostile}")
  if(NOT rc STREQUAL "0" OR NOT text STREQUAL baseline)
    message(FATAL_ERROR "unknown, own fixture and new golden must leave public baseline intact")
  endif()
  # A profile the core refuses by hardware fact cannot be a row: exit 2 with nothing printed, never a quiet drop.
  set(empty e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855)
  update("${id},private-label,gg,pal,sega,boots@600,pass,private-trace,2026-10-20\n" "${header1}")
  set(impossible "${rc}|${text}")
  update("${id},private-label,gg,export,pal,sega,boots@600,pass,private-trace,2026-10-20\n")
  list(APPEND impossible "${rc}|${text}")
  update("${id},private-label,sms,japan,pal,sega,boots@600,pass,private-trace,2026-10-20\n")
  list(APPEND impossible "${rc}|${text}")
  update("${id},private-label,gg,export,ntsc,sega,cfg:video=gg;fm=on;port1=pad;port2=pad;script=none;sha256=${empty}/boots@600,pass,private-trace,2026-10-20\n")
  list(APPEND impossible "${rc}|${text}")
  update("${id},private-label,gg,export,ntsc,sega,audio@300=${observed},pass,private-trace,2026-10-20\n")
  list(APPEND impossible "${rc}|${text}")
  foreach(outcome IN LISTS impossible)
    if(NOT outcome STREQUAL "2|")
      message(FATAL_ERROR "an impossible profile must exit 2 with empty standard output: ${outcome}")
    endif()
  endforeach()
  # Fault prevented: a candidate adding rows by frame, device or profile for a catalog id, growing the page past its cap or smuggling a golden into the ledger.
  execute_process(COMMAND git -C "${ROOT}" rev-parse HEAD OUTPUT_VARIABLE rev OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  set(sms_id 0199c62afb5c09f09999a4815079875b480129f3)
  set(gg_id 006ce9972fd532abb1b426de2bf02e75dd616bba)
  function(catalog_row cid)
    file(STRINGS "${ROOT}/tests/compat/catalog.tsv" found REGEX "^${cid}\t")
    list(LENGTH found n)
    if(NOT n EQUAL 1)
      message(FATAL_ERROR "catalog identity ${cid} missing")
    endif()
    string(REPLACE "\t" ";" found "${found}")
    list(GET found 1 machine)
    list(GET found 2 mapper)
    list(GET found 4 title)
    set(cat_machine "${machine}" PARENT_SCOPE)
    set(cat_mapper "${mapper}" PARENT_SCOPE)
    set(cat_title "${title}" PARENT_SCOPE)
  endfunction()
  function(config video fm port1 predicate)
    set(config "cfg:video=${video};fm=${fm};port1=${port1};port2=pad;script=none;sha256=${empty}/${predicate}" PARENT_SCOPE)
  endfunction()
  # A candidate row and the row the update must print for it.
  function(candidate cid machine region tv mapper cfg status)
    set(row "${cid},private-label,${machine},${region},${tv},${mapper},${cfg},${status},private-trace,2026-10-20\n" PARENT_SCOPE)
    catalog_row("${cid}")
    set(expected "\"${cid}\",\"${cat_title}\",\"${machine}\",\"${region}\",\"${tv}\",\"${mapper}\",\"${cfg}\",\"${status}\",\"core=${rev}\",\"2026-10-20\"\n" PARENT_SCOPE)
  endfunction()
  set(adopted_rows "")
  set(adopted_reversed "")
  set(adopted_count 0)
  foreach(case IN ITEMS "${sms_id}|sms|export|ntsc|off|pass" "${sms_id}|sms|export|pal|off|fail" "${sms_id}|sms|japan|ntsc|on|pass"
      "${gg_id}|gg|export|ntsc|off|pass" "${id}|gg|japan|ntsc|off|fail")
    string(REPLACE "|" ";" f "${case}")
    list(GET f 0 cid)
    list(GET f 1 machine)
    list(GET f 2 region)
    list(GET f 3 tv)
    list(GET f 4 fm)
    list(GET f 5 status)
    catalog_row("${cid}")
    config("${machine}" "${fm}" pad boots@600)
    candidate("${cid}" "${machine}" "${region}" "${tv}" "${cat_mapper}" "${config}" "${status}")
    update("${row}")
    string(REPLACE "${expected}" "" without "${text}")
    if(NOT rc STREQUAL "0" OR NOT without STREQUAL baseline OR "${without}" STREQUAL "${text}")
      message(FATAL_ERROR "a whitelisted boots row must be adopted with its catalog title: ${machine} ${region} ${tv} fm=${fm}")
    endif()
    string(APPEND adopted_rows "${row}")
    set(adopted_reversed "${row}${adopted_reversed}")
    math(EXPR adopted_count "${adopted_count}+1")
    set(adopted_expected_${adopted_count} "${expected}")
  endforeach()
  # All five together, in either order, give the baseline plus exactly those rows and the same bytes.
  update("${adopted_rows}")
  set(forward "${text}")
  foreach(n RANGE 1 ${adopted_count})
    string(REPLACE "${adopted_expected_${n}}" "" text "${text}")
  endforeach()
  if(NOT rc STREQUAL "0" OR NOT text STREQUAL baseline)
    message(FATAL_ERROR "the output must equal the baseline plus exactly the adopted rows")
  endif()
  update("${adopted_reversed}")
  if(NOT rc STREQUAL "0" OR NOT text STREQUAL forward)
    message(FATAL_ERROR "adopted rows must come out key sorted whatever the candidate order")
  endif()
  file(WRITE "${OUT}/adopted.csv" "${forward}")
  execute_process(COMMAND sh "${ROOT}/scripts/compat-common.sh" normalize "${OUT}/adopted.csv"
    RESULT_VARIABLE rc OUTPUT_VARIABLE again)
  if(NOT rc STREQUAL "0" OR NOT again STREQUAL forward)
    message(FATAL_ERROR "the adopted output must be a normalized ledger")
  endif()
  # Every one of these is discarded and leaves the baseline intact, alone and together.
  set(mismatch "")
  set(discards 0)
  function(discard row)
    update("${row}")
    if(NOT rc STREQUAL "0" OR NOT text STREQUAL baseline)
      message(FATAL_ERROR "a candidate outside the judge's profiles must leave the baseline intact: ${row}")
    endif()
    set(mismatch "${mismatch}${row}" PARENT_SCOPE)
    math(EXPR discards "${discards}+1")
    set(discards "${discards}" PARENT_SCOPE)
  endfunction()
  config(sms off pad boots@600)
  set(plain "${config}")
  config(gg off pad boots@600)
  set(gg_plain "${config}")
  config(sms off sports boots@600)
  set(sports "${config}")
  config(sms on pad boots@599)
  set(early "${config}")
  config(sms on pad boots@600)
  set(fm_on "${config}")
  discard("${sms_id},p,sms,export,ntsc,sega,frame@600=${observed},pass,-,2026-10-20\n")
  discard("${sms_id},p,sms,export,ntsc,sega,ram@600:$C200=00,pass,-,2026-10-20\n")
  discard("${sms_id},p,sms,export,ntsc,sega,mailbox@600,pass,-,2026-10-20\n")
  discard("${sms_id},p,sms,export,ntsc,sega,boots@599,pass,-,2026-10-20\n")
  discard("${sms_id},p,sms,export,ntsc,sega,boots@601,pass,-,2026-10-20\n")
  discard("${sms_id},p,sms,export,ntsc,sega,${early},pass,-,2026-10-20\n")
  discard("${sms_id},p,sms,export,ntsc,sega,${sports},pass,-,2026-10-20\n")
  discard("${sms_id},p,sms,export,ntsc,sega,${fm_on},pass,-,2026-10-20\n")
  discard("${sms_id},p,sms,japan,ntsc,sega,${plain},pass,-,2026-10-20\n")
  discard("${sms_id},p,gg,export,ntsc,sega,${gg_plain},pass,-,2026-10-20\n")
  discard("${sms_id},p,sms,export,ntsc,none,${plain},pass,-,2026-10-20\n")
  discard("${gg_id},p,gg,export,ntsc,none,${gg_plain},pass,-,2026-10-20\n")
  discard("${gg_id},p,sms,export,ntsc,sega,${plain},pass,-,2026-10-20\n")
  discard("${unknown},p,sms,export,ntsc,sega,${plain},pass,-,2026-10-20\n")
  discard("fixture/vdp_lines_192,p,sms,export,pal,none,${plain},pass,-,2026-10-20\n")
  update("${mismatch}")
  if(NOT rc STREQUAL "0" OR NOT text STREQUAL baseline OR NOT discards EQUAL 15)
    message(FATAL_ERROR "all discarded rows together must leave the baseline intact: ${discards}")
  endif()
  # Nothing judges a built image's row, so its id is not a name a row may take: the whole candidate is refused.
  update("built/vdp_lines_192,p,sms,export,pal,none,${plain},pass,-,2026-10-20\n")
  if(NOT rc STREQUAL "2")
    message(FATAL_ERROR "a built/ id must be refused: exit ${rc}")
  endif()
  foreach(status IN ITEMS unknown unsupported infrastructure_error skipped)
    set(evidence -)
    if(status MATCHES "^(unsupported|skipped)$")
      set(evidence reason=janggun)
    endif()
    update("${sms_id},p,sms,export,ntsc,sega,${plain},${status},${evidence},2026-10-20\n")
    if(NOT rc STREQUAL "0" OR NOT text STREQUAL baseline)
      message(FATAL_ERROR "only pass and fail may be adopted for a new key: ${status}")
    endif()
  endforeach()
  foreach(status IN ITEMS pass fail unknown unsupported infrastructure_error skipped)
    set(evidence private-trace)
    if(status MATCHES "^(unsupported|skipped)$")
      set(evidence reason=janggun)
    endif()
    set(public "${id},private-label,gg,export,ntsc,sega,boots@600,${status},${evidence},2026-10-20\n")
    update("${hostile}${public}")
    set(first "${text}")
    if(NOT rc STREQUAL "0" OR NOT text MATCHES "\"${status}\",\"core=[0-9a-f]+\",\"2026-10-20\"" OR text MATCHES "private-|${unknown}|${observed}")
      message(FATAL_ERROR "public filter must preserve status and discard every private field")
    endif()
    update("${public}${hostile}")
    if(NOT rc STREQUAL "0" OR NOT text STREQUAL first)
      message(FATAL_ERROR "public update permutation must be stable")
    endif()
  endforeach()
  foreach(body IN ITEMS "${id},title,gg,export,ntsc,sega,boots@600,pass,-,2026-02-30\n"
      "${id},title,gg,export,ntsc,sega,boots@600,pass,-,2026-10-20,private-screen\n")
    update("${body}")
    if(NOT rc STREQUAL "2" OR text MATCHES "private-")
      message(FATAL_ERROR "invalid date or arbitrary columns must fail before public output")
    endif()
  endforeach()
  message(STATUS "public identity, quoted title, status, privacy and no-golden controls passed")
  return()
endif()
