# Fault prevented: passing cases disappear or change protected values under aliases.
file(MAKE_DIRECTORY "${OUT}")
set(header "id,title,machine,region,mapper,predicate,status,evidence,date\n")
set(row "fixture/a,title,sms,ntsc-u,sega,ram@20:$C200=0A,pass,-,2026-10-20\n")
file(WRITE "${OUT}/allow.txt" "")
set(base_rev 10)
set(head_rev 11)
function(judge name head want)
  file(WRITE "${OUT}/base.csv" "${header}${row}")
  file(WRITE "${OUT}/head.csv" "${header}${head}")
  set(rc unavailable)
  if(EXISTS "${ROOT}/scripts/compat-ratchet.sh")
    execute_process(COMMAND sh "${ROOT}/scripts/compat-ratchet.sh" "${OUT}/base.csv"
      "${OUT}/head.csv" "${OUT}/allow.txt" 2026-10-20 "${base_rev}" "${head_rev}"
      RESULT_VARIABLE rc OUTPUT_VARIABLE text ERROR_VARIABLE err)
  endif()
  if(NOT rc STREQUAL "${want}")
    message(FATAL_ERROR "${name}: expected exit ${want}, actual ${rc}: ${text}${err}")
  endif()
endfunction()
judge(unchanged "${row}" 0)
judge(deleted "" 2)
string(REPLACE "=0A" "=0B" altered "${row}")
judge(expectation "${altered}" 2)
string(REPLACE "ram@20:$C200=0A" "ram@00020:$c200=0a" alias "${row}")
judge(alias "${alias}" 0)
judge(duplicate "${row}${alias}" 2)
foreach(pair IN ITEMS "sms,ntsc-u|gg,ntsc-u" "ntsc-u|pal" "sega|none" "ram@20|ram@21" "$C200|$C201" "pass|fail" "pass|unknown" "pass|unsupported" "pass|infrastructure_error" "pass|skipped")
  string(REPLACE "|" ";" parts "${pair}")
  list(GET parts 0 before)
  list(GET parts 1 after)
  string(REPLACE "${before}" "${after}" changed "${row}")
  judge("protected ${pair}" "${changed}" 2)
endforeach()
string(REPLACE "ram@20" "ram@21" neighbor "${row}")
judge(adjacent_frame "${row}${neighbor}" 0)
string(REPLACE "$C200" "$C201" neighbor "${row}")
judge(adjacent_address "${row}${neighbor}" 0)
set(original "${row}")
string(REPEAT a 64 digest_a)
string(REPEAT b 64 digest_b)
set(config "cfg:video=sms;port1=pad;port2=pad;script=input.txt;sha256=${digest_a}/")
string(REPLACE "ram@20" "${config}ram@20" row "${original}")
string(REPLACE "${digest_a}" "${digest_b}" changed "${row}")
judge(same_path_changed_script_bytes "${changed}" 2)
string(REPLACE "port2=pad" "port2=none" changed "${row}")
judge(device_substitution "${changed}" 2)
string(REPLACE "video=sms" "video=gg" changed "${row}")
judge(video_substitution "${changed}" 2)
set(row "${original}")
foreach(expiry IN ITEMS 2026-10-19 2026-10-20 2026-12-19 2026-12-20 2026-02-30)
  file(WRITE "${OUT}/allow.txt" "2026-10-20 fixture/a ram@00020:$c200=0a corrected sourced model behaviour-rev=11 expires=${expiry}\n")
  set(want 2)
  if(expiry MATCHES "^(2026-10-20|2026-12-19)$")
    set(want 0)
  endif()
  judge("expiry ${expiry}" "${altered}" "${want}")
endforeach()
file(WRITE "${OUT}/allow.txt" "2026-10-20 fixture/a ram@20:$C200=0A sourced change behaviour-rev=11 expires=2026-10-20\n")
judge(exception_value "${altered}" 0)
judge(exception_delete "" 0)
string(REPLACE "sms" "gg" changed "${row}")
judge(exception_profile "${changed}" 0)
set(base_rev 11)
judge(no_actual_revision_bump "${altered}" 2)
set(base_rev 10)
set(head_rev 12)
judge(wrong_revision "${altered}" 2)
set(head_rev 11)
foreach(exception IN ITEMS
    "2026-10-21 fixture/a ram@20:$C200=0A future date behaviour-rev=11 expires=2026-12-01"
    "2026-10-20 fixture/b ram@20:$C200=0A unrelated ID behaviour-rev=11 expires=2026-12-01"
    "2026-10-20 fixture/a ram@21:$C200=0A unrelated frame behaviour-rev=11 expires=2026-12-01"
    "2026-10-20 fixture/a ram@20:$C200=0A behaviour-rev=11 expires=2026-12-01")
  file(WRITE "${OUT}/allow.txt" "${exception}\n")
  judge(unrelated_or_malformed_exception "${altered}" 2)
endforeach()
file(WRITE "${OUT}/allow.txt" "")
string(REPLACE "pass" "fail" row "${original}")
judge(fail_to_pass "${original}" 0)
string(REPLACE "pass" "unsupported" changed "${original}")
judge(illegal_fail_transition "${changed}" 2)
string(REPLACE "pass" "unknown" row "${original}")
judge(unknown_to_pass "${original}" 0)
