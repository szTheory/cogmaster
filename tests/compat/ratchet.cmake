function(judge name head want)
  set(base "${header}${row}")
  set(head_text "${header}${head}")
  if(DEFINED base_text)
    set(base "${base_text}")
  endif()
  if(DEFINED head_header)
    set(head_text "${head_header}${head}")
  endif()
  file(WRITE "${OUT}/base.csv" "${base}")
  file(WRITE "${OUT}/head.csv" "${head_text}")
  set(rc unavailable)
  if(EXISTS "${judge_root}/scripts/compat-ratchet.sh")
    execute_process(COMMAND sh "${judge_root}/scripts/compat-ratchet.sh" "${OUT}/base.csv"
      "${OUT}/head.csv" "${OUT}/allow.txt" 2026-10-20 "${base_rev}" "${head_rev}"
      ${results}
      RESULT_VARIABLE rc OUTPUT_VARIABLE text ERROR_VARIABLE err)
  endif()
  if(NOT rc STREQUAL "${want}")
    message(FATAL_ERROR "${name}: expected exit ${want}, actual ${rc}: ${text}${err}")
  endif()
endfunction()
