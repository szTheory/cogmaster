# The whole-list ledger from four sides: its counts against the pin, its statuses against the compiled slot table, its bytes
# against the seed that writes it, and its default profiles against the runner. The legs are in whole_list_common.cmake; the
# controls here run them in-process over small stand-ins, so the cost does not grow with the committed ledger.
# Fault prevented: a denominator that shrinks unnoticed, a status that moves without a slot-table change, a hand edit of the ledger,
# and a seeded profile the core refuses.
include("${CMAKE_CURRENT_LIST_DIR}/whole_list_common.cmake")
file(MAKE_DIRECTORY "${OUT}")
set(ledger "${ROOT}/tests/compat/ledger.csv")
set(catalog "${ROOT}/tests/compat/catalog.tsv")
set(counts "${ROOT}/tests/compat/pin-counts.txt")
set(ENV{COMPAT_REASONS} "${ROOT}/tests/compat/reasons.txt")
set(ENV{COMPAT_CATALOG} "${catalog}")

function(must_pass leg error)
  if(NOT error STREQUAL "")
    message(FATAL_ERROR "${leg}: ${error}")
  endif()
endfunction()

function(must_refuse leg error regex)
  if(error STREQUAL "")
    message(FATAL_ERROR "the ${leg} control was accepted")
  endif()
  if(NOT error MATCHES "${regex}")
    message(FATAL_ERROR "the ${leg} control was refused for another reason: ${error}")
  endif()
endfunction()

# Five synthetic identities, one of each kind, with the catalog, the pin counts, the compiled-table lines and the seed's ledger.
function(standin dir)
  file(MAKE_DIRECTORY "${dir}")
  foreach(n RANGE 1 7)
    string(REPEAT "${n}" 40 id${n})
    set(id${n} "${id${n}}" PARENT_SCOPE)
  endforeach()
  set(tail "export\tpad\tpad")
  file(WRITE "${dir}/catalog.tsv"
    "${id1}\tsms\tsega\t-\tOne\tunknown\t-\t${tail}\n"
    "${id2}\tgg\tnone\t-\tTwo\tunknown\t-\t${tail}\n"
    "${id3}\tsms\tunsupported\tgraphic\tThree\tunsupported\tgraphic\t${tail}\n"
    "${id4}\tsms\tcompound\tsms/four\tFour\tskipped\tmulti_chip\t${tail}\n"
    "${id5}\tgg\tsega\t-\tFive\tskipped\tmame_no\t${tail}\n"
    "${id6}\tsg\tsega\t-\tSix\texcluded\t-\t${tail}\n"
    "${id7}\tsg\tcompound\tsg1000/seven\tSeven\texcluded\t-\t${tail}\n")
  file(WRITE "${dir}/counts.txt"
    "entries_sms 3\nentries_gg 2\nentries_sg 2\nmerged_sms_gg 0\nmerged_sg 0\ncompound_sms_gg 1\ncompound_sg 1\nmame_no 1\n")
  file(WRITE "${dir}/empty.csv" "id,title,machine,region,tv,mapper,predicate,status,evidence,date\n")
  # Table lines in the form of src/cartdb.inc: the 20 SHA-1 bytes, then the board and machine numbers.
  set(table "")
  foreach(row IN ITEMS "1|2|1" "2|1|2" "3|0|1" "5|2|2")
    string(REPLACE "|" ";" parts "${row}")
    list(GET parts 0 n)
    list(GET parts 1 board)
    list(GET parts 2 machine)
    string(REPEAT "0x${n}${n}," 20 bytes)
    string(REGEX REPLACE ",$" "" bytes "${bytes}")
    set(slot 0)
    if(board EQUAL 0)
      set(slot 21)
    endif()
    string(APPEND table "{.sha1 = {${bytes}}, .bytes = 32768u, .ram_bytes = 0u, .board = ${board}u, .slot = ${slot}u, .machine = ${machine}u, .region = 0u, .video = 1u, .persistence = 0u, .geometry = 0u, .ctrl1 = 0u, .ctrl2 = 0u, .flags = 1u},\n")
  endforeach()
  file(WRITE "${dir}/table.inc" "{21u, 0u, \"graphic\", \"stand-in\"},\n${table}")
  execute_process(COMMAND sh "${wl_scripts}/compat-seed.sh" "${dir}/empty.csv" "${dir}/catalog.tsv" 2026-11-12
    OUTPUT_FILE "${dir}/ledger.csv" RESULT_VARIABLE rc ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "the seed of the stand-in ledger exits ${rc}: ${err}")
  endif()
endfunction()

# A copy of a file with one literal replacement; the copy must differ, so a control that edits nothing is a failure of the control.
function(edited from to old new)
  file(READ "${from}" text)
  string(REPLACE "${old}" "${new}" changed "${text}")
  if(changed STREQUAL text)
    message(FATAL_ERROR "the control edit of ${from} changed nothing: ${old}")
  endif()
  file(WRITE "${to}" "${changed}")
endfunction()

if(CASE STREQUAL "count")
  wl_count(error info "${ledger}" "${catalog}" "${counts}" "${OUT}/live")
  must_pass(count "${error}")
  message(STATUS "whole list: ${info}")
  standin("${OUT}/s")
  wl_count(error info "${OUT}/s/ledger.csv" "${OUT}/s/catalog.tsv" "${OUT}/s/counts.txt" "${OUT}/s")
  must_pass("the stand-in" "${error}")
  # One identity removed from the ledger: the denominator shrank.
  file(READ "${OUT}/s/ledger.csv" text)
  string(REGEX REPLACE "\n\"${id1}\"[^\n]*" "" shrunk "${text}")
  file(WRITE "${OUT}/s/shrunk.csv" "${shrunk}")
  wl_count(error info "${OUT}/s/shrunk.csv" "${OUT}/s/catalog.tsv" "${OUT}/s/counts.txt" "${OUT}/s")
  must_refuse("removed identity" "${error}" "ledger cart identities 4 differ from the pin counts 5")
  # The pin counts one low: the typed constant disagrees with the ledger.
  edited("${OUT}/s/counts.txt" "${OUT}/s/low.txt" "entries_sms 3" "entries_sms 2")
  wl_count(error info "${OUT}/s/ledger.csv" "${OUT}/s/catalog.tsv" "${OUT}/s/low.txt" "${OUT}/s")
  must_refuse("pin counts one low" "${error}" "differ from the pin counts 4")
  # A ledger id the catalog does not list.
  string(REGEX MATCH "\n\"${id1}\"[^\n]*" row "${text}")
  string(REPLACE "${id1}" "${id7}" stray "${row}")
  file(WRITE "${OUT}/s/stray.csv" "${text}${stray}\n")
  wl_count(error info "${OUT}/s/stray.csv" "${OUT}/s/catalog.tsv" "${OUT}/s/counts.txt" "${OUT}/s")
  must_refuse("stray identity" "${error}" "absent from the catalog")
  message(STATUS "compat.whole_list.count: 3 controls refused")
  return()
elseif(CASE STREQUAL "fresh")
  wl_fresh(error "${ledger}" "${catalog}" "${OUT}/live")
  must_pass(fresh "${error}")
  wl_compound(error info "${catalog}" "${OUT}/live")
  must_pass(fresh "${error}")
  message(STATUS "whole list: the seed reproduces the ledger; ${info}")
  return()
elseif(CASE STREQUAL "fresh_wrong")
  # Four faults, each over a stand-in whole ledger: a deleted catalog line, an unknown hand-flipped to unsupported, a flipped
  # derived field, and a board that arrived in the catalog while the ledger stayed. Each must make the seed differ or exit non-zero.
  standin("${OUT}/s")
  wl_fresh(error "${OUT}/s/ledger.csv" "${OUT}/s/catalog.tsv" "${OUT}/s")
  must_pass("the unfaulted stand-in" "${error}")
  file(READ "${OUT}/s/ledger.csv" text)
  string(REGEX MATCH "\n\"${id1}\"[^\n]*" row1 "${text}")
  string(REGEX MATCH "\n\"${id2}\"[^\n]*" row2 "${text}")
  string(REPLACE "\"unknown\",\"CC0 metadata only src/cartdb.inc\"" "\"unsupported\",\"reason=graphic\"" flipped1 "${row1}")
  string(REPLACE "\"gg\",\"export\",\"ntsc\"" "\"gg\",\"japan\",\"ntsc\"" flipped2 "${row2}")
  if(flipped1 STREQUAL row1 OR flipped2 STREQUAL row2)
    message(FATAL_ERROR "a fault edit changed nothing")
  endif()
  string(REPLACE "${row1}" "${flipped1}" status_flip "${text}")
  string(REPLACE "${row2}" "${flipped2}" region_flip "${text}")
  file(WRITE "${OUT}/s/status.csv" "${status_flip}")
  file(WRITE "${OUT}/s/region.csv" "${region_flip}")
  edited("${OUT}/s/catalog.tsv" "${OUT}/s/deleted.tsv" "${id2}\tgg\tnone\t-\tTwo\tunknown\t-\texport\tpad\tpad\n" "")
  edited("${OUT}/s/catalog.tsv" "${OUT}/s/board.tsv" "${id3}\tsms\tunsupported\tgraphic\tThree\tunsupported\tgraphic" "${id3}\tsms\tsega\t-\tThree\tunknown\t-")
  foreach(fault IN ITEMS "deleted|ledger.csv|deleted.tsv" "status|status.csv|catalog.tsv" "region|region.csv|catalog.tsv" "board|ledger.csv|board.tsv")
    string(REPLACE "|" ";" parts "${fault}")
    list(GET parts 0 name)
    list(GET parts 1 faulty_ledger)
    list(GET parts 2 faulty_catalog)
    wl_fresh(error "${OUT}/s/${faulty_ledger}" "${OUT}/s/${faulty_catalog}" "${OUT}/s/${name}")
    must_refuse("${name}" "${error}" "ledger is not whole")
  endforeach()
  message(FATAL_ERROR "ledger is not whole (4 faults refused)")
elseif(CASE STREQUAL "reason")
  wl_reason(error info "${ledger}" "${catalog}" "${counts}" "${OUT}/live")
  must_pass(reason "${error}")
  message(STATUS "whole list: ${info}")
  wl_table(error info "${ROOT}/src/cartdb.inc" "${catalog}" "${OUT}/live")
  must_pass(table "${error}")
  message(STATUS "whole list: ${info}")
  standin("${OUT}/s")
  wl_reason(error info "${OUT}/s/ledger.csv" "${OUT}/s/catalog.tsv" "${OUT}/s/counts.txt" "${OUT}/s")
  must_pass("the stand-in" "${error}")
  wl_table(error info "${OUT}/s/table.inc" "${OUT}/s/catalog.tsv" "${OUT}/s")
  must_pass("the stand-in table" "${error}")
  # The parser refuses a reason that is empty, free text or not in the vocabulary, in every mode.
  set(evidence_empty "")
  set(evidence_free "because")
  set(evidence_unlisted "reason=unlisted_token")
  foreach(name IN ITEMS empty free unlisted)
    edited("${OUT}/s/ledger.csv" "${OUT}/s/${name}.csv" "\"reason=graphic\"" "\"${evidence_${name}}\"")
    execute_process(COMMAND sh "${wl_scripts}/compat-common.sh" normalize "${OUT}/s/${name}.csv" RESULT_VARIABLE rc ERROR_VARIABLE err OUTPUT_QUIET)
    if(NOT rc EQUAL 2 OR NOT err MATCHES "invalid ledger record")
      message(FATAL_ERROR "the ${name} reason was not refused with exit 2: exit ${rc}: ${err}")
    endif()
  endforeach()
  # Unsupported on a supported board, a pass on a board-0 identity, a catalog board edited away from the table, a mame_no count off by one.
  edited("${OUT}/s/catalog.tsv" "${OUT}/s/unsupported.tsv" "${id1}\tsms\tsega\t-\tOne\tunknown\t-" "${id1}\tsms\tsega\t-\tOne\tunsupported\tgraphic")
  wl_reason(error info "${OUT}/s/ledger.csv" "${OUT}/s/unsupported.tsv" "${OUT}/s/counts.txt" "${OUT}/s")
  must_refuse("unsupported on a supported board" "${error}" "unsupported on the supported board")
  edited("${OUT}/s/ledger.csv" "${OUT}/s/judged.csv" "\"unsupported\",\"reason=graphic\"" "\"pass\",\"-\"")
  wl_reason(error info "${OUT}/s/judged.csv" "${OUT}/s/catalog.tsv" "${OUT}/s/counts.txt" "${OUT}/s")
  must_refuse("pass on a board-0 identity" "${error}" "a judged row for ${id3}")
  edited("${OUT}/s/catalog.tsv" "${OUT}/s/moved.tsv" "${id1}\tsms\tsega" "${id1}\tsms\tkorean")
  wl_table(error info "${OUT}/s/table.inc" "${OUT}/s/moved.tsv" "${OUT}/s")
  must_refuse("catalog board edited away from the table" "${error}" "catalog differs from src/cartdb.inc")
  # The rest of a catalog line against its fact: slot, region and a port; and the other direction, a public fact with no catalog line.
  edited("${OUT}/s/catalog.tsv" "${OUT}/s/slot.tsv" "${id3}\tsms\tunsupported\tgraphic" "${id3}\tsms\tunsupported\tjanggun")
  edited("${OUT}/s/catalog.tsv" "${OUT}/s/region.tsv" "${id1}\tsms\tsega\t-\tOne\tunknown\t-\texport" "${id1}\tsms\tsega\t-\tOne\tunknown\t-\tjapan")
  edited("${OUT}/s/catalog.tsv" "${OUT}/s/port.tsv" "${id2}\tgg\tnone\t-\tTwo\tunknown\t-\texport\tpad\tpad" "${id2}\tgg\tnone\t-\tTwo\tunknown\t-\texport\tpad\tsports")
  foreach(name IN ITEMS slot region port)
    wl_table(error info "${OUT}/s/table.inc" "${OUT}/s/${name}.tsv" "${OUT}/s")
    must_refuse("catalog ${name} edited away from the fact" "${error}" "catalog differs from src/cartdb.inc: identity [0-9]+ has slot")
  endforeach()
  file(READ "${OUT}/s/table.inc" table_text)
  string(REPEAT "0x88," 19 extra_bytes)
  file(WRITE "${OUT}/s/extra.inc" "${table_text}{.sha1 = {${extra_bytes}0x88}, .bytes = 32768u, .ram_bytes = 0u, .board = 1u, .slot = 0u, .machine = 1u, .region = 0u, .ctrl1 = 0u, .ctrl2 = 0u, .flags = 1u},\n")
  wl_table(error info "${OUT}/s/extra.inc" "${OUT}/s/catalog.tsv" "${OUT}/s")
  must_refuse("a public fact with no catalog line" "${error}" "public fact [0-9a-f]+ has no catalog line")
  edited("${OUT}/s/counts.txt" "${OUT}/s/mame.txt" "mame_no 1" "mame_no 2")
  wl_reason(error info "${OUT}/s/ledger.csv" "${OUT}/s/catalog.tsv" "${OUT}/s/mame.txt" "${OUT}/s")
  must_refuse("mame_no count" "${error}" "mame_no lines 1 differ from the pin counts 2")
  message(STATUS "compat.whole_list.reason: 11 controls refused")
  return()
elseif(CASE STREQUAL "runnable")
  # The distinct default profiles of the ledger's cartridge rows, read through the shared parser once. Each runs an owned fixture
  # for one frame: the core must accept every profile the seed wrote. A profile it refuses (a Game Gear with a paddle) exits 77.
  set(program [==[
match($0, /^set\(compat_[0-9]+_[a-z0-9_]+ \[\[/) {
  tag=substr($0,12,RLENGTH-14); n=index(tag,"_"); i=substr(tag,1,n-1)+0; v=substr($0,RLENGTH+1); c[i,substr(tag,n+1)]=substr(v,1,length(v)-3); if(i>max) max=i
}
END { for(i=1;i<=max;i++) { if(length(c[i,"id"])!=40) continue; t=c[i,"machine"] " " c[i,"runner_region"] " " c[i,"fm"] " " c[i,"video"] " " c[i,"port1"] " " c[i,"port2"]; if(!(t in seen)) { seen[t]=1; print t } } }
]==])
  file(CONFIGURE OUTPUT "${OUT}/tuples.awk" CONTENT "${program}" @ONLY NEWLINE_STYLE UNIX)
  execute_process(COMMAND sh "${wl_scripts}/compat-common.sh" cases "${ledger}" COMMAND awk -f "${OUT}/tuples.awk"
    OUTPUT_VARIABLE tuples COMMAND_ERROR_IS_FATAL ANY)
  string(REPLACE "\n" ";" tuples "${tuples}")
  list(FILTER tuples EXCLUDE REGEX "^$")
  list(LENGTH tuples distinct)
  if(distinct LESS 8)
    message(FATAL_ERROR "the ledger holds only ${distinct} distinct default profiles")
  endif()
  function(run_profile tuple want)
    string(REPLACE " " ";" p "${tuple}")
    list(GET p 0 machine)
    set(image boot_to_play.sms)
    if(machine STREQUAL "gg")
      set(image boot_to_play.gg)
    endif()
    execute_process(COMMAND ${EMULATOR} "${RUN}" --machine ${machine} --region "${p_region}" --fm "${p_fm}" --video-mode "${p_video}"
      --port1 "${p_port1}" --port2 "${p_port2}" --frames 1 "${FIXTURES}/${image}" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE err)
    if(NOT rc STREQUAL "${want}")
      message(FATAL_ERROR "the profile '${tuple}' exited ${rc}, expected ${want}: ${err}")
    endif()
  endfunction()
  foreach(tuple IN LISTS tuples)
    string(REPLACE " " ";" p "${tuple}")
    list(GET p 1 p_region)
    list(GET p 2 p_fm)
    list(GET p 3 p_video)
    list(GET p 4 p_port1)
    list(GET p 5 p_port2)
    run_profile("${tuple}" 0)
  endforeach()
  set(p_region ntsc-u)
  set(p_fm off)
  set(p_video gg)
  set(p_port1 paddle)
  set(p_port2 pad)
  run_profile("gg ntsc-u off gg paddle pad" 77)
  message(STATUS "compat.whole_list.runnable: ${distinct} profiles run, 1 control refused with 77")
  return()
endif()
message(FATAL_ERROR "unknown CASE ${CASE}")
